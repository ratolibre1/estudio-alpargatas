---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomeAllGames, localizeGame } from '../lib/games';
import { home } from '../i18n/home';
import { getLocale, localizePath } from '../i18n/locale';

const locale = getLocale(Astro);
const t = home[locale];
const homeGames = (await getHomeAllGames()).map((g) => localizeGame(g, locale));

const stateBadge: Record<string, { bg: string; color: string }> = {
  publicado:  { bg: '#7c3aed', color: '#fff' },
  produccion: { bg: '#2563eb', color: '#fff' },
  disponible: { bg: '#16a34a', color: '#fff' },
  pruebas:    { bg: '#eab308', color: '#1a1205' },
  boceto:     { bg: '#f97316', color: '#fff' },
  idea:       { bg: '#dc2626', color: '#fff' },
};
---

<BaseLayout
  title={t.title}
  description={t.description}
>
  <main>
    <section class="home-hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="overline">{t.overline}</p>
        <h1 id="hero-title">{t.h1}</h1>
        <p class="hero-lede">{t.lede}</p>
        <div class="hero-links">
          <a class="button red" href={localizePath('/portafolio/', locale)}>{t.ctaGames}</a>
          <a class="underlined-link" href={localizePath('/estudio/', locale)}>{t.ctaNotebook}</a>
        </div>
      </div>

      <a class="hero-ninive" href={localizePath('/juegos/ninive/', locale)} aria-label={t.photoNinive}>
        <img src="/assets/ninive-caja.webp" alt={t.photoNiniveAlt} />
        <span>{t.photoNinive}</span>
      </a>
    </section>

    <section class="games-section" id="juegos" aria-labelledby="games-title">
      <div class="shell">
        <header class="section-title-row">
          <div><span class="section-number">01</span><p class="overline">{t.catOverline}</p></div>
          <h2 id="games-title" set:html={t.catTitle} />
          <p>{t.catLede}</p>
        </header>
        <div class="home-games-grid">
          {homeGames.map((game) => {
            const badge = stateBadge[game.state] ?? { bg: '#888', color: '#fff' };
            return (
              <a href={game.href} class="home-game-card">
                {game.image
                  ? <img src={game.image} alt={game.imageAlt ?? game.name} loading="lazy" />
                  : game.coverTheme
                    ? <div class={`home-game-cover sample-game-${game.coverTheme}`}>
                        <span>{game.coverNumber}</span>
                        <strong>{game.coverTitle ?? game.name}</strong>
                        <small>{game.coverStatus}</small>
                      </div>
                    : <div class={`prototype-cover cover-${game.keyword}`}><b>{game.coverInitials}</b></div>
                }
                <div class="home-game-info">
                  <span class="home-game-badge" style={`background:${badge.bg};color:${badge.color}`}>{game.stateLabel}</span>
                  <h3>{game.name}</h3>
                  <p>{game.blurb}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="shell about-grid">
        <div class="about-word">ALPARGATAS</div>
        <div class="about-copy">
          <p class="overline">{t.aboutOverline}</p>
          <h2>{t.aboutTitle}</h2>
          <p>{t.aboutBody}</p>
          <div class="hero-links">
            <a class="button blue" href={localizePath('/estudio/', locale)}>{t.aboutPage}</a>
            <a class="underlined-link" href="https://www.instagram.com/estudioalpargatas/">{t.aboutCta}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
