---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../i18n/locale';
import { mapa as copy } from '../../i18n/mapa';

const locale = getLocale(Astro);
const t = copy[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  current="mapa"
  footerSubtitle={t.footer}
  footerVariant="mapa"
>
  <main class="shell">
    <header class="page-hero">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="page-title">{t.h1}</h1>
      <p class="lede">{t.lede}</p>
    </header>

    <section class="map-wrap" aria-label={t.mapAria}>
      <div class="map-intro">
        <article class="map-node primary">
          <span class="node-id">{t.n1Id}</span>
          <h2>{t.n1Title}</h2>
          <p>{t.n1Body}</p>
          <span class="route">/</span>
        </article>
        <article class="map-node">
          <span class="node-id">{t.n2Id}</span>
          <h2>{t.n2Title}</h2>
          <p>{t.n2Body}</p>
          <span class="route">/juegos</span>
        </article>
      </div>

      <div class="map-branch">
        <article class="map-node">
          <span class="node-id">{t.r1Id}</span>
          <h3>{t.r1Title}</h3>
          <p>{t.r1Body}</p>
          <span class="route">/juegos/ninive</span>
        </article>
        <article class="map-node">
          <span class="node-id">{t.r2Id}</span>
          <h3>{t.r2Title}</h3>
          <p>{t.r2Body}</p>
          <span class="route">/bitacora</span>
        </article>
        <a class="map-node" href={localizePath('/sobre-mi/', locale)}>
          <span class="node-id">{t.r3Id}</span>
          <h3>{t.r3Title}</h3>
          <p>{t.r3Body}</p>
          <span class="route">/sobre-mi</span>
        </a>
      </div>

      <p class="flow-note"><strong>{t.flow}</strong>{t.flowBody}</p>
    </section>
  </main>
</BaseLayout>
