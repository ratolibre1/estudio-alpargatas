---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../i18n/locale';
import { sobre as copy } from '../../i18n/sobre';

const locale = getLocale(Astro);
const t = copy[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  current="estudio"
>
  <style>
    .studio-page { overflow: hidden; }

    .studio-hero {
      padding-block: clamp(2.25rem, 5vw, 4.5rem);
    }
    .studio-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(16rem, .75fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
    }
    .studio-crumb {
      display: flex;
      gap: .6rem;
      margin-bottom: 1.15rem;
      color: var(--ink-soft);
      font-size: .75rem;
      font-weight: 850;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .studio-crumb a { text-decoration: none; }
    .studio-crumb a:hover { color: var(--red); }
    .studio-hero .page-title { max-width: 11ch; }
    .studio-story {
      display: grid;
      gap: .9rem;
      max-width: 47rem;
      margin-top: 1.5rem;
    }
    .studio-story p {
      margin: 0;
      color: var(--ink-soft);
      font-size: clamp(1rem, 1.5vw, 1.12rem);
    }
    .studio-mark {
      display: grid;
      place-items: center;
      min-height: 20rem;
      padding: clamp(2rem, 5vw, 4rem);
      border: 1.5px solid var(--ink);
      background: var(--white);
      box-shadow: 12px 12px 0 var(--blue);
      transform: rotate(2deg);
    }
    .studio-mark img { width: min(18rem, 100%); }

    .studio-profiles {
      display: grid;
      gap: clamp(3rem, 7vw, 6rem);
      padding-block: clamp(3rem, 7vw, 6rem);
    }
    .studio-profile {
      display: grid;
      grid-template-columns: minmax(15rem, .8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 4.5rem);
    }
    .studio-profile:nth-child(even) .studio-photo { order: 2; }
    .studio-photo {
      position: relative;
      margin: 0;
      max-width: 27rem;
      padding: .8rem .8rem 3.8rem;
      background: var(--white);
      box-shadow: 12px 12px 0 var(--blue);
      transform: rotate(-1.5deg);
    }
    .studio-profile:nth-child(even) .studio-photo {
      justify-self: end;
      box-shadow: 12px 12px 0 var(--red);
      transform: rotate(1.5deg);
    }
    .studio-photo img { width: 100%; display: block; }
    .studio-photo figcaption {
      position: absolute;
      left: 1rem;
      right: 1rem;
      bottom: .9rem;
      font-family: Georgia, serif;
      font-size: .84rem;
      font-style: italic;
      line-height: 1.35;
    }
    .studio-kicker {
      margin: 0 0 .7rem;
      color: var(--red);
      font-size: .72rem;
      font-weight: 950;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .studio-profile h2,
    .studio-cats h2 {
      margin: 0 0 1.15rem;
      font-family: Arial, Helvetica, sans-serif;
      font-size: clamp(2rem, 4.5vw, 3.5rem);
      font-weight: 950;
      letter-spacing: -.065em;
      line-height: .95;
    }
    .studio-copy {
      display: grid;
      gap: .85rem;
      max-width: 42rem;
    }
    .studio-copy p {
      margin: 0;
      color: var(--ink-soft);
      font-size: clamp(1rem, 1.5vw, 1.1rem);
    }

    .studio-cats-wrap { padding-bottom: clamp(3rem, 7vw, 6rem); }
    .studio-cats {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(16rem, .7fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 4rem);
      padding: clamp(2rem, 5vw, 4rem);
      border: 1.5px solid var(--ink);
      background: var(--white);
      box-shadow: 8px 8px 0 var(--ink);
    }
    .studio-cats-logo {
      display: grid;
      place-items: center;
    }
    .studio-cats-logo img { width: min(22rem, 100%); aspect-ratio: 1; object-fit: cover; border-radius: 50%; display: block; }
    .studio-formula {
      margin: 1.5rem 0 0;
      color: var(--blue);
      font-size: clamp(1.9rem, 5vw, 4.2rem);
      font-weight: 950;
      letter-spacing: -.06em;
      line-height: .9;
    }

    .studio-contact-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.4rem;
      margin-top: 1.5rem;
    }
    .studio-contact-links .underlined-link { color: #d6e7fa; }

    @media (max-width: 900px) {
      .studio-hero-grid,
      .studio-profile,
      .studio-cats { grid-template-columns: minmax(0, 1fr); }
      .studio-mark { min-height: 14rem; }
      .studio-profile:nth-child(even) .studio-photo { order: 0; justify-self: start; }
      .studio-photo { width: min(100%, 27rem); }
      .studio-cats-logo img { width: min(18rem, 100%); }
    }
    @media (max-width: 520px) {
      .studio-mark { padding: 1.5rem; box-shadow: 7px 7px 0 var(--blue); }
      .studio-photo { box-shadow: 7px 7px 0 var(--blue); }
      .studio-profile:nth-child(even) .studio-photo { box-shadow: 7px 7px 0 var(--red); }
      .studio-cats { padding: 1.4rem; box-shadow: 6px 6px 0 var(--ink); }
      .studio-cats-logo img { width: min(14rem, 100%); }
      .studio-formula { overflow-wrap: anywhere; }
    }
  </style>

  <main class="studio-page">
    <header class="page-hero studio-hero">
      <div class="shell studio-hero-grid">
        <div>
          <nav class="studio-crumb" aria-label={t.crumbAria}>
            <a href={localizePath('/', locale)}>{t.crumbHome}</a>
            <span>/</span>
            <span>{t.crumbHere}</span>
          </nav>
          <p class="eyebrow">{t.eyebrow}</p>
          <h1 class="page-title">{t.h1}</h1>
          <div class="studio-story">
            <p>{t.history1}</p>
            <p>{t.history2}</p>
            <p>{t.history3}</p>
            <p>{t.history4}</p>
          </div>
        </div>
        <div class="studio-mark">
          <img src="/assets/estudio-alpargatas-logo-hd.webp" alt={t.logoAlt} />
        </div>
      </div>
    </header>

    <section class="shell studio-profiles">
      <article class="studio-profile" aria-labelledby="studio-arturo-title">
        <figure class="studio-photo">
          <img src="/assets/arturo.webp" alt={t.arturoAlt} />
          <figcaption>{t.arturoCaption}</figcaption>
        </figure>
        <div>
          <p class="studio-kicker">{t.arturoLabel}</p>
          <h2 id="studio-arturo-title">{t.arturoTitle}</h2>
          <div class="studio-copy">
            <p>{t.arturoBody1}</p>
            <p>{t.arturoBody2}</p>
          </div>
        </div>
      </article>

      <article class="studio-profile" aria-labelledby="studio-estefi-title">
        <figure class="studio-photo">
          <img src="/assets/arturo-estefi.webp" alt={t.estefiAlt} />
          <figcaption>{t.estefiCaption}</figcaption>
        </figure>
        <div>
          <p class="studio-kicker">{t.estefiLabel}</p>
          <h2 id="studio-estefi-title">{t.estefiTitle}</h2>
          <div class="studio-copy">
            <p>{t.estefiBody1}</p>
            <p>{t.estefiBody2}</p>
            <p>{t.estefiBody3}</p>
          </div>
        </div>
      </article>
    </section>

    <section class="shell studio-cats-wrap" aria-labelledby="studio-cats-title">
      <div class="studio-cats">
        <div>
          <p class="studio-kicker">{t.catsLabel}</p>
          <h2 id="studio-cats-title">{t.catsTitle}</h2>
          <div class="studio-copy">
            <p>{t.catsBody}</p>
            <p>{t.catsParts}</p>
          </div>
          <p class="studio-formula">{t.catsFormula}</p>
        </div>
        <div class="studio-cats-logo">
          <img src="/assets/gatitas.webp" alt={t.catsLabel} />
        </div>
      </div>
    </section>

    <section class="about-section" aria-labelledby="studio-contact-title">
      <div class="shell about-grid">
        <div class="about-word">ESTUDIO</div>
        <div class="about-copy">
          <p class="overline">{t.contactOverline}</p>
          <h2 id="studio-contact-title">{t.contactTitle}</h2>
          <p>{t.contactBody}</p>
          <div class="studio-contact-links">
            <a class="button blue" href="https://www.instagram.com/estudioalpargatas/">{t.ctaIg}</a>
            <a class="underlined-link" href={localizePath('/portafolio/', locale)}>{t.ctaPortfolio}</a>
            <a class="underlined-link" href={localizePath('/juegos/ninive/', locale)}>{t.ctaNinive}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
