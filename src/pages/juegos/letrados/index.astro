---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameExtras from '../../../components/GameExtras.astro';
import { getGame } from '../../../lib/games';

const cms = await getGame('letrados');

const ejemplos = [
  { cover: 'N', top: 'T', score: '+3', note: 'verde' },
  { cover: 'A', top: 'N', score: '+10', note: 'azul' },
  { cover: 'B', top: 'Q', score: '−7', note: 'rojo' },
  { cover: 'D', top: 'A', score: '−2', note: 'rojo' },
];

---

<BaseLayout
  title="Letrados — Estudio Alpargatas"
  description="Letrados: duelo de dos jugadores. Cada uno construye una torre de 13 letras y puntúa con la tabla de la carta cubierta."
  bodyClass="page-letrados"
  footerSubtitle="Letrados · Lighthouse Games · 2 jugadores"
  themeColor="#8ec4e8"
  fontUrl="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,700;0,800;1,400&family=Patrick+Hand&display=swap"
>

<style is:global>
  body.page-letrados {
    background: #eaf4fb;
    color: #1f2626;
    font-family: Nunito, "Helvetica Neue", Arial, sans-serif;
    --papel:    #eaf4fb;
    --hoja:     #fffdf8;
    --tinta:    #1f2626;
    --pizarra:  #24332a;
    --cielo:    #8ec4e8;
    --chaleco:  #2d7eb0;
    --oro:      #d4a84b;
    --rojo:     #c0393a;
    --verde:    #2d6a4f;
    --azul:     #2d7eb0;
    --tiza:     #f7f3ea;
    --dim:      rgba(31, 38, 38, .55);
    --line:     rgba(45, 126, 176, .2);
    --display:  "Patrick Hand", "Segoe Print", cursive;
  }

  body.page-letrados .site-header   { background: var(--pizarra); border-bottom: 3px solid var(--oro); }
  body.page-letrados .brand b       { color: var(--tiza); }
  body.page-letrados .brand small   { color: rgba(247,243,234,.45); }
  body.page-letrados .nav-links a   { color: rgba(247,243,234,.62); }
  body.page-letrados .nav-links a:hover { color: var(--oro); }
  body.page-letrados .nav-links .nav-instagram { border-color: rgba(212,168,75,.45); color: var(--oro); }
  body.page-letrados .nav-links .nav-instagram:hover { background: var(--oro); border-color: var(--oro); color: var(--pizarra); }
  body.page-letrados .brand-logo    { border-color: rgba(247,243,234,.3); box-shadow: 2px 2px 0 rgba(212,168,75,.35); }

  body.page-letrados .site-footer   { background: var(--pizarra); border-top: 3px solid rgba(212,168,75,.45); color: rgba(247,243,234,.45); }
  body.page-letrados .site-footer b,
  body.page-letrados .site-footer a { color: rgba(247,243,234,.7); }
  body.page-letrados .site-footer a:hover { color: var(--oro); }
</style>

<style>
  .lt-shell { width: min(1050px, calc(100% - 3rem)); margin-inline: auto; }

  .lt-label {
    display: inline-flex; align-items: center; gap: .6rem;
    font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    color: var(--chaleco); margin-bottom: 1.2rem;
  }
  .lt-label::before { content: ""; display: block; width: 1.5rem; height: 1px; background: var(--oro); }

  .lt-breadcrumb {
    display: flex; gap: .4rem;
    font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--dim); margin-bottom: 2rem;
  }
  .lt-breadcrumb a { text-decoration: none; color: inherit; }
  .lt-breadcrumb a:hover { color: var(--tinta); }

  .lt-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem,6vw,5rem); align-items: start; }

  .lt-hero {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    border-bottom: 1px solid var(--line);
    background: var(--papel);
  }
  .lt-hero-title {
    font-size: clamp(5rem, 15vw, 11rem);
    font-weight: 400;
    letter-spacing: .01em;
    line-height: .85;
    color: var(--pizarra);
    font-family: var(--display);
    display: block;
    margin: .5rem 0 1.2rem;
  }
  .lt-hero-title em { color: var(--chaleco); font-style: normal; }
  .lt-hero-sub { font-size: .95rem; line-height: 1.8; color: var(--dim); max-width: 28rem; margin: 0 0 1.5rem; }
  .lt-badges { display: flex; gap: .5rem; flex-wrap: wrap; }
  .lt-badge {
    display: inline-flex; padding: .3rem .7rem;
    border: 1.5px solid rgba(26,26,26,.25);
    font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--dim);
  }
  .lt-badge.active { background: var(--pizarra); border-color: var(--pizarra); color: var(--tiza); }
  .lt-badge.red    { border-color: rgba(192,57,58,.4); color: var(--rojo); }

  .lt-hero-photo { margin: 0; }
  .lt-hero-photo img {
    width: 100%;
    display: block;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--cielo);
  }
  .lt-hero-photo figcaption {
    margin-top: .6rem;
    font-size: .72rem;
    color: var(--dim);
  }

  .lt-section {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .lt-section.alt { background: var(--hoja); border-top: 1px solid var(--line); }
  .lt-section h2 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 400; letter-spacing: .01em; line-height: .95;
    color: var(--pizarra); margin: .8rem 0 1.2rem;
  }
  .lt-section h2 em { color: var(--chaleco); font-style: normal; }
  .lt-section p { font-size: .9rem; line-height: 1.85; color: var(--dim); margin: 0 0 .9rem; }

  .lt-bands {
    display: grid;
    gap: .7rem;
  }
  .lt-band {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--hoja);
    border-radius: 10px;
    border-left: 6px solid var(--band);
  }
  .lt-band span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--band);
    margin-bottom: .35rem;
  }
  .lt-band b { display: block; margin-bottom: .25rem; }
  .lt-band p { margin: 0; font-size: .85rem; }

  .lt-card-row {
    display: grid;
    grid-template-columns: 1.6fr minmax(12rem, .7fr);
    gap: 1.2rem;
    margin-top: 2.4rem;
    align-items: start;
  }
  .lt-card-row figure { margin: 0; }
  .lt-card-row img {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    display: block;
  }
  .lt-card-row figcaption {
    margin-top: .55rem;
    font-size: .72rem;
    color: var(--dim);
  }

  .lt-rules { list-style: none; padding: 0; margin: 0; }
  .lt-rule {
    display: grid; grid-template-columns: 2.5rem 1fr; gap: .8rem; align-items: start;
    padding: .9rem 0; border-bottom: 1px solid var(--line);
  }
  .lt-rule:first-child { border-top: 1px solid var(--line); }
  .lt-rule-num {
    font-family: var(--display); font-size: 1.8rem; font-weight: 400;
    color: var(--chaleco); line-height: 1.1; text-align: center;
  }
  .lt-rule-title { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--tinta); margin-bottom: .2rem; }
  .lt-rule-desc { font-size: .82rem; line-height: 1.65; color: var(--dim); margin: 0; }

  .lt-roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .8rem;
    margin-top: 1.4rem;
  }
  .lt-role {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--hoja);
    border-radius: 10px;
  }
  .lt-role span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--chaleco);
    margin-bottom: .4rem;
  }
  .lt-role b { display: block; font-family: var(--display); font-size: 1.45rem; font-weight: 400; margin-bottom: .35rem; }
  .lt-role p { margin: 0; font-size: .82rem; }

  .lt-pairs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .lt-pair {
    display: grid; grid-template-columns: auto 1fr auto; gap: .6rem; align-items: center;
    padding: .7rem .9rem;
    border: 1px solid var(--line); background: var(--hoja);
    border-radius: 10px;
  }
  .lt-pair-letter {
    width: 2.2rem; height: 2.2rem;
    display: flex; align-items: center; justify-content: center;
    background: var(--pizarra); color: var(--tiza);
    font-family: var(--display); font-size: 1.35rem; font-weight: 400;
  }
  .lt-pair-arrow { font-size: .68rem; color: var(--dim); }
  .lt-pair-score { text-align: right; }
  .lt-pair-score strong { font-size: 1.5rem; font-weight: 900; display: block; line-height: 1; }
  .lt-pair-score strong.pos { color: var(--verde); }
  .lt-pair-score strong.big { color: var(--oro); }
  .lt-pair-score strong.neg { color: var(--rojo); }
  .lt-pair-score span { font-size: .55rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }

  .lt-example {
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--line);
    background: var(--hoja);
    border-radius: 10px;
  }
  .lt-example span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--chaleco);
    margin-bottom: .5rem;
  }
  .lt-example p { margin: 0 0 .7rem; font-size: .88rem; }
  .lt-example p:last-child { margin: 0; }

  .lt-links {
    display: flex; flex-wrap: wrap; gap: .6rem .9rem;
    margin: 0 0 1.6rem;
  }
  .lt-links a {
    display: inline-flex; padding: .35rem .75rem;
    border: 1.5px solid rgba(26,26,26,.25);
    font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; color: var(--tinta);
  }
  .lt-links a:hover { background: var(--pizarra); color: var(--tiza); border-color: var(--pizarra); }

  .lt-lh-head {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr;
    gap: 1.6rem 2rem;
    align-items: center;
    margin-bottom: 1.4rem;
  }
  .lt-lh-logo { display: block; text-decoration: none; }
  .lt-lh-logo img { width: 100%; height: auto; display: block; }
  .lt-lh-head .lt-label { margin-bottom: .7rem; }
  .lt-lh-head h2 { margin: 0; }

  .lt-lh-banner { margin: 0 0 1.2rem; }
  .lt-lh-banner img { width: 100%; display: block; border: 1px solid var(--line); border-radius: 14px; background: var(--cielo); }

  .lt-proto { margin: 0; }
  .lt-proto img {
    width: 100%;
    max-height: 22rem;
    object-fit: contain;
    object-position: top center;
    display: block;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--cielo);
  }
  .lt-proto figcaption {
    margin-top: .55rem;
    font-size: .72rem;
    color: var(--dim);
  }

  .lt-back {
    padding: 2.5rem 0;
    display: flex; justify-content: space-between; align-items: center; gap: 2rem;
  }
  .lt-back span { font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }
  .lt-back a { font-family: var(--display); font-size: clamp(1.4rem, 3vw, 2.3rem); font-weight: 400; letter-spacing: .01em; text-decoration: none; color: var(--pizarra); }
  .lt-back a:hover { color: var(--chaleco); }

  @media (max-width: 700px) {
    .lt-cols,
    .lt-pairs,
    .lt-roles,
    .lt-card-row,
    .lt-lh-head { grid-template-columns: 1fr; }
  }
</style>

<main>
  <section class="lt-hero">
    <div class="lt-shell lt-cols">
      <div>
        <nav class="lt-breadcrumb"><a href="/">Inicio</a><span>/</span><span>Letrados</span></nav>
        <h1 class="lt-hero-title">Le<em>tra</em>dos</h1>
        <p class="lt-hero-sub">Un duelo. Cada uno construye su torre de letras. Elegir qué carta poner —y cuál dejarle al otro— marca la diferencia.</p>
        <div class="lt-badges">
          <span class="lt-badge active">Avanzado</span>
          <span class="lt-badge red">2 jugadores</span>
          <span class="lt-badge">15 min</span>
          <span class="lt-badge">26 cartas</span>
          <span class="lt-badge">13 por torre</span>
        </div>
        {cms && <GameExtras bggId={cms.bggId} awards={cms.awards} />}
      </div>
      <figure class="lt-hero-photo">
        <img src="/assets/letrados-portada.webp" alt="Portada ilustrada de Letrados, Lighthouse Games" />
        <figcaption>Portada de la edición. Arte de Lighthouse Games.</figcaption>
      </figure>
    </div>
  </section>

  <section class="lt-section alt">
    <div class="lt-shell lt-cols">
      <div>
        <span class="lt-label">01 — La idea</span>
        <h2>Dos torres.<br /><em>Una tabla</em><br />por carta.</h2>
        <p>Hay 26 cartas: una por letra. En el centro va la Letra Principal. Alrededor, el resto del abecedario está acomodado para decirte cuánto vale montar otra letra encima.</p>
        <p>Cuando cubres una carta, lees el puntaje en la de abajo. No se cuenta “cuántas letras hay de A a Z”. Se lee la tabla.</p>
        <p>Se baraja el mazo y cada uno parte con dos cartas. Al final, cada torre tiene trece.</p>
      </div>
      <div class="lt-bands">
        <article class="lt-band" style="--band: var(--verde)">
          <span>Derecha · verde</span>
          <b>+1 a +7</b>
          <p>Valores positivos. T sobre N, por el manual, da +3.</p>
        </article>
        <article class="lt-band" style="--band: var(--azul)">
          <span>Abajo · azul</span>
          <b>+10</b>
          <p>La letra más lejana a la principal. N sobre A da +10.</p>
        </article>
        <article class="lt-band" style="--band: var(--rojo)">
          <span>Izquierda · rojo</span>
          <b>−1 a −7</b>
          <p>Valores negativos. Q sobre B da −7.</p>
        </article>
      </div>
    </div>
    <div class="lt-shell">
      <div class="lt-card-row">
        <figure>
          <img src="/assets/letrados-carta-editorial.webp" alt="Carta A ilustrada de Letrados, edición Lighthouse" />
          <figcaption>Carta A de la edición. Positivos a la izquierda, negativos a la derecha, +10 en la pizarra.</figcaption>
        </figure>
        <figure>
          <img src="/assets/letrados-carta-a.webp" alt="Carta A del prototipo de Letrados" />
          <figcaption>La misma A en el proto, para leer la tabla.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="lt-section">
    <div class="lt-shell lt-cols">
      <div>
        <span class="lt-label">02 — El turno</span>
        <h2>Selección,<br />construcción,<br /><em>reparto.</em></h2>
        <p>Al comparar dos cartas, la Letra Principal más cerca de la A es la menor. La más cerca de la Z es la mayor.</p>
        <div class="lt-roles">
          <article class="lt-role">
            <span>Letra menor</span>
            <b>Capataz</b>
            <p>Elige cuál de las dos cartas reveladas entra a su torre.</p>
          </article>
          <article class="lt-role">
            <span>Letra mayor</span>
            <b>Obrero</b>
            <p>Se queda con la carta que el Capataz no quiso. Después reparte.</p>
          </article>
        </div>
      </div>
      <ul class="lt-rules">
        <li class="lt-rule">
          <div class="lt-rule-num">1</div>
          <div>
            <div class="lt-rule-title">Selección</div>
            <p class="lt-rule-desc">Cada uno elige una carta de su mano y la pone boca abajo. Se revelan juntas. Quien mostró la letra más al inicio del abecedario es Capataz; el otro, Obrero.</p>
          </div>
        </li>
        <li class="lt-rule">
          <div class="lt-rule-num">2</div>
          <div>
            <div class="lt-rule-title">Construcción</div>
            <p class="lt-rule-desc">El Capataz elige una de las dos cartas reveladas para su torre. La que no eligió se monta en la torre del Obrero.</p>
          </div>
        </li>
        <li class="lt-rule">
          <div class="lt-rule-num">3</div>
          <div>
            <div class="lt-rule-title">Reparto</div>
            <p class="lt-rule-desc">El Obrero toma las dos primeras del mazo, las muestra, y se queda con la Carta Menor. El Capataz recibe la Mayor. Después, otro turno.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="lt-section alt">
    <div class="lt-shell lt-cols">
      <div>
        <span class="lt-label">03 — El cierre</span>
        <h2>Trece cartas<br />y se suma.</h2>
        <p>La partida termina cuando se juega el último par. Cada torre tiene 13 cartas. Cada uno suma el puntaje de cada par: la carta de arriba se busca en la tabla de la de abajo.</p>
        <p>Gana el total más alto. Empate: otra vez.</p>
        <div class="lt-example">
          <span>Ejemplo del manual</span>
          <p>Jugador 1: A sobre D (−2), N sobre A (+10), T sobre N (+3). Total 11.</p>
          <p>Jugador 2: V sobre S (+2), F sobre V (+5), W sobre F (−5). Total 2.</p>
        </div>
      </div>
      <div class="lt-pairs" aria-label="Pares de ejemplo del manual">
        {ejemplos.map((e) => (
          <div class="lt-pair">
            <div class="lt-pair-letter">{e.top}</div>
            <div class="lt-pair-arrow">sobre {e.cover}</div>
            <div class="lt-pair-score">
              <strong class={e.score.startsWith('+10') ? 'big' : e.score.startsWith('−') ? 'neg' : 'pos'}>{e.score}</strong>
              <span>{e.note}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lt-section">
    <div class="lt-shell">
      <div class="lt-lh-head">
        <a class="lt-lh-logo" href="https://www.lighthousegms.com/es" target="_blank" rel="noopener noreferrer">
          <img src="/assets/lighthouse-games-logo.webp" alt="Lighthouse Games" />
        </a>
        <div>
          <span class="lt-label">04 — La editorial</span>
          <h2>Lighthouse<br /><em>Games.</em></h2>
        </div>
      </div>
      <p>La editorial mexicana lo está produciendo. Salió de Me Uno al Faro 2025; todavía no está en mesa.</p>
      <div class="lt-links">
        <a href="https://www.lighthousegms.com/es" target="_blank" rel="noopener noreferrer">Lighthouse Games ↗</a>
        <a href="https://www.lighthousegms.com/meunoalfaro" target="_blank" rel="noopener noreferrer">Me Uno al Faro ↗</a>
      </div>
      <figure class="lt-lh-banner">
        <img src="/assets/letrados-lighthouse-banner.webp" alt="Banner de Letrados, Lighthouse Games 2025" />
      </figure>
      <figure class="lt-proto">
        <img src="/assets/letrados-proto.webp" alt="Dos torres de Letrados sobre la mesa, una carta por letra" />
        <figcaption>El proto en mesa. Dos torres, veintiséis cartas.</figcaption>
      </figure>
    </div>
  </section>

  <nav class="lt-back lt-shell">
    <span>¿Seguimos mirando?</span>
    <a href="/portafolio/">Ver el portafolio completo →</a>
  </nav>
</main>

</BaseLayout>
