---
/**
 * PLANTILLA DE JUEGO — Estudio Alpargatas
 * ────────────────────────────────────────
 * Copia este archivo a /src/pages/juegos/<slug>/index.astro
 * y reemplaza cada marcador [ ... ] con contenido real.
 *
 * Props de BaseLayout que debes completar:
 *   title         → "Nombre del Juego — Estudio Alpargatas"
 *   description   → Párrafo SEO (~155 caracteres)
 *   bodyClass     → "page-<slug>" (define el tema de colores)
 *   footerSubtitle → "Nombre · Estado · Versión"
 *   themeColor    → Color hex del tema (meta tag móvil)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="[Nombre del juego] — Estudio Alpargatas"
  description="[Descripción SEO del juego, ~155 caracteres.]"
  bodyClass="page-plantilla"
  footerSubtitle="[Nombre] · [Género] · [Estado]"
  themeColor="#f9f9f7"
>

<style>
  /* ─── Reset mínimo de header/footer para página neutra ─── */
  :global(body.page-plantilla .site-header) { background: #1a1a1a; border-bottom: 1px solid #333; }
  :global(body.page-plantilla .brand b)     { color: #f9f9f7; }
  :global(body.page-plantilla .brand small) { color: rgba(249,249,247,.4); }
  :global(body.page-plantilla .nav-links a) { color: rgba(249,249,247,.5); }
  :global(body.page-plantilla .nav-links a:hover) { color: #f9f9f7; }
  :global(body.page-plantilla .brand-logo)  { border-color: rgba(249,249,247,.3); box-shadow: 2px 2px 0 rgba(249,249,247,.1); }
  :global(body.page-plantilla .nav-links .nav-instagram) { border-color: rgba(249,249,247,.25); color: rgba(249,249,247,.6); }
  :global(body.page-plantilla .nav-links .nav-instagram:hover) { background: #f9f9f7; color: #1a1a1a; border-color: #f9f9f7; }
  :global(body.page-plantilla .site-footer) { background: #1a1a1a; color: rgba(249,249,247,.4); border-top: 1px solid #333; }
  :global(body.page-plantilla .site-footer b),
  :global(body.page-plantilla .site-footer a) { color: rgba(249,249,247,.65); }

  /* ─── Variables ─────────────────────────────────────────── */
  :root {
    --pt-bg:      #f9f9f7;
    --pt-ink:     #1a1a1a;
    --pt-dim:     rgba(26, 26, 26, .45);
    --pt-border:  rgba(26, 26, 26, .14);
    --pt-dash:    rgba(26, 26, 26, .22);
    --pt-fill:    rgba(26, 26, 26, .035);
    --pt-accent:  #1a1a1a;
  }

  /* ─── Base ───────────────────────────────────────────────── */
  body.page-plantilla {
    background: var(--pt-bg);
    color: var(--pt-ink);
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.6;
  }

  .pt-shell {
    width: min(960px, calc(100% - 3rem));
    margin-inline: auto;
  }

  /* ─── Etiquetas de sección ───────────────────────────────── */
  .pt-sec-label {
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--pt-dim);
    display: flex;
    align-items: center;
    gap: .6rem;
    margin-bottom: 1.2rem;
  }
  .pt-sec-label::before {
    content: "";
    display: block;
    width: 1.5rem;
    height: 1px;
    background: var(--pt-dash);
  }

  /* ─── Caja placeholder ───────────────────────────────────── */
  .pt-slot {
    border: 1.5px dashed var(--pt-dash);
    background: var(--pt-fill);
    padding: .9rem 1rem;
    font-size: .78rem;
    color: var(--pt-dim);
    font-family: "Courier New", monospace;
    line-height: 1.55;
  }
  .pt-slot + .pt-slot { margin-top: 6px; }
  .pt-slot strong { color: var(--pt-ink); font-family: "Helvetica Neue", Arial, sans-serif; font-size: .65rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; display: block; margin-bottom: .3rem; }

  /* ─── Separador de sección ───────────────────────────────── */
  .pt-section {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    border-bottom: 1px solid var(--pt-border);
  }
  .pt-section:last-of-type { border-bottom: none; }

  /* ─── Grid 2 columnas ────────────────────────────────────── */
  .pt-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* ─── Bloques de campos ──────────────────────────────────── */
  .pt-field {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: .5rem 1rem;
    align-items: baseline;
    padding: .55rem 0;
    border-bottom: 1px solid var(--pt-border);
    font-size: .83rem;
  }
  .pt-field:first-child { border-top: 1px solid var(--pt-border); }
  .pt-field-key {
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--pt-dim);
  }
  .pt-field-val {
    font-family: "Courier New", monospace;
    color: var(--pt-dim);
    font-size: .78rem;
  }

  /* ─── Badge de estado ────────────────────────────────────── */
  .pt-state-badge {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .35rem .75rem;
    border: 1.5px dashed var(--pt-dash);
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--pt-dim);
  }
  .pt-state-badge::before { content: "○"; font-size: .7rem; }

  /* ─── Título placeholder grande ──────────────────────────── */
  .pt-hero-title {
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 900;
    letter-spacing: -.05em;
    line-height: .88;
    color: rgba(26, 26, 26, .12);
    margin: .75rem 0;
    border: 1.5px dashed var(--pt-dash);
    padding: .4rem .6rem;
    font-family: inherit;
  }

  /* ─── Lista de ítems a completar ─────────────────────────── */
  .pt-todo-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .pt-todo-list li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: .6rem;
    padding: .55rem 0;
    border-bottom: 1px solid var(--pt-border);
    font-size: .82rem;
    color: var(--pt-dim);
    align-items: start;
  }
  .pt-todo-list li:first-child { border-top: 1px solid var(--pt-border); }
  .pt-todo-list li::before { content: "□"; color: var(--pt-dash); }

  /* ─── Cabecera de página ─────────────────────────────────── */
  .pt-page-header {
    padding: clamp(2rem, 5vw, 3.5rem) 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    border-bottom: 2px solid var(--pt-ink);
    margin-bottom: 0;
  }
  .pt-page-title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -.02em;
    margin: 0;
  }
  .pt-page-meta {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--pt-dim);
    text-align: right;
    line-height: 1.8;
  }

  /* ─── Responsive ─────────────────────────────────────────── */
  @media (max-width: 640px) { .pt-cols { grid-template-columns: 1fr; } }
</style>

<main>
  <div class="pt-shell">

    <!-- ─── Cabecera de la plantilla ──────────────────────── -->
    <header class="pt-page-header">
      <div>
        <nav style="font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--pt-dim);margin-bottom:.5rem;display:flex;gap:.4rem;">
          <a href="/" style="color:inherit;text-decoration:none;">Inicio</a>
          <span>/</span>
          <span>[slug]</span>
        </nav>
        <h1 class="pt-page-title">Plantilla de juego</h1>
      </div>
      <div class="pt-page-meta">
        Copiar a /src/pages/juegos/<strong>[slug]</strong>/index.astro<br />
        Completar todos los campos marcados con [ ]
      </div>
    </header>


    <!-- ══════════════════════════════════════════════════════
         BLOQUE 0 — PROPS DEL LAYOUT (BaseLayout.astro)
         ══════════════════════════════════════════════════════ -->
    <section class="pt-section">
      <div class="pt-sec-label">0 — Props del layout</div>
      <p style="font-size:.82rem;color:var(--pt-dim);margin:0 0 1.2rem;">Estos valores van en el frontmatter de Astro, al llamar a <code style="font-size:.78rem;background:rgba(0,0,0,.06);padding:.1rem .35rem;">BaseLayout</code>.</p>

      <div>
        <div class="pt-field"><span class="pt-field-key">title</span>         <span class="pt-field-val">"[Nombre del juego] — Estudio Alpargatas"</span></div>
        <div class="pt-field"><span class="pt-field-key">description</span>   <span class="pt-field-val">"[Descripción SEO, ~155 caracteres.]"</span></div>
        <div class="pt-field"><span class="pt-field-key">bodyClass</span>     <span class="pt-field-val">"page-[slug]"  ← define el tema de colores via CSS</span></div>
        <div class="pt-field"><span class="pt-field-key">footerSubtitle</span><span class="pt-field-val">"[Nombre] · [Género] · [Estado]"</span></div>
        <div class="pt-field"><span class="pt-field-key">themeColor</span>    <span class="pt-field-val">"#xxxxxx"  ← color de fondo del tema (meta móvil)</span></div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         BLOQUE 1 — HÉROE
         Qué es el juego, de un vistazo.
         ══════════════════════════════════════════════════════ -->
    <section class="pt-section">
      <div class="pt-sec-label">1 — Héroe</div>

      <div class="pt-cols">
        <div>
          <div class="pt-slot">
            <strong>Breadcrumb</strong>
            Inicio / [Nombre del juego]
          </div>

          <div class="pt-hero-title" aria-hidden="true">[Título]</div>

          <div class="pt-slot" style="margin-top:6px">
            <strong>Tagline</strong>
            Una frase corta que capture la sensación del juego.<br />
            Ej: "Dos jugadores. Un palacio. Un ganador."
          </div>

          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
            <span class="pt-state-badge">[ Estado ]</span>
            <span class="pt-state-badge">[ Jugadores ]</span>
            <span class="pt-state-badge">[ Duración ]</span>
          </div>
        </div>

        <div>
          <div class="pt-slot" style="min-height:140px;display:flex;align-items:center;justify-content:center;text-align:center;">
            <strong style="display:block;margin-bottom:.5rem;text-align:center">Elemento visual del héroe</strong>
            Imagen representativa, cover simulado,<br />
            ilustración clave o componente generativo.<br /><br />
            Tamaño sugerido: 480 × 320 px
          </div>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         BLOQUE 2 — CONCEPTO
         Qué pasa en la mesa.
         ══════════════════════════════════════════════════════ -->
    <section class="pt-section">
      <div class="pt-sec-label">2 — Concepto (01)</div>

      <div class="pt-cols">
        <div>
          <div class="pt-slot" style="min-height:100px">
            <strong>Párrafo de concepto</strong>
            3–4 oraciones que expliquen qué pasa en la mesa.<br />
            No las reglas: la experiencia. El tono emocional.<br />
            ¿Qué hace este juego diferente?
          </div>

          <div class="pt-slot" style="margin-top:6px">
            <strong>Párrafo complementario (opcional)</strong>
            Contexto adicional: origen de la idea, referentes,<br />
            por qué existe este juego.
          </div>
        </div>

        <div>
          <div class="pt-slot" style="min-height:160px;display:flex;align-items:center;justify-content:center;text-align:center;">
            <div>
              <strong style="display:block;margin-bottom:.4rem;text-align:center">Elemento de apoyo visual</strong>
              Cards de ejemplo · Dados · Tablero parcial<br />
              Diagrama de turno · Ilustración de mecánica<br /><br />
              Puede ser un widget CSS, imagen o SVG inline.
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         BLOQUE 3 — MECÁNICA CLAVE
         El corazón del juego.
         ══════════════════════════════════════════════════════ -->
    <section class="pt-section">
      <div class="pt-sec-label">3 — Mecánica clave (02)</div>

      <div class="pt-cols">
        <div>
          <div class="pt-slot">
            <strong>Título de la sección</strong>
            Encabezado que nombre la mecánica central.<br />
            Ej: "Una mano. Tres decisiones." (Chispas)<br />
            Ej: "Construir juntos. Sin repetir." (Piramisú)
          </div>

          <div class="pt-slot" style="margin-top:6px">
            <strong>Descripción de la mecánica</strong>
            1–2 párrafos sobre cómo funciona el turno,<br />
            qué decide el jugador y qué consecuencias tiene.
          </div>
        </div>

        <div>
          <div class="pt-slot" style="min-height:160px;">
            <strong>Lista / tabla / diagrama de reglas</strong>
            Opciones posibles:<br /><br />
            · Lista de 3–5 reglas numeradas<br />
            · Tabla de modos de juego<br />
            · Cards de acción / rol<br />
            · Medidor de riesgo / puntuación<br />
            · Rejilla de componentes
          </div>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         BLOQUE 4 — ESTADO ACTUAL
         Dónde está el juego hoy.
         ══════════════════════════════════════════════════════ -->
    <section class="pt-section">
      <div class="pt-sec-label">4 — Estado actual (03)</div>

      <div class="pt-cols">
        <div>
          <div class="pt-slot">
            <strong>Versión / número grande</strong>
            Ej: "V0.3", "Proto", "Build 2"<br />
            Se muestra en tipografía grande como cifra de estado.
          </div>

          <div class="pt-slot" style="margin-top:6px;min-height:80px">
            <strong>Lista de cambios recientes (3–5 ítems)</strong>
            · Qué se probó en la última sesión<br />
            · Qué se descartó y por qué<br />
            · Qué está pendiente de probar
          </div>
        </div>

        <div>
          <div class="pt-slot" style="min-height:60px">
            <strong>Encabezado de historia</strong>
            Título breve: cómo nació el juego o su nombre.<br />
            Ej: "Empezó como un acertijo de Sudoku."
          </div>
          <div class="pt-slot" style="margin-top:6px;min-height:80px">
            <strong>Párrafo de origen</strong>
            1–2 párrafos sobre la historia del prototipo:<br />
            de dónde vino, qué lo motivó, qué falló primero.
          </div>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         BLOQUE 5 — NAVEGACIÓN DE VUELTA
         ══════════════════════════════════════════════════════ -->
    <section class="pt-section">
      <div class="pt-sec-label">5 — Nav de vuelta</div>
      <div class="pt-cols">
        <div class="pt-slot">
          <strong>Texto de apoyo (opcional)</strong>
          Ej: "¿Seguimos mirando?" · "Más proyectos →"
        </div>
        <div class="pt-slot">
          <strong>Enlace principal</strong>
          href="/#juegos" → "Volver a todos los juegos →"<br />
          O href="/portafolio/" → "Ver el portafolio completo →"
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         CHECKLIST DE PÁGINA COMPLETA
         ══════════════════════════════════════════════════════ -->
    <section class="pt-section">
      <div class="pt-sec-label">Checklist antes de publicar</div>

      <div class="pt-cols">
        <div>
          <ul class="pt-todo-list">
            <li>Props de BaseLayout completos (title, description, bodyClass, themeColor)</li>
            <li>CSS de header y footer ajustado a la paleta del juego</li>
            <li>Breadcrumb con slug real</li>
            <li>Título y tagline definitivos en el héroe</li>
            <li>Badges con estado, jugadores y duración reales</li>
            <li>Elemento visual del héroe (imagen o widget CSS)</li>
          </ul>
        </div>
        <div>
          <ul class="pt-todo-list">
            <li>Párrafo de concepto (experiencia, no reglas)</li>
            <li>Elemento visual de apoyo al concepto</li>
            <li>Sección de mecánica con lista o tabla de reglas</li>
            <li>Versión actual + log de cambios recientes (3 ítems)</li>
            <li>Párrafo de origen del juego</li>
            <li>Href en games.ts actualizado con la ruta real</li>
          </ul>
        </div>
      </div>
    </section>

  </div>
</main>

</BaseLayout>
