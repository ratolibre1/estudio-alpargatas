---
/**
 * Demo de la plantilla compartida. No es una ficha pública.
 * Nínive = skin publicado. Reloj = skin proto.
 * Producción: /juegos/<keyword>/ vía [slug] + GameFicha. Legacy: /juegos/old/<keyword>/.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameFicha from '../../../components/GameFicha.astro';
import { getGame, localizeGame } from '../../../lib/games';
import { demoNinive, demoReloj } from '../../../lib/ficha-demos';
import { getLocale } from '../../../i18n/locale';
import { ficha as copy } from '../../../i18n/fichas/ficha';
import { CAJA_FONTS_URL } from '../../../lib/caja-fonts';
import { fichaThemeVars } from '../../../lib/ficha-theme';
import '../../../styles/ficha.css';

const locale = getLocale(Astro);
const t = copy[locale];
const niniveCms = await getGame('ninive');
const relojCms = await getGame('reloj');
if (!niniveCms || !relojCms) {
  throw new Error('Faltan ninive.md o reloj.md para la demo de plantilla.');
}
const ninive = demoNinive(localizeGame(niniveCms, locale), locale);
const reloj = demoReloj(localizeGame(relojCms, locale), locale);
const niniveTheme = fichaThemeVars(ninive);
const relojThemeJson = JSON.stringify(fichaThemeVars(reloj));
const niniveThemeJson = JSON.stringify(niniveTheme);
---

<BaseLayout
  title={locale === 'en' ? 'Game sheet template — Estudio Alpargatas' : 'Plantilla de ficha — Estudio Alpargatas'}
  description={t.demoLead}
  bodyClass="page-plantilla ficha-page"
  theme={niniveTheme}
  themeColor={ninive.bg}
  fontUrl={CAJA_FONTS_URL}
>


<div class="ficha-demo-bar">
  <div class="ficha-shell ficha-demo-row">
    <div class="ficha-demo-copy">
      <strong>{t.demoKicker}</strong>
      <p>{t.demoLead}</p>
    </div>
    <div class="ficha-demo-switch" data-demo-switch>
      <button type="button" data-demo="ninive" aria-pressed="true">{t.demoPub}</button>
      <button type="button" data-demo="reloj" aria-pressed="false">{t.demoProto}</button>
    </div>
  </div>
</div>

<div data-demo-panel="ninive" data-ficha-theme={niniveThemeJson}>
  <GameFicha ficha={ninive} locale={locale} />
</div>
<div data-demo-panel="reloj" hidden data-ficha-theme={relojThemeJson}>
  <GameFicha ficha={reloj} locale={locale} />
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-demo-switch] [data-demo]');
  const panels = document.querySelectorAll<HTMLElement>('[data-demo-panel]');

  function applyFichaTheme(panel: HTMLElement) {
    const raw = panel.dataset.fichaTheme;
    if (!raw) return;
    const vars = JSON.parse(raw) as Record<string, string>;
    Object.entries(vars).forEach(([key, value]) => {
      document.body.style.setProperty(`--${key}`, value);
    });
    const bg = vars['ficha-bg'];
    if (bg) {
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', bg);
    }
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.demo;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      panels.forEach((panel) => {
        const show = panel.dataset.demoPanel === key;
        panel.hidden = !show;
        if (show) applyFichaTheme(panel);
      });
    });
  });
</script>

</BaseLayout>
