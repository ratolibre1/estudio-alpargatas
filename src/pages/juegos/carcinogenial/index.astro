---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../../i18n/locale';
import { carcinogenial as copy } from '../../../i18n/fichas/carcinogenial';
import { CAJA_FONTS_URL } from '../../../lib/caja-fonts';

const locale = getLocale(Astro);
const t = copy[locale];

const mutaciones = [
  { key: 'tenazas',         name: t.tenazasName,  color: '#e05a5a', simple: t.tenazasSimple,  adv: t.tenazasAdv  },
  { key: 'antenas',         name: t.antenasName,  color: '#e8904a', simple: t.antenasSimple,  adv: t.antenasAdv  },
  { key: 'caminata-lateral',name: t.caminataName, color: '#c4a820', simple: t.caminataSimple, adv: t.caminataAdv },
  { key: 'caparazon',       name: t.caparazonName,color: '#9855c8', simple: t.caparazonSimple,adv: t.caparazonAdv},
  { key: 'regeneracion',    name: t.regenName,    color: '#55a8d8', simple: t.regenSimple,    adv: t.regenAdv    },
];
---

<BaseLayout
  title={t.title}
  description={t.description}
  bodyClass="page-carcinogenial"
  themeColor="#1a1220"
  fontUrl={CAJA_FONTS_URL}
>

<style is:global>
  body.page-carcinogenial {
    background: #f4f2f0;
    color: #1a1220;
    font-family: "Helvetica Neue", Arial, sans-serif;
    --ink:       #1a1220;
    --muted:     rgba(26,18,32,.58);
    --line:      rgba(26,18,32,.1);
    --white:     #fffefe;
    --tenazas:   #e05a5a;
    --antenas:   #e8904a;
    --caminata:  #c4a820;
    --caparazon: #9855c8;
    --regen:     #55a8d8;
  }
  body.page-carcinogenial .site-header {
    background: #1a1220;
    border-bottom: 3px solid #e05a5a;
  }
  body.page-carcinogenial .brand b     { color: #f4f2f0; }
  body.page-carcinogenial .brand small { color: rgba(244,242,240,.42); }
  body.page-carcinogenial .nav-links a { color: rgba(244,242,240,.55); }
  body.page-carcinogenial .nav-links a:hover { color: #f4f2f0; }
  body.page-carcinogenial .nav-links .nav-instagram { border-color: rgba(224,90,90,.45); color: #e05a5a; }
  body.page-carcinogenial .nav-links .nav-instagram:hover { background: #e05a5a; border-color: #e05a5a; color: #fff; }
  body.page-carcinogenial .brand-logo { border-color: #e05a5a; box-shadow: 2px 2px 0 #e05a5a; }
  body.page-carcinogenial .site-footer {
    background: #1a1220;
    border-top: 3px solid #e05a5a;
    color: rgba(244,242,240,.5);
  }
  body.page-carcinogenial .site-footer b,
  body.page-carcinogenial .site-footer a { color: rgba(244,242,240,.75); }
</style>

<style>
  .cn-shell { width: min(1060px, calc(100% - 3rem)); margin-inline: auto; }
  @media (max-width: 760px) { .cn-shell { width: min(1060px, calc(100% - 1.5rem)); } }

  /* ── hero ───────────────────────────────────────────────────────── */
  .cn-hero {
    background: #1a1220;
    color: #f4f2f0;
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }
  .cn-crumb {
    display: flex; gap: .4rem;
    font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: rgba(244,242,240,.38); margin-bottom: 1.6rem;
  }
  .cn-crumb a { text-decoration: none; color: inherit; }
  .cn-crumb a:hover { color: #e05a5a; }

  .cn-hero-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .cn-hero h1 {
    font-family: "Bubblegum Sans", cursive;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -.02em;
    line-height: .92;
    margin: 0 0 1rem;
    color: #fff;
  }
  .cn-hero h1 span { color: #e05a5a; }
  .cn-hero-tag {
    font-style: italic;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    color: rgba(244,242,240,.7);
    margin: 0 0 1rem;
    max-width: 30rem;
    line-height: 1.5;
  }
  .cn-hero p {
    font-size: .95rem;
    line-height: 1.75;
    color: rgba(244,242,240,.58);
    max-width: 34rem;
    margin: 0 0 1.4rem;
  }
  .cn-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .cn-chip {
    padding: .3rem .75rem;
    border: 1.5px solid rgba(244,242,240,.2);
    border-radius: 999px;
    font-size: .62rem; font-weight: 700; letter-spacing: .07em;
    color: rgba(244,242,240,.65);
  }
  .cn-chip.red { border-color: #e05a5a; color: #e05a5a; }
  .cn-hero-logo {
    width: clamp(100px, 18vw, 220px);
    height: auto;
    opacity: .88;
  }

  /* ── shared ─────────────────────────────────────────────────────── */
  .cn-section { padding: clamp(3rem, 6vw, 5rem) 0; }
  .cn-section.alt { background: #eeeae8; }
  .cn-label {
    display: inline-flex; align-items: center; gap: .5rem;
    font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 1.1rem;
  }
  .cn-label::before { content: ""; width: 1.4rem; height: 1px; background: var(--muted); display: block; }
  .cn-h2 {
    font-family: "Bubblegum Sans", cursive;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -.02em;
    line-height: 1.05;
    margin: 0 0 1rem;
    color: var(--ink);
  }
  .cn-h2 em { font-style: normal; color: #e05a5a; }
  .cn-p {
    font-size: .95rem; line-height: 1.75; color: var(--muted); max-width: 38rem; margin: 0 0 1rem;
  }

  /* ── mutations ──────────────────────────────────────────────────── */
  .cn-mut-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .cn-mut-card {
    background: var(--white);
    border-radius: 14px;
    overflow: hidden;
    border: 2px solid var(--mc, #ccc);
    display: flex;
    flex-direction: column;
  }
  .cn-mut-img {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: .6rem;
    background: color-mix(in srgb, var(--mc) 10%, white);
  }
  .cn-mut-img img { width: 85%; height: 85%; object-fit: contain; }
  .cn-mut-body { padding: .85rem .9rem 1rem; flex: 1; display: flex; flex-direction: column; gap: .6rem; }
  .cn-mut-name {
    font-family: "Bubblegum Sans", cursive;
    font-size: 1.05rem;
    color: var(--mc);
    font-weight: 400;
    line-height: 1;
  }
  .cn-mut-action { font-size: .78rem; line-height: 1.5; color: var(--muted); }
  .cn-mut-action strong {
    display: block;
    font-size: .58rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--mc); margin-bottom: .2rem;
  }

  /* ── turn ───────────────────────────────────────────────────────── */
  .cn-turn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-top: 2rem;
  }
  .cn-step {
    background: var(--white);
    border-radius: 12px;
    padding: 1.4rem 1.3rem 1.5rem;
    border-top: 4px solid var(--step-color, #1a1220);
  }
  .cn-step-n {
    font-family: "Bubblegum Sans", cursive;
    font-size: 2.4rem;
    color: var(--step-color, #1a1220);
    line-height: 1;
    margin-bottom: .5rem;
    font-weight: 400;
  }
  .cn-step h3 {
    font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    margin: 0 0 .6rem; color: var(--ink);
  }
  .cn-step p { font-size: .85rem; line-height: 1.65; color: var(--muted); margin: 0; }

  /* ── score ──────────────────────────────────────────────────────── */
  .cn-score-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: 2rem;
  }
  .cn-score-cards { display: grid; gap: .85rem; }
  .cn-score-card {
    background: var(--white);
    border-radius: 10px;
    padding: 1rem 1.15rem;
    border-left: 4px solid var(--sc-color, #1a1220);
  }
  .cn-score-card h3 {
    font-size: .65rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    color: var(--sc-color, #1a1220); margin: 0 0 .35rem;
  }
  .cn-score-card p { font-size: .85rem; line-height: 1.55; color: var(--muted); margin: 0; }
  .cn-rounds-side { display: flex; flex-direction: column; gap: 1rem; }
  .cn-rounds-note { font-size: .82rem; line-height: 1.6; color: var(--muted); font-style: italic; }
  .cn-table {
    width: 100%; border-collapse: collapse;
    background: var(--white); border-radius: 10px; overflow: hidden;
  }
  .cn-table th, .cn-table td {
    padding: .65rem 1rem; text-align: left; border-bottom: 1px solid var(--line);
    font-size: .88rem;
  }
  .cn-table th {
    background: #1a1220; color: #f4f2f0;
    font-size: .6rem; letter-spacing: .1em; text-transform: uppercase;
  }
  .cn-table tr:last-child td { border-bottom: none; }

  /* ── origin ─────────────────────────────────────────────────────── */
  .cn-origin {
    display: flex; gap: 1rem; align-items: center;
    background: var(--white); border-radius: 12px; padding: 1.4rem 1.5rem;
    border: 2px solid var(--line); margin-top: 2rem;
  }
  .cn-origin-emoji { font-size: 2.4rem; flex-shrink: 0; }
  .cn-origin p { font-size: .9rem; line-height: 1.7; color: var(--muted); margin: 0; }
  .cn-origin a { color: #9855c8; font-weight: 700; }

  /* ── back ───────────────────────────────────────────────────────── */
  .cn-back {
    padding: 2.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    border-top: 2px solid var(--line);
  }
  .cn-back span { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .cn-back a { font-family: "Bubblegum Sans", cursive; font-weight: 400; font-size: clamp(1.4rem, 3vw, 2.2rem); text-decoration: none; color: #e05a5a; }
  .cn-back a:hover { color: #1a1220; }

  /* ── responsive ─────────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .cn-mut-grid { grid-template-columns: repeat(3, 1fr); }
    .cn-score-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .cn-hero-grid { grid-template-columns: 1fr; }
    .cn-hero-logo { display: none; }
    .cn-turn-grid { grid-template-columns: 1fr; }
    .cn-mut-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .cn-mut-grid { grid-template-columns: 1fr; }
  }
</style>

<main>

  <!-- HERO --------------------------------------------------------- -->
  <section class="cn-hero">
    <div class="cn-shell">
      <nav class="cn-crumb" aria-label={t.navAria}>
        <a href={localizePath('/', locale)}>{t.crumbHome}</a>
        <span>/</span>
        <a href={localizePath('/portafolio', locale)}>{t.crumbPortfolio}</a>
        <span>/</span>
        <span>{t.crumbHere}</span>
      </nav>
      <div class="cn-hero-grid">
        <div>
          <h1>Carcino<span>genial</span></h1>
          <p class="cn-hero-tag">{t.heroTag}</p>
          <p>{t.heroP}</p>
          <div class="cn-chips">
            <span class="cn-chip">{t.chipPlayers}</span>
            <span class="cn-chip">{t.chipAge}</span>
            <span class="cn-chip">{t.chipCards}</span>
            <span class="cn-chip">{t.chipTokens}</span>
            <span class="cn-chip red">{t.badgeProto}</span>
          </div>
        </div>
        <img class="cn-hero-logo" src="/assets/carcinogenial-logo.webp" alt="Logo Carcinogenial" />
      </div>
    </div>
  </section>

  <!-- LAS MUTACIONES ----------------------------------------------- -->
  <section class="cn-section">
    <div class="cn-shell">
      <div class="cn-label">{t.mutLabel}</div>
      <h2 class="cn-h2">{t.mutH2a} <em>{t.mutH2em}</em></h2>
      <p class="cn-p">{t.mutP}</p>
      <div class="cn-mut-grid">
        {mutaciones.map((m) => (
          <div class="cn-mut-card" style={`--mc: ${m.color}`}>
            <div class="cn-mut-img">
              <img src={`/assets/carcinogenial-${m.key}.webp`} alt={m.name} loading="lazy" />
            </div>
            <div class="cn-mut-body">
              <div class="cn-mut-name">{m.name}</div>
              <div class="cn-mut-action">
                <strong>{t.simple}</strong>
                {m.simple}
              </div>
              <div class="cn-mut-action">
                <strong>{t.advanced}</strong>
                {m.adv}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TU TURNO ----------------------------------------------------- -->
  <section class="cn-section alt">
    <div class="cn-shell">
      <div class="cn-label">{t.turnLabel}</div>
      <h2 class="cn-h2">{t.turnH2a} <em>{t.turnH2em}</em></h2>
      <div class="cn-turn-grid">
        <div class="cn-step" style="--step-color: #e05a5a">
          <div class="cn-step-n">01</div>
          <h3>{t.step1Title}</h3>
          <p>{t.step1Body}</p>
        </div>
        <div class="cn-step" style="--step-color: #9855c8">
          <div class="cn-step-n">02</div>
          <h3>{t.step2Title}</h3>
          <p>{t.step2Body}</p>
        </div>
        <div class="cn-step" style="--step-color: #55a8d8">
          <div class="cn-step-n">03</div>
          <h3>{t.step3Title}</h3>
          <p>{t.step3Body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PUNTUACIÓN ---------------------------------------------------- -->
  <section class="cn-section">
    <div class="cn-shell">
      <div class="cn-label">{t.scoreLabel}</div>
      <h2 class="cn-h2">{t.scoreH2a} <em>{t.scoreH2em}</em></h2>
      <p class="cn-p">{t.scoreP1}</p>
      <div class="cn-score-grid">
        <div class="cn-score-cards">
          <div class="cn-score-card" style="--sc-color: #9855c8">
            <h3>{t.scoreTokenTitle}</h3>
            <p>{t.scoreTokenBody}</p>
          </div>
          <div class="cn-score-card" style="--sc-color: #55a8d8">
            <h3>{t.scoreInjTitle}</h3>
            <p>{t.scoreInjBody}</p>
          </div>
          <div class="cn-score-card" style="--sc-color: #e05a5a">
            <h3>{t.scoreWinTitle}</h3>
            <p>{t.scoreWinBody}</p>
          </div>
        </div>
        <div class="cn-rounds-side">
          <table class="cn-table">
            <thead>
              <tr><th>{t.thPlayers}</th><th>{t.thRounds}</th></tr>
            </thead>
            <tbody>
              <tr><td>2</td><td>6</td></tr>
              <tr><td>3</td><td>4</td></tr>
              <tr><td>4</td><td>2</td></tr>
            </tbody>
          </table>
          <p class="cn-rounds-note">{t.tieNote}</p>
        </div>
      </div>

      <div class="cn-origin">
        <span class="cn-origin-emoji" aria-hidden="true">🐕</span>
        <div>
          <div class="cn-label" style="margin-bottom:.5rem">{t.originLabel}</div>
          <p>{t.originP} <a href={localizePath('/juegos/canes', locale)}>El Gran Festival de Canes →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- BACK ---------------------------------------------------------- -->
  <nav class="cn-back cn-shell" aria-label={t.backAria}>
    <span>{t.backPrompt}</span>
    <a href={localizePath('/portafolio', locale)}>{t.backLink}</a>
  </nav>

</main>

</BaseLayout>
