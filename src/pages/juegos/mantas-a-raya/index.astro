---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const tilePatterns = [
  'active','','mission','','active',
  '','complete','active','complete','',
  'mission','active','complete','active','mission',
  '','complete','active','complete','',
  'active','','mission','','active',
];
const tileIcons: Record<string, string> = { active: '〜', complete: '◆', mission: '○' };
const tiles = tilePatterns.map(cls => ({ cls, icon: cls ? tileIcons[cls] : '' }));

const misionCells = [true,false,true,false, false,true,true,true, true,true,true,false, false,false,true,false];
---

<BaseLayout
  title="Mantas a Raya — Estudio Alpargatas"
  description="Mantas a Raya: gira y voltea mantarrayas en un tablero compartido para completar los patrones de tus misiones."
  bodyClass="page-mantas"
  footerSubtitle="Mantas a Raya · Patrones submarinos · Prototipo V1"
  themeColor="#051820"
>

<style is:global>
  /* ── Body ─────────────────────────────────────────────────────────────── */
  body.page-mantas {
    background-color: #051820;
    color: #d8eef4;
    font-family: "Helvetica Neue", Arial, sans-serif;
    background-image: none;
  }

  /* ── Header dark translúcido ─────────────────────────────────────────── */
  body.page-mantas .site-header {
    background: rgba(5, 24, 32, .92);
    border-bottom-color: rgba(90, 184, 200, .2);
  }
  body.page-mantas .brand b      { color: #d8eef4; }
  body.page-mantas .brand small  { color: rgba(216, 238, 244, .45); }
  body.page-mantas .nav-links a  { color: rgba(216, 238, 244, .55); }
  body.page-mantas .nav-links a:hover { color: #5ab8c8; }
  body.page-mantas .nav-links .nav-instagram {
    border-color: rgba(216, 238, 244, .25);
    color: #d8eef4;
  }
  body.page-mantas .nav-links .nav-instagram:hover {
    background: #5ab8c8;
    border-color: #5ab8c8;
    color: #051820;
  }
  body.page-mantas .brand-logo {
    border-color: rgba(90, 184, 200, .45);
    box-shadow: 2px 2px 0 #5ab8c8;
  }

  /* ── Footer ─────────────────────────────────────────────────────────── */
  body.page-mantas .site-footer {
    background: #020e14;
    border-top-color: rgba(90, 184, 200, .15);
  }

  /* ── Variables ───────────────────────────────────────────────────────── */
  body.page-mantas {
    --water:   #5ab8c8;
    --foam:    #88d4e0;
    --deep:    #0a2a3a;
    --sand:    #d4b890;
    --abyssal: #020e14;
    --text:    #d8eef4;
    --soft:    rgba(216, 238, 244, .6);
    --line:    rgba(90, 184, 200, .15);
  }

  /* ── Shell ───────────────────────────────────────────────────────────── */
  .mr-shell { width: min(1100px, calc(100% - 3rem)); margin-inline: auto; }

  /* ── Waves: separadores de sección con clip-path ──────────────────────── */
  .wave-bottom {
    display: block;
    width: 100%;
    height: 5rem;
    background: inherit;
    clip-path: ellipse(55% 100% at 50% 0%);
    margin-top: -1px;
  }

  /* ── Etiqueta de sección ─────────────────────────────────────────────── */
  .mr-label {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--water);
    margin-bottom: 1rem;
  }
  .mr-label::before {
    content: "";
    display: block;
    width: .4rem;
    height: .4rem;
    border-radius: 50%;
    background: var(--water);
  }

  /* ── Breadcrumb ──────────────────────────────────────────────────────── */
  .mr-breadcrumb {
    display: flex;
    gap: .5rem;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(216, 238, 244, .38);
    margin-bottom: 2.5rem;
  }
  .mr-breadcrumb a { text-decoration: none; color: inherit; }
  .mr-breadcrumb a:hover { color: var(--water); }

  /* ── HERO ────────────────────────────────────────────────────────────── */
  .mr-hero {
    position: relative;
    min-height: calc(100svh - 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(4rem, 8vw, 7rem) 0 8rem;
    overflow: hidden;
  }
  /* Círculos concéntricos de fondo imitando el agua */
  .mr-hero::before {
    content: "";
    position: absolute;
    right: -10%;
    top: 50%;
    transform: translateY(-50%);
    width: 65vw;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(90, 184, 200, .08);
    box-shadow:
      0 0 0 5vw  rgba(90, 184, 200, .04),
      0 0 0 12vw rgba(90, 184, 200, .03),
      0 0 0 20vw rgba(90, 184, 200, .02);
  }
  .mr-hero-inner { position: relative; z-index: 2; }
  .mr-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }
  .mr-hero h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3.5rem, 9vw, 8rem);
    letter-spacing: -.04em;
    line-height: .9;
    color: #d8eef4;
    margin: 0 0 1.5rem;
  }
  .mr-hero-tagline {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    color: var(--water);
    font-family: Georgia, serif;
    font-style: italic;
    letter-spacing: .04em;
    margin-bottom: 1.8rem;
  }
  .mr-hero p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--soft);
    max-width: 34rem;
    margin-bottom: 2rem;
  }
  .mr-chips {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
    margin-bottom: 1.8rem;
  }
  .mr-chip {
    padding: .35rem .7rem;
    border: 1px solid rgba(90, 184, 200, .3);
    border-radius: 999px;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--water);
  }
  .mr-chip.sand {
    border-color: rgba(212, 184, 144, .35);
    color: var(--sand);
  }
  .mr-badge {
    display: inline-flex;
    padding: .4rem .8rem;
    border: 1.5px solid var(--water);
    border-radius: 999px;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--water);
  }

  /* Patrón visual en el hero: simulación de losetas en una cuadrícula */
  .mr-tile-preview {
    aspect-ratio: 1;
    max-width: 26rem;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(5, 1fr);
    gap: 3px;
    border: 1px solid rgba(90, 184, 200, .15);
    padding: 3px;
    background: rgba(5, 24, 32, .5);
    backdrop-filter: blur(8px);
  }
  .mr-tile {
    background: var(--deep);
    border: 1px solid rgba(90, 184, 200, .12);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .7rem;
    color: rgba(90, 184, 200, .5);
    transition: background 300ms;
  }
  /* Tiles que forman un patrón de mantarraya (simplificado con unicode) */
  .mr-tile.active {
    background: rgba(90, 184, 200, .15);
    border-color: rgba(90, 184, 200, .4);
    color: var(--water);
  }
  .mr-tile.mission {
    background: rgba(90, 184, 200, .08);
    border-color: rgba(212, 184, 144, .4);
    color: var(--sand);
  }
  .mr-tile.complete {
    background: rgba(90, 184, 200, .25);
    border-color: var(--water);
    color: var(--foam);
  }

  /* ── SECCIÓN 01: LA IDEA ─────────────────────────────────────────────── */
  .mr-idea {
    background: var(--deep);
    padding: clamp(5rem, 10vw, 9rem) 0;
    position: relative;
  }
  .mr-idea-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }
  .mr-idea h2 {
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: -.035em;
    line-height: 1.05;
    color: #d8eef4;
    margin: 0 0 1.5rem;
  }
  .mr-idea p { font-size: .95rem; line-height: 1.8; color: var(--soft); margin: 0 0 1rem; }

  /* Diagrama de volteo/giro */
  .mr-flip-demo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  .mr-flip-tile {
    aspect-ratio: 1;
    border: 1px solid rgba(90, 184, 200, .3);
    background: var(--deep);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-size: 2.5rem;
    color: var(--water);
    position: relative;
  }
  .mr-flip-label {
    position: absolute;
    bottom: .5rem;
    left: 0; right: 0;
    text-align: center;
    font-size: .55rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .mr-flip-arrow {
    font-size: 1.2rem;
    color: var(--water);
    text-align: center;
  }

  /* ── SECCIÓN 02: LA TENSIÓN ──────────────────────────────────────────── */
  .mr-tension {
    padding: clamp(5rem, 10vw, 9rem) 0;
    background: #051820;
  }
  .mr-tension-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }
  .mr-tension h2 {
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -.035em;
    line-height: 1.05;
    color: #d8eef4;
    margin: 0 0 1.5rem;
  }
  .mr-tension p { font-size: .95rem; line-height: 1.8; color: var(--soft); margin: 0 0 1rem; }

  /* Tarjeta de misión */
  .mr-mission-card {
    border: 1px solid rgba(90, 184, 200, .2);
    padding: 1.5rem;
    background: var(--deep);
    border-radius: 4px;
    position: relative;
  }
  .mr-mission-card::before {
    content: "MISIÓN";
    position: absolute;
    top: -.65rem;
    left: 1rem;
    background: var(--water);
    color: #051820;
    font-size: .55rem;
    font-weight: 900;
    letter-spacing: .12em;
    padding: .15rem .45rem;
  }
  .mr-mission-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    margin-bottom: 1rem;
  }
  .mr-mission-cell {
    aspect-ratio: 1;
    background: rgba(90, 184, 200, .06);
    border: 1px solid rgba(90, 184, 200, .12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .9rem;
    color: rgba(90, 184, 200, .35);
  }
  .mr-mission-cell.filled {
    background: rgba(90, 184, 200, .2);
    border-color: rgba(90, 184, 200, .5);
    color: var(--water);
  }
  .mr-mission-desc {
    font-size: .78rem;
    color: var(--soft);
    line-height: 1.5;
  }
  .mr-mission-desc strong { color: var(--water); font-weight: 700; }

  /* ── SECCIÓN 03: ESTADO ──────────────────────────────────────────────── */
  .mr-status {
    background: var(--deep);
    padding: clamp(4rem, 8vw, 7rem) 0;
  }
  .mr-status-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }
  .mr-version {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(5rem, 12vw, 9rem);
    font-weight: 900;
    letter-spacing: -.1em;
    line-height: .82;
    color: var(--water);
    margin-bottom: 1.4rem;
  }
  .mr-status h2 {
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -.03em;
    line-height: 1.05;
    color: #d8eef4;
    margin: 0 0 1rem;
  }
  .mr-status p { font-size: .9rem; line-height: 1.8; color: var(--soft); margin: 0 0 .8rem; }
  .mr-status-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .mr-status-list li {
    padding: .8rem 0;
    border-bottom: 1px solid var(--line);
    font-size: .85rem;
    color: var(--soft);
    display: grid;
    grid-template-columns: .6rem 1fr;
    gap: .75rem;
    align-items: start;
  }
  .mr-status-list li::before {
    content: "·";
    color: var(--water);
    font-size: 1.2rem;
    line-height: 1;
  }

  /* ── Back link ───────────────────────────────────────────────────────── */
  .mr-back {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .mr-back span { font-size: .78rem; color: var(--soft); font-family: Georgia, serif; font-style: italic; }
  .mr-back a {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(1.3rem, 3vw, 2.5rem);
    font-weight: 700;
    text-decoration: none;
    color: var(--water);
  }
  .mr-back a:hover { color: #d8eef4; }

  @media (max-width: 780px) {
    .mr-hero-grid,
    .mr-idea-grid,
    .mr-tension-grid,
    .mr-status-inner { grid-template-columns: 1fr; }
    .mr-tile-preview { max-width: 100%; }
    .mr-hero::before { display: none; }
  }
</style>

<main>
  <!-- ── HERO ── -->
  <section class="mr-hero">
    <div class="mr-shell mr-hero-inner">
      <nav class="mr-breadcrumb" aria-label="Navegación">
        <a href="/">Inicio</a><span>/</span><span>Mantas a Raya</span>
      </nav>
      <div class="mr-hero-grid">
        <div>
          <p class="mr-label">Patrones submarinos</p>
          <h1>Mantas<br />a Raya</h1>
          <p class="mr-hero-tagline">Gira. Voltea. Completa.</p>
          <p>Un tablero compartido de losetas hexagonales con mantarrayas. El reto es orientar las piezas para completar los patrones de tus misiones sin destruir los del otro jugador.</p>
          <div class="mr-chips">
            <span class="mr-chip">2 jugadores</span>
            <span class="mr-chip">20–30 min</span>
            <span class="mr-chip">Losetas</span>
            <span class="mr-chip sand">Prototipo V1</span>
          </div>
          <span class="mr-badge">Prototipo activo</span>
        </div>

        <!-- Simulación visual del tablero de losetas -->
        <div class="mr-tile-preview" aria-label="Vista del tablero de Mantas a Raya">
          {tiles.map(tile => (
            <div class={`mr-tile${tile.cls ? ' ' + tile.cls : ''}`}>
              {tile.icon}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECCIÓN 01: LA IDEA ── -->
  <section class="mr-idea">
    <div class="mr-shell mr-idea-grid">
      <!-- Diagrama de volteo -->
      <div>
        <p class="mr-label">01 — La mecánica</p>
        <div class="mr-flip-demo">
          <div class="mr-flip-tile">
            〜
            <span class="mr-flip-label">Original</span>
          </div>
          <div class="mr-flip-arrow">→<br /><span style="font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--soft);">Giro<br />90°</span></div>
          <div class="mr-flip-tile" style="transform: rotate(90deg);">
            〜
            <span class="mr-flip-label" style="transform:rotate(-90deg)">Girada</span>
          </div>
        </div>
        <div style="margin-top:2rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          {[
            { label: 'Girar', desc: 'Rota la loseta 90°. La mantarraya cambia de dirección.' },
            { label: 'Voltear', desc: 'Da vuelta la loseta. El dorso tiene otra configuración.' },
          ].map(a => (
            <div style="border:1px solid var(--line);padding:1rem;">
              <div style="font-size:.6rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--water);margin-bottom:.4rem;">{a.label}</div>
              <p style="font-size:.82rem;color:var(--soft);line-height:1.55;margin:0">{a.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2>Un tablero<br />vivo y compartido.</h2>
        <p>Las losetas de Mantas a Raya no tienen una posición fija. En cada turno, el jugador activo puede girar o voltear una loseta del tablero antes de jugar la suya.</p>
        <p>El tablero pertenece a ambos. Cada decisión de posicionamiento puede completar tu patrón de misión, pero también alterar el del otro jugador. O viceversa. A veces ambas cosas a la vez.</p>
        <p>La mantarraya como pieza no es arbitraria: su forma asimétrica hace que girar y voltear produzcan resultados completamente diferentes. La misma loseta puede tener cuatro caras útiles.</p>
      </div>
    </div>
  </section>

  <!-- ── SECCIÓN 02: LA TENSIÓN ── -->
  <section class="mr-tension">
    <div class="mr-shell mr-tension-grid">
      <div>
        <p class="mr-label">02 — La tensión</p>
        <h2>Lo que sirve para ti<br />puede romper al otro.</h2>
        <p>Cada jugador tiene un set de misiones que mostrar: patrones específicos que deben aparecer en el tablero al final de la partida.</p>
        <p>El problema es que el tablero es uno solo. Si giras una loseta para completar tu patrón de esquina, puede que estés deshaciendo la formación que el otro necesitaba. O puede que no. Pero nunca lo sabes del todo.</p>
        <p>La información es completa: ambos ven el tablero y conocen las misiones del otro. La tensión viene de no poder controlar todo al mismo tiempo.</p>
      </div>

      <!-- Simulación de tarjeta de misión -->
      <div>
        <div class="mr-mission-card">
          <div class="mr-mission-grid">
            {misionCells.map(filled => (
              <div class={`mr-mission-cell${filled ? ' filled' : ''}`}>
                {filled ? '〜' : ''}
              </div>
            ))}
          </div>
          <p class="mr-mission-desc">
            <strong>Misión activa:</strong> Completar una formación en V de cuatro mantarrayas orientadas hacia el centro.
          </p>
        </div>
        <div style="margin-top:1.5rem;padding:1.2rem;border:1px solid var(--line);border-left:3px solid var(--sand);">
          <p style="font-size:.82rem;color:var(--soft);line-height:1.6;margin:0;font-family:Georgia,serif;font-style:italic;">
            "Cada misión completada al final suma. Las incompletas no restan. Pero las que el rival completa gracias a tu jugada sí pueden doler."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECCIÓN 03: ESTADO ── -->
  <section class="mr-status">
    <div class="mr-shell mr-status-inner">
      <div>
        <p class="mr-label">03 — Estado actual</p>
        <div class="mr-version" aria-hidden="true">V1</div>
        <ul class="mr-status-list">
          <li>Tablero 5×5 de losetas con dos caras cada una.</li>
          <li>Set de 12 misiones; se juega con 4 por partida.</li>
          <li>Acciones: girar (90°/180°/270°) o voltear.</li>
          <li>Pendiente: calibrar puntuación y número de misiones activas.</li>
          <li>Pendiente: diseño visual final de las mantarrayas en las losetas.</li>
        </ul>
      </div>
      <div>
        <h2>Nació de mirar<br /><em>el mar</em><br />desde arriba.</h2>
        <p>Mantas a Raya empezó con una imagen: las formaciones que hacen los cardúmenes de mantarrayas vistas desde arriba. El movimiento sincronizado, los giros, las formas que se construyen y deshacen solas.</p>
        <p>La primera versión usaba piezas de dominó. La segunda, fichas hexagonales. La tercera vez, alguien giró una loseta cuadrada noventa grados y de repente la manta era una manta. Ahí empezó el juego real.</p>
      </div>
    </div>
  </section>

  <nav class="mr-back mr-shell" aria-label="Volver a proyectos">
    <span>Seguimos mirando</span>
    <a href="/#juegos">Volver a todos los juegos →</a>
  </nav>
</main>

</BaseLayout>
