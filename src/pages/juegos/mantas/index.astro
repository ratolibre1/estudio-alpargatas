---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../../i18n/locale';
import { mantas as copy } from '../../../i18n/fichas/mantas';

const locale = getLocale(Astro);
const t = copy[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  bodyClass="page-mantas"
  themeColor="#051820"
>

<style is:global>
  body.page-mantas {
    background-color: #051820;
    color: #d8eef4;
    font-family: "Helvetica Neue", Arial, sans-serif;
    background-image: none;
    --water:   #5ab8c8;
    --foam:    #88d4e0;
    --deep:    #0a2a3a;
    --sand:    #d4b890;
    --abyssal: #020e14;
    --text:    #d8eef4;
    --soft:    rgba(216, 238, 244, .6);
    --line:    rgba(90, 184, 200, .15);
  }

  body.page-mantas .site-header {
    background: rgba(5, 24, 32, .92);
    border-bottom-color: rgba(90, 184, 200, .2);
  }
  body.page-mantas .brand b      { color: #d8eef4; }
  body.page-mantas .brand small  { color: rgba(216, 238, 244, .45); }
  body.page-mantas .nav-links a  { color: rgba(216, 238, 244, .55); }
  body.page-mantas .nav-links a:hover { color: #5ab8c8; }
  body.page-mantas .nav-links .nav-instagram {
    border-color: rgba(216, 238, 244, .25);
    color: #d8eef4;
  }
  body.page-mantas .nav-links .nav-instagram:hover {
    background: #5ab8c8;
    border-color: #5ab8c8;
    color: #051820;
  }
  body.page-mantas .brand-logo {
    border-color: rgba(90, 184, 200, .45);
    box-shadow: 2px 2px 0 #5ab8c8;
  }

  body.page-mantas .site-footer {
    background: #020e14;
    border-top-color: rgba(90, 184, 200, .15);
  }

  .mr-shell { width: min(1100px, calc(100% - 3rem)); margin-inline: auto; }

  .mr-label {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--water);
    margin-bottom: 1rem;
  }
  .mr-label::before {
    content: "";
    display: block;
    width: .4rem;
    height: .4rem;
    border-radius: 50%;
    background: var(--water);
  }

  .mr-breadcrumb {
    display: flex;
    gap: .5rem;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(216, 238, 244, .38);
    margin-bottom: 2.5rem;
  }
  .mr-breadcrumb a { text-decoration: none; color: inherit; }
  .mr-breadcrumb a:hover { color: var(--water); }

  .mr-hero {
    position: relative;
    min-height: calc(100svh - 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.75rem, 5.5vw, 4.75rem) 0 3.25rem;
    overflow: hidden;
  }
  .mr-hero::before {
    content: "";
    position: absolute;
    right: -10%;
    top: 50%;
    transform: translateY(-50%);
    width: 65vw;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(90, 184, 200, .08);
    box-shadow:
      0 0 0 5vw  rgba(90, 184, 200, .04),
      0 0 0 12vw rgba(90, 184, 200, .03),
      0 0 0 20vw rgba(90, 184, 200, .02);
  }
  .mr-hero-inner { position: relative; z-index: 2; }
  .mr-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }
  .mr-hero-logo {
    display: block;
    width: min(22rem, 100%);
    margin: 0 0 1.4rem;
  }
  .mr-hero h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .mr-hero-tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    color: var(--water);
    font-family: Georgia, serif;
    font-style: italic;
    letter-spacing: .02em;
    margin: 0 0 1.4rem;
  }
  .mr-hero p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--soft);
    max-width: 34rem;
    margin: 0 0 1.6rem;
  }
  .mr-chips {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
  }
  .mr-chip {
    padding: .35rem .7rem;
    border: 1px solid rgba(90, 184, 200, .3);
    border-radius: 999px;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--water);
  }
  .mr-chip.sand {
    border-color: rgba(212, 184, 144, .35);
    color: var(--sand);
  }
  .mr-hero-board {
    margin: 0;
  }
  .mr-hero-board img {
    width: 100%;
    max-width: 28rem;
    border-radius: 8px;
    border: 1px solid rgba(90, 184, 200, .25);
    box-shadow: 6px 6px 0 rgba(90, 184, 200, .18);
  }
  .mr-hero-board figcaption {
    margin-top: .7rem;
    font-size: .72rem;
    color: var(--soft);
  }

  .mr-idea,
  .mr-turn,
  .mr-missions,
  .mr-end {
    padding: clamp(3rem, 6vw, 5rem) 0;
  }
  .mr-idea,
  .mr-missions { background: var(--deep); }
  .mr-turn,
  .mr-end { background: #051820; }

  .mr-idea h2,
  .mr-turn h2,
  .mr-missions h2,
  .mr-end h2 {
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -.035em;
    line-height: 1.05;
    color: #d8eef4;
    margin: 0 0 1.4rem;
  }
  .mr-idea p,
  .mr-turn p,
  .mr-missions p,
  .mr-end p {
    font-size: .95rem;
    line-height: 1.8;
    color: var(--soft);
    margin: 0 0 1rem;
  }

  .mr-idea-grid,
  .mr-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .mr-components {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.2rem;
  }
  .mr-component {
    padding: 1rem 1rem 1.15rem;
    border: 1px solid var(--line);
    background: rgba(5, 24, 32, .35);
    text-align: center;
  }
  .mr-component img {
    width: 100%;
    max-height: 5.5rem;
    object-fit: contain;
    margin-bottom: .7rem;
  }
  .mr-component span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--water);
    margin-bottom: .35rem;
  }
  .mr-component p {
    margin: 0;
    font-size: .78rem;
    line-height: 1.45;
    color: var(--soft);
  }

  .mr-steps {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mr-steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .mr-steps b {
    color: var(--foam);
    font-size: 1.05rem;
  }
  .mr-step-n {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--water);
  }
  .mr-nope {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin-top: 1.2rem;
  }
  .mr-nope span {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .6rem;
    border: 1px solid rgba(212, 184, 144, .3);
    color: var(--sand);
    font-size: .68rem;
    font-weight: 700;
  }
  .mr-nope img { width: 1.4rem; height: 1.4rem; object-fit: contain; }

  .mr-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .mr-action {
    padding: 1.2rem;
    border: 1px solid var(--line);
    background: rgba(10, 42, 58, .5);
  }
  .mr-action span {
    display: block;
    font-size: .58rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--water);
    margin-bottom: .5rem;
  }
  .mr-action p { margin: 0 0 .9rem; font-size: .85rem; }
  .mr-flip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .7rem;
  }
  .mr-flip img {
    width: 4.6rem;
    height: 4.6rem;
    object-fit: contain;
    border-radius: 6px;
  }
  .mr-flip em {
    font-style: normal;
    color: var(--water);
    font-weight: 800;
  }

  .mr-conditions {
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .mr-conditions li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: .75rem;
    padding: .75rem 0;
    border-top: 1px solid var(--line);
    color: var(--soft);
    font-size: .92rem;
  }
  .mr-conditions i {
    font-style: normal;
    color: var(--water);
    font-weight: 800;
  }

  .mr-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .8rem;
    margin: 0;
  }
  .mr-cards figure { margin: 0; }
  .mr-cards img {
    width: 100%;
    border-radius: 8px;
    border: 1px solid rgba(90, 184, 200, .25);
  }
  .mr-cards figcaption {
    margin-top: .45rem;
    font-size: .68rem;
    color: var(--soft);
  }

  .mr-winner {
    padding: 1.6rem 1.7rem;
    border: 1px solid rgba(90, 184, 200, .25);
    background: rgba(10, 42, 58, .55);
  }
  .mr-winner span {
    display: block;
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--sand);
    margin-bottom: .5rem;
  }
  .mr-winner strong {
    display: block;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #d8eef4;
    margin-bottom: .6rem;
  }
  .mr-winner p { margin: 0; }

  .mr-gallery {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    border-top: 1px solid var(--line);
  }
  .mr-gallery h2 {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: #d8eef4;
    margin: 0 0 1.5rem;
  }
  .mr-gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .mr-gallery-grid figure {
    margin: 0;
    background: #04151c;
    border: 1px solid rgba(90, 184, 200, .22);
  }
  .mr-gallery-grid figure:first-child { grid-column: 1 / -1; }
  .mr-gallery-grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .mr-gallery-grid figure:first-child img { aspect-ratio: 16 / 10; }
  .mr-gallery-grid figcaption {
    padding: .65rem .8rem .75rem;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: .82rem;
    color: var(--soft);
  }

  .mr-back {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .mr-back span { font-size: .78rem; color: var(--soft); font-family: Georgia, serif; font-style: italic; }
  .mr-back a {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(1.3rem, 3vw, 2.5rem);
    font-weight: 700;
    text-decoration: none;
    color: var(--water);
  }
  .mr-back a:hover { color: #d8eef4; }

  @media (max-width: 980px) {
    .mr-hero-grid,
    .mr-idea-grid,
    .mr-split,
    .mr-actions,
    .mr-gallery-grid { grid-template-columns: 1fr; }
    .mr-gallery-grid figure:first-child { grid-column: auto; }
    .mr-hero::before { display: none; }
    .mr-hero-logo { width: min(16rem, 80%); }
  }
  @media (max-width: 760px) {
    .mr-shell { width: min(1100px, calc(100% - 1.5rem)); }
  }
  @media (max-width: 520px) {
    .mr-components,
    .mr-cards { grid-template-columns: 1fr; }
  }
</style>

<main>
  <section class="mr-hero">
    <div class="mr-shell mr-hero-inner">
      <nav class="mr-breadcrumb" aria-label={t.navAria}>
        <a href={localizePath('/', locale)}>{t.crumbHome}</a><span>/</span><span>{t.crumbHere}</span>
      </nav>
      <div class="mr-hero-grid">
        <div>
          <p class="mr-label">{t.heroLabel}</p>
          <img class="mr-hero-logo" src="/assets/mantas-logo.webp" alt={t.logoAlt} />
          <h1>{t.crumbHere}</h1>
          <p class="mr-hero-tagline">{t.heroTag}</p>
          <p>{t.heroP}</p>
          <div class="mr-chips">
            <span class="mr-chip">{t.chipPlayers}</span>
            <span class="mr-chip">{t.chipTime}</span>
            <span class="mr-chip">{t.chipAge}</span>
            <span class="mr-chip">{t.chipMissions}</span>
            <span class="mr-chip sand">{t.chipProto}</span>
          </div>
        </div>
        <figure class="mr-hero-board">
          <img src="/assets/mantas-tablero.webp" alt={t.boardAlt} />
          <figcaption>{t.boardCap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="mr-idea">
    <div class="mr-shell">
      <p class="mr-label">{t.ideaLabel}</p>
      <div class="mr-idea-grid">
        <div>
          <h2 set:html={t.ideaH2} />
          <p>{t.ideaP1}</p>
          <p>{t.ideaP2}</p>
          <p>{t.ideaP3}</p>
        </div>
        <div>
          <div class="mr-components">
            <article class="mr-component">
              <img src="/assets/mantas-loseta-a.webp" alt={t.comp1Alt} />
              <span>{t.comp1K}</span>
              <p>{t.comp1P}</p>
            </article>
            <article class="mr-component">
              <img src="/assets/mantas-bote.webp" alt={t.comp2Alt} />
              <span>{t.comp2K}</span>
              <p>{t.comp2P}</p>
            </article>
            <article class="mr-component">
              <img src="/assets/mantas-mision-2.webp" alt={t.comp3Alt} />
              <span>{t.comp3K}</span>
              <p>{t.comp3P}</p>
            </article>
            <article class="mr-component">
              <img src="/assets/mantas-meeple-naranja.webp" alt={t.comp4Alt} />
              <span>{t.comp4K}</span>
              <p>{t.comp4P}</p>
            </article>
            <article class="mr-component">
              <img src="/assets/mantas-salvavidas.webp" alt={t.comp5Alt} />
              <span>{t.comp5K}</span>
              <p>{t.comp5P}</p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mr-turn">
    <div class="mr-shell mr-split">
      <div>
        <p class="mr-label">{t.turnLabel}</p>
        <h2 set:html={t.turnH2} />
        <ol class="mr-steps">
          <li>
            <span class="mr-step-n">1</span>
            <div>
              <b>{t.step1Title}</b>
              <p>{t.step1Body}</p>
            </div>
          </li>
          <li>
            <span class="mr-step-n">2</span>
            <div>
              <b>{t.step2Title}</b>
              <p>{t.step2Body}</p>
            </div>
          </li>
          <li>
            <span class="mr-step-n">3</span>
            <div>
              <b>{t.step3Title}</b>
              <p>{t.step3Body}</p>
            </div>
          </li>
        </ol>
        <div class="mr-nope" aria-label={t.nopeAria}>
          <span><img src="/assets/mantas-bote.webp" alt="" /> {t.nopeBoat}</span>
          <span><img src="/assets/mantas-meeple-morado.webp" alt="" /> {t.nopeMeeple}</span>
          <span><img src="/assets/mantas-salvavidas.webp" alt="" /> {t.nopeLife}</span>
        </div>
      </div>
      <div>
        <div class="mr-actions">
          <article class="mr-action">
            <span>{t.actRotate}</span>
            <p>{t.actRotateP}</p>
            <div class="mr-flip">
              <img src="/assets/mantas-loseta-a.webp" alt={t.flipAlt1} />
              <em>90°</em>
              <img src="/assets/mantas-loseta-a.webp" alt={t.flipAlt2} style="transform: rotate(90deg)" />
            </div>
          </article>
          <article class="mr-action">
            <span>{t.actFlip}</span>
            <p>{t.actFlipP}</p>
            <div class="mr-flip">
              <img src="/assets/mantas-loseta-a.webp" alt={t.flipAlt3} />
              <em>⇔</em>
              <img src="/assets/mantas-loseta-b.webp" alt={t.flipAlt4} />
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="mr-missions">
    <div class="mr-shell mr-split">
      <div>
        <p class="mr-label">{t.missLabel}</p>
        <h2 set:html={t.missH2} />
        <p>{t.missP1}</p>
        <ol class="mr-conditions">
          <li><i>1</i> {t.cond1}</li>
          <li><i>2</i> {t.cond2}</li>
          <li><i>3</i> {t.cond3}</li>
          <li><i>4</i> {t.cond4}</li>
        </ol>
        <p>{t.missP2}</p>
      </div>
      <div class="mr-cards">
        <figure>
          <img src="/assets/mantas-mision-1.webp" alt={t.card1Alt} />
          <figcaption>{t.card1Cap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/mantas-mision-2.webp" alt={t.card2Alt} />
          <figcaption>{t.card2Cap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/mantas-mision-3.webp" alt={t.card3Alt} />
          <figcaption>{t.card3Cap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="mr-end">
    <div class="mr-shell mr-split">
      <div>
        <p class="mr-label">{t.endLabel}</p>
        <h2 set:html={t.endH2} />
        <p>{t.endP1}</p>
        <p>{t.endP2}</p>
        <p>{t.endP3}</p>
      </div>
      <div class="mr-winner">
        <span>{t.winnerK}</span>
        <strong>{t.winnerTitle}</strong>
        <p>{t.winnerP}</p>
      </div>
    </div>
  </section>

  <section class="mr-gallery">
    <div class="mr-shell">
      <p class="mr-label">{t.galLabel}</p>
      <h2 set:html={t.galH2} />
      <div class="mr-gallery-grid">
        <figure>
          <img src="/assets/mantas-partida.webp" alt={t.galPartidaAlt} />
          <figcaption>{t.galPartidaCap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/mantas-losetas-mesa.webp" alt={t.galLosetasAlt} />
          <figcaption>{t.galLosetasCap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/mantas-tabletopia.webp" alt={t.galDigitalAlt} />
          <figcaption>{t.galDigitalCap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/mantas-proto-meeples.webp" alt={t.galProtoMeeplesAlt} />
          <figcaption>{t.galProtoMeeplesCap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/mantas-proto-abanico.webp" alt={t.galProtoFanAlt} />
          <figcaption>{t.galProtoFanCap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <nav class="mr-back mr-shell" aria-label={t.backAria}>
    <span>{t.backPrompt}</span>
    <a href={localizePath('/#juegos', locale)}>{t.backLink}</a>
  </nav>
</main>

</BaseLayout>
