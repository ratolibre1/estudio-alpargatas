---
/**
 * Ficha unificada desde Content Collections + GameFicha.
 * Reservado en rutas: `plantilla/`, `old/` (fichas deprecadas).
 * Legacy handmade: `/juegos/old/<keyword>/`
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameFicha from '../../../components/GameFicha.astro';
import { getCollection } from 'astro:content';
import { readdirSync } from 'node:fs';
import path from 'node:path';
import { getLocale } from '../../../i18n/locale';
import { localizeGame, gameHref } from '../../../lib/games';
import { fichaConceptArtUrl, mergeFicha, toFicha, type FichaContent } from '../../../lib/ficha';
import { demoNinive, demoReloj } from '../../../lib/ficha-demos';
import { ficha as fichaCopy } from '../../../i18n/fichas/ficha';
import { fichaThemeVars } from '../../../lib/ficha-theme';
import { CAJA_FONTS_URL } from '../../../lib/caja-fonts';
import type { GameCard } from '../../../lib/games';
import type { Lang } from '../../../i18n/locale';

export async function getStaticPaths() {
  const games = await getCollection('games');
  const juegosDir = path.join(process.cwd(), 'src/pages/juegos');
  const reserved = new Set(
    readdirSync(juegosDir, { withFileTypes: true })
      .filter((d) => d.isDirectory() && d.name !== '[slug]')
      .map((d) => d.name)
  );

  return games
    .filter((entry) => !reserved.has(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

function buildFicha(card: GameCard, locale: Lang, keyword: string): FichaContent {
  if (keyword === 'ninive') return demoNinive(card, locale);
  if (keyword === 'reloj') return demoReloj(card, locale);

  const ui = fichaCopy[locale];
  return mergeFicha(toFicha(card), {
    image: fichaConceptArtUrl(keyword),
    imageAlt: card.imageAlt ?? card.name,
    imageCaption: ui.conceptCaption,
    pitch: card.pitch ?? card.description,
  });
}

const { entry } = Astro.props;
const locale = getLocale(Astro);
const card = localizeGame(
  {
    ...entry.data,
    id: entry.id,
    href: gameHref(entry.data.keyword, locale),
    blurb: entry.data.description ?? entry.data.tagline,
  },
  locale
);
const ficha = buildFicha(card, locale, entry.id);
const theme = fichaThemeVars(ficha);
---

<BaseLayout
  title={`${ficha.name} — Estudio Alpargatas`}
  description={ficha.tagline}
  bodyClass="ficha-page"
  theme={theme}
  themeColor={ficha.bg}
  fontUrl={CAJA_FONTS_URL}
>
  <GameFicha ficha={ficha} locale={locale} />
</BaseLayout>
