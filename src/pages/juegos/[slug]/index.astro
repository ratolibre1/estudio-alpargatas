---
/**
 * Ficha unificada desde Content Collections + GameFicha.
 * Reservado en rutas: `old/` (fichas deprecadas).
 * Legacy handmade: `/juegos/old/<keyword>/`
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameFicha from '../../../components/GameFicha.astro';
import { getCollection } from 'astro:content';
import { readdirSync } from 'node:fs';
import path from 'node:path';
import { getLocale } from '../../../i18n/locale';
import { localizeGame, gameHref } from '../../../lib/games';
import { buildLegacyFicha } from '../../../lib/ficha-overlays';
import {
  fichaBandMode,
  fichaOnPrimary,
  fichaThemeColor,
  fichaThemeVars,
} from '../../../lib/ficha-theme';
import { CAJA_FONTS_URL } from '../../../lib/caja-fonts';
export async function getStaticPaths() {
  const games = await getCollection('games');
  const juegosDir = path.join(process.cwd(), 'src/pages/juegos');
  const reserved = new Set(
    readdirSync(juegosDir, { withFileTypes: true })
      .filter((d) => d.isDirectory() && d.name !== '[slug]')
      .map((d) => d.name)
  );

  return games
    .filter((entry) => !reserved.has(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const locale = getLocale(Astro);
const card = localizeGame(
  {
    ...entry.data,
    id: entry.id,
    href: gameHref(entry.data.keyword, locale),
    blurb: entry.data.description ?? entry.data.tagline,
  },
  locale
);
const ficha = buildLegacyFicha(card, locale, entry.id);
const theme = fichaThemeVars(ficha);
---

<BaseLayout
  title={`${ficha.name} — Estudio Alpargatas`}
  description={ficha.tagline}
  bodyClass="ficha-page"
  theme={theme}
  themeColor={fichaThemeColor(ficha)}
  fichaBand={fichaBandMode(ficha)}
  fichaOnPrimary={fichaOnPrimary(ficha)}
  fontUrl={CAJA_FONTS_URL}
>
  <GameFicha ficha={ficha} locale={locale} />
</BaseLayout>
