---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameExtras from '../../../components/GameExtras.astro';
import { getGame } from '../../../lib/games';

const cms = await getGame('ninive');

const niniveAwards = cms?.awards?.length
  ? cms.awards
  : [
      {
        title: 'Juego oficial · Roll a Game Expo Chile 2025',
        image: '/assets/roll-a-game-logo.webp',
        href: 'https://rollagame.cl/',
      },
      {
        title: 'Juego Chileno del Año 2025 · Diluvio Lúdico',
        image: '/assets/diluvio-ludico-logo.webp',
        href: 'https://www.youtube.com/@DiluvioLudico',
      },
      {
        title: '2º lugar del jurado · 54-Card Game Design Contest 2024',
        image: '/assets/54-card-contest-logo.webp',
        href: 'https://boardgamegeek.com/thread/3327975/2024-54-card-game-design-contest',
      },
    ];
const bggId = cms?.bggId ?? 456259;
---

<BaseLayout
  title="Nínive — Estudio Alpargatas"
  description="Nínive, juego de cartas para dos jugadores diseñado por Estudio Alpargatas y publicado por Ludoísmo."
  current="ninive"
  bodyClass="ninive-page"
  footerSubtitle="Nínive · diseño de Arturo · Ludoísmo"
  footerVariant="ninive"
  themeColor="#5aa3c8"
>

<style is:global>
  /* ═══════════════════════════════════════════════════════════
     NÍNIVE · Palacio jardín · Cielo + Flor + Piedra
     ═══════════════════════════════════════════════════════════ */

  body.ninive-page {
    background-color: #f6efe4;
    color: #2a241c;
    font-family: Georgia, "Times New Roman", serif;
    background-image:
      linear-gradient(rgba(90, 163, 200, .07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(224, 112, 48, .04) 1px, transparent 1px);
    background-size: 48px 24px;
    --cielo:      #5aa3c8;
    --cielo-cl:   #8ec8e0;
    --cielo-deep: #2b6f96;
    --cielo-pale: #d6eef6;
    --flor:       #e07030;
    --jardin:     #6a9a58;
    --stone:      #f6efe4;
    --stone2:     #efe6d6;
    --ink:        #2a241c;
    --papel:      #fffdf8;
    --dim:        rgba(42, 36, 28, .58);
    --line:       rgba(43, 111, 150, .2);
  }

  body.ninive-page .site-header {
    background: rgba(246, 239, 228, .96);
    border-bottom: 2px solid var(--cielo);
  }
  body.ninive-page .brand b     { color: var(--cielo-deep); }
  body.ninive-page .brand small { color: rgba(43, 111, 150, .5); }
  body.ninive-page .nav-links a { color: rgba(42, 36, 28, .48); }
  body.ninive-page .nav-links a:hover,
  body.ninive-page .nav-links .active { color: var(--flor); }
  body.ninive-page .nav-links .nav-instagram {
    border-color: rgba(90, 163, 200, .45); color: var(--cielo-deep);
  }
  body.ninive-page .nav-links .nav-instagram:hover {
    background: var(--cielo); border-color: var(--cielo); color: #fff;
  }
  body.ninive-page .brand-logo {
    border-color: var(--cielo);
    box-shadow: 2px 2px 0 var(--flor);
  }

  body.ninive-page .site-footer {
    background: var(--cielo-deep);
    border-top: 2px solid var(--flor);
    color: rgba(255, 253, 248, .62);
  }
  body.ninive-page .site-footer b,
  body.ninive-page .site-footer a { color: #fffdf8; }
  body.ninive-page .site-footer a:hover { color: #ffd2a8; }

  body.ninive-page .ninive-hero {
    background: linear-gradient(175deg, #b7def0 0%, #e4f4fa 58%, #f6efe4 100%);
    border-bottom: 2px solid var(--cielo);
  }
  body.ninive-page .ninive-hero h1 {
    font-family: Georgia, serif;
    color: var(--cielo-deep);
    text-shadow: 2px 2px 0 rgba(224, 112, 48, .18);
  }
  body.ninive-page .ninive-hero p { color: var(--flor); font-style: italic; }
  body.ninive-page .breadcrumbs a,
  body.ninive-page .breadcrumbs span { color: rgba(43, 111, 150, .55); }
  body.ninive-page .breadcrumbs a:hover { color: var(--flor); }

  body.ninive-page .sticker.yellow {
    background: var(--flor);
    color: #fffdf8;
    border: 1.5px solid rgba(42, 36, 28, .08);
  }

  body.ninive-page .fact-chips span {
    border-color: rgba(43, 111, 150, .28);
    color: var(--cielo-deep);
  }
  body.ninive-page .fact-chips b { color: var(--ink); }

  body.ninive-page .ninive-hero-photo { box-shadow: 14px 14px 0 var(--cielo); }
  body.ninive-page .ninive-hero-photo img {
    border: 0;
    box-shadow: none;
    object-position: center 28%;
  }
  body.ninive-page figcaption { color: var(--dim); }

  body.ninive-page .ninive-intro { background: transparent; }
  body.ninive-page .ninive-intro h2 { color: var(--ink); }
  body.ninive-page .ninive-intro h2 em { color: var(--flor); }
  body.ninive-page .ninive-intro p { color: var(--dim); }

  body.ninive-page .section-label span {
    color: var(--flor);
    border-color: rgba(224, 112, 48, .35);
  }
  body.ninive-page .section-label b { color: var(--cielo-deep); }

  body.ninive-page .how-section {
    background: var(--papel);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  body.ninive-page .how-section h2 { color: var(--ink); }
  body.ninive-page .how-section p  { color: var(--dim); }
  body.ninive-page .rules-stack { border-top-color: var(--cielo); }
  body.ninive-page .rules-stack article span {
    color: var(--flor);
    border-color: var(--line);
  }
  body.ninive-page .rules-stack h3 { color: var(--ink); }
  body.ninive-page .rule-photo { box-shadow: 12px 12px 0 var(--flor); }

  body.ninive-page .decision-section {
    background: var(--cielo-pale);
    border-top: 2px solid var(--cielo);
    border-bottom: 2px solid var(--cielo);
  }
  body.ninive-page .decision-section .big-number {
    color: var(--flor);
    opacity: .28;
  }
  body.ninive-page .decision-section h2 { color: var(--cielo-deep); }
  body.ninive-page .decision-section p  { color: var(--dim); }

  body.ninive-page .journey-section {
    background: #e7f0d4;
    border-top: 1px solid rgba(106, 154, 88, .25);
  }
  body.ninive-page .journey-section h2 { color: var(--ink); }
  body.ninive-page .journey-cards { border-top-color: var(--jardin); }
  body.ninive-page .journey-cards article {
    border-color: rgba(106, 154, 88, .22);
    background: transparent;
  }
  body.ninive-page .journey-cards span { color: var(--flor); }
  body.ninive-page .journey-cards h3   { color: var(--ink); }
  body.ninive-page .journey-cards p    { color: var(--dim); }

  body.ninive-page .ninive-gallery { background: transparent; }
  body.ninive-page .ninive-gallery h2 { color: var(--ink); }
  body.ninive-page .ninive-gallery p  { color: var(--dim); }
  body.ninive-page .ninive-gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 1.3rem;
    align-items: start;
  }
  body.ninive-page .ninive-gallery-grid figure {
    margin: 0;
    padding: .7rem .7rem 2.4rem;
    background: var(--papel);
    box-shadow: 7px 7px 0 var(--cielo);
  }
  body.ninive-page .ninive-gallery-grid figure:nth-child(odd) { transform: rotate(-1.2deg); }
  body.ninive-page .ninive-gallery-grid figure:nth-child(even) { transform: rotate(1.4deg); }
  body.ninive-page .ninive-gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  body.ninive-page .ninive-gallery-grid figcaption {
    margin: .65rem .2rem 0;
    font-family: Georgia, serif;
    font-size: .82rem;
    font-style: italic;
  }

  body.ninive-page .back-to-table {
    background: transparent;
    border-top: 2px solid var(--cielo);
  }
  body.ninive-page .back-to-table span { color: var(--dim); }
  body.ninive-page .back-to-table a { color: var(--flor); font-style: italic; }
  body.ninive-page .back-to-table a:hover { color: var(--cielo-deep); }

  body.ninive-page .ninive-roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  body.ninive-page .ninive-role {
    padding: 1.2rem 1.3rem 1.3rem;
    border: 1px solid var(--line);
    background: var(--papel);
  }
  body.ninive-page .ninive-role span {
    display: block;
    margin-bottom: .45rem;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  body.ninive-page .ninive-role.flowers span { color: var(--flor); }
  body.ninive-page .ninive-role.fountains span { color: var(--cielo-deep); }
  body.ninive-page .ninive-role h3 {
    margin: 0 0 .4rem;
    color: var(--ink);
    font-size: 1.35rem;
  }
  body.ninive-page .ninive-role p {
    margin: 0;
    color: var(--dim);
    font-size: .95rem;
  }

  body.ninive-page .ninive-examples {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-top: 2.2rem;
  }
  body.ninive-page .ninive-ex {
    padding: 1.3rem 1.4rem 1.45rem;
    border-top: 2px solid var(--flor);
    background: var(--stone);
  }
  body.ninive-page .ninive-ex span {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--flor);
  }
  body.ninive-page .ninive-ex h3 {
    margin: .55rem 0 .5rem;
    color: var(--ink);
    font-size: 1.15rem;
  }
  body.ninive-page .ninive-ex p {
    margin: 0;
    color: var(--dim);
    font-size: .95rem;
  }

  body.ninive-page .ninive-modes-section {
    background: var(--stone2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  body.ninive-page .ninive-modes-section .shell-modes {
    width: min(1100px, calc(100% - 3rem));
    margin-inline: auto;
  }
  body.ninive-page .ninive-modes-section h2 { color: var(--ink); }
  body.ninive-page .ninive-modes-section > .shell-modes > p.lede {
    max-width: 40rem;
    margin: 1.2rem 0 2.5rem;
    color: var(--dim);
    font-size: 1.05rem;
  }
  body.ninive-page .ninive-modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  body.ninive-page .ninive-mode {
    padding: 1.6rem 1.6rem 1.8rem;
    border: 1px solid var(--line);
    background: var(--papel);
  }
  body.ninive-page .ninive-mode span {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--flor);
  }
  body.ninive-page .ninive-mode h3 {
    margin: .7rem 0 1rem;
    color: var(--ink);
    font-family: Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  body.ninive-page .ninive-mode ul {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--dim);
    font-size: .95rem;
  }
  body.ninive-page .ninive-mode li + li { margin-top: .55rem; }
  body.ninive-page .ninive-mode li::before {
    content: "— ";
    color: var(--jardin);
  }

  body.ninive-page .ninive-buy {
    margin-top: 2rem;
    color: var(--dim);
    font-size: .95rem;
  }
  body.ninive-page .ninive-buy a { color: var(--cielo-deep); }

  @media (max-width: 800px) {
    body.ninive-page .ninive-roles,
    body.ninive-page .ninive-examples,
    body.ninive-page .ninive-modes,
    body.ninive-page .ninive-gallery-grid { grid-template-columns: 1fr; }
  }
</style>
  <main>
    <article>
      <header class="ninive-hero">
        <div class="shell ninive-hero-grid">
          <div class="ninive-hero-copy">
            <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Juegos</a><span>/</span><span>Nínive</span></nav>
            <span class="sticker yellow">Publicado por Ludoísmo</span>
            <h1>Nínive</h1>
            <p>Construir juntos.<br />Ganar por separado.</p>
            <div class="fact-chips" aria-label="Ficha técnica"><span><b>2</b> jugadores</span><span><b>15′</b> duración</span><span><b>27</b> cartas</span></div>
            <GameExtras bggId={bggId} awards={niniveAwards} />
          </div>
          <figure class="ninive-hero-photo">
            <img src="/assets/ninive-caja.webp" alt="Caja de Nínive sobre un tapete de cartas" />
            <figcaption>La edición · Ludoísmo</figcaption>
            <i class="tape" aria-hidden="true"></i>
          </figure>
        </div>
      </header>

      <section class="ninive-intro shell">
        <div class="section-label"><span>01</span><b>La idea</b></div>
        <div>
          <h2>Un mismo palacio.<br /><em>Dos jardines.</em></h2>
          <div class="two-columns">
            <p>Hay quien dice que los Jardines Colgantes no estaban en Babilonia, sino en Nínive, capital del Imperio Asirio. En la mesa, dos jugadores levantan ese palacio jardín: una estructura compartida, llena de flores y fuentes.</p>
            <p>La tensión está en construir algo común mientras cada carta cambia lo que ambos podrán puntuar. A veces la mejor jugada para el palacio es una pésima jugada para ti.</p>
          </div>
          <div class="ninive-roles">
            <div class="ninive-role flowers">
              <span>Naranja</span>
              <h3>Flores</h3>
              <p>Puntúa los números naranjas que queden visibles. En la ilustración, tantas flores como el número de su lado.</p>
            </div>
            <div class="ninive-role fountains">
              <span>Azul</span>
              <h3>Fuentes</h3>
              <p>Puntúa los números azules que queden visibles. Tantos chorros de agua como el número de su lado.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="how-section">
        <div class="shell how-grid">
          <div class="how-copy">
            <div class="section-label"><span>02</span><b>Cómo se juega</b></div>
            <h2>Dos reglas para hacer crecer una ciudad.</h2>
            <div class="rules-stack">
              <article><span>1</span><div><h3>Extiende el suelo</h3><p>En el primer nivel siempre se juega a un extremo. Compara el número de afuera de ese extremo con el lado opuesto de tu carta: tiene que ser menor o igual. Naranja contra azul, nunca del mismo color.</p></div></article>
              <article><span>2</span><div><h3>Construye hacia arriba</h3><p>Una carta nueva cubre dos mitades vecinas: el azul de la carta izquierda y el naranja de la derecha. La suma de tu carta tiene que alcanzar o superar lo que tapas. No puede quedar colgando.</p></div></article>
              <article><span>3</span><div><h3>Cuenta lo que quedó visible</h3><p>Al terminar, cada uno suma su color a la vista. Lo tapado no vale. Si tuviste que descartar, esos números se restan.</p></div></article>
            </div>
            <div class="ninive-examples">
              <article class="ninive-ex">
                <span>Extremo · Andrea</span>
                <h3>Carta 4 naranja / 5 azul</h3>
                <p>Los extremos son 5 naranja y 3 azul. Entra a la izquierda (5≤5). No entra a la derecha (4>3).</p>
              </article>
              <article class="ninive-ex">
                <span>Piso superior · Felipe</span>
                <h3>Carta 4 / 4 (suma 8)</h3>
                <p>Cubre 5+2=7, sí. Cubre 3+1=4, sí. Cubre 5+4=9, no: la suma de abajo gana.</p>
              </article>
            </div>
          </div>
          <figure class="rule-photo">
            <img src="/assets/ninive-colocar.webp" alt="Una carta de Nínive colocándose sobre el palacio" loading="lazy" />
            <figcaption>Una carta cubre dos mitades.</figcaption>
          </figure>
        </div>
      </section>

      <section class="decision-section shell">
        <div class="big-number">25</div>
        <div><div class="section-label"><span>03</span><b>La tensión</b></div><h2>Veinticinco combinaciones. Ninguna jugada es solamente tuya.</h2><p>Hay una carta por cada cruce de 1 a 5: naranja a la izquierda, azul a la derecha, orientación fija. Cubrir un número propio puede abrir el siguiente piso, pero también te borra puntos. Conservarlo puede dejarle al rival el soporte que estaba esperando. La estructura pertenece a ambos; la victoria, no.</p></div>
      </section>

      <section class="ninive-modes-section" aria-labelledby="ninive-modes-title">
        <div class="shell-modes">
          <div class="section-label"><span>04</span><b>Dos maneras</b></div>
          <h2 id="ninive-modes-title">La misma ciudad, otro ritmo.</h2>
          <p class="lede">La colocación no cambia. Cambia cuántas cartas tienes en la mano y qué pasa cuando te atascas. La caja enseña el modo corto; el largo reparte todo el mazo de una.</p>
          <div class="ninive-modes">
            <article class="ninive-mode">
              <span>Básica · la caja</span>
              <h3>Cinco cartas y un mazo.</h3>
              <ul>
                <li>Se revelan las dos cartas de rol. Fuentes empieza.</li>
                <li>Cinco en mano, mazo al centro, una carta ya puesta como base.</li>
                <li>El suelo aguanta como máximo diez cartas.</li>
                <li>Si no puedes jugar, descartas. Al final restas tu color de esos descartes.</li>
                <li>Empate: gana quien descartó menos.</li>
              </ul>
            </article>
            <article class="ninive-mode">
              <span>Avanzada</span>
              <h3>Todo el mazo, de una.</h3>
              <ul>
                <li>Veinticinco de construcción más la carta de Agua: trece y trece.</li>
                <li>Quien saca el Agua es Fuentes y juega segundo. Flores planta la semilla.</li>
                <li>El suelo no tiene tope. No se roba.</li>
                <li>Si te atascas, descartas: restas naranja y azul de esa carta.</li>
                <li>Empate: otra vez, menos descartes.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="journey-section">
        <div class="shell">
          <div class="section-label"><span>05</span><b>El recorrido</b></div>
          <h2>Del cartón a otras mesas</h2>
          <div class="journey-cards">
            <article><span>PRIMERO</span><h3>La estructura fue el juego.</h3><p>Las cartas dejaron de ser solo una mano y empezaron a construir el espacio de la partida.</p></article>
            <article><span>DESPUÉS</span><h3>Las reglas se hicieron visibles.</h3><p>Valores, restricciones y ejemplos se ajustaron hasta poder entenderse mirando la mesa. Andrea a la izquierda, Felipe hacia arriba.</p></article>
            <article><span>AHORA</span><h3>Nínive está publicado.</h3><p>Ludoísmo lo editó para dos jugadores. Ya se juega en mesa.</p></article>
          </div>
        </div>
      </section>

      <section class="ninive-gallery shell">
        <div class="section-label"><span>06</span><b>Galería</b></div>
        <div class="gallery-heading"><h2>Así se ve<br />una partida.</h2><p>El resultado final no es solo un puntaje: es una pequeña construcción que registra cada decisión tomada. Aunque un número quede tapado, las flores y los chorros de la ilustración siguen delatando la carta.</p></div>
        <div class="ninive-gallery-grid">
          <figure>
            <img src="/assets/ninive-caja.webp" alt="Caja de Nínive sobre cartas del palacio" loading="lazy" />
            <figcaption>Caja · Ludoísmo</figcaption>
          </figure>
          <figure>
            <img src="/assets/ninive-partida.webp" alt="Palacio de Nínive armado sobre mantel rojo" loading="lazy" />
            <figcaption>Una partida, un palacio</figcaption>
          </figure>
          <figure>
            <img src="/assets/ninive-colocar.webp" alt="Colocando una carta sobre el palacio de Nínive" loading="lazy" />
            <figcaption>Construir hacia arriba</figcaption>
          </figure>
          <figure>
            <img src="/assets/ninive-mano.webp" alt="Mano con cuatro cartas de Nínive" loading="lazy" />
            <figcaption>Flores y fuentes en la mano</figcaption>
          </figure>
        </div>
        <p class="ninive-buy">Edición de <a href="https://ludoismo.cl/">Ludoísmo</a>. 2 jugadores · 15 minutos · 27 cartas.</p>
      </section>

      <nav class="back-to-table shell" aria-label="Volver a proyectos"><span>¿Seguimos mirando?</span><a href="/#juegos">Volver a todos los juegos →</a></nav>
    </article>
  </main>
</BaseLayout>
