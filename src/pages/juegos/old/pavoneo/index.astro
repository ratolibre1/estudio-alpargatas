---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../../../i18n/locale';
import { pavoneo as copy } from '../../../../i18n/fichas/pavoneo';

const locale = getLocale(Astro);
const t = copy[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  bodyClass="page-pavoneo"
  themeColor="#0a1a24"
>

<style is:global>
  /* ═══════════════════════════════════════════════════════
     PAVONEO · Plumas de pavo real · Azul profundo + Dorado
     ═══════════════════════════════════════════════════════ */
  body.page-pavoneo {
    background-color: #0a1a24;
    color: #94d2bd;
    font-family: "Helvetica Neue", Arial, sans-serif;
    background-image: none;
    --deep:    #0a1a24;
    --panel:   #0d2233;
    --teal:    #0a9396;
    --teal-cl: #94d2bd;
    --gold:    #e9c46a;
    --danger:  #9b2226;
    --dim:     rgba(148, 210, 189, .55);
    --line:    rgba(10, 147, 150, .2);
  }

  body.page-pavoneo .site-header { background: rgba(10, 26, 36, .97); border-bottom: 1px solid rgba(10, 147, 150, .35); }
  body.page-pavoneo .brand b     { color: var(--gold); }
  body.page-pavoneo .brand small { color: rgba(233,196,106,.4); }
  body.page-pavoneo .nav-links a { color: var(--dim); }
  body.page-pavoneo .nav-links a:hover { color: var(--teal); }
  body.page-pavoneo .nav-links .nav-instagram { border-color: rgba(10,147,150,.35); color: var(--teal); }
  body.page-pavoneo .nav-links .nav-instagram:hover { background: var(--teal); border-color: var(--teal); color: var(--deep); }
  body.page-pavoneo .brand-logo { border-color: var(--teal); box-shadow: 2px 2px 0 rgba(10,147,150,.4); }

  body.page-pavoneo .site-footer { background: var(--deep); border-top: 1px solid var(--line); color: var(--dim); }
  body.page-pavoneo .site-footer b, body.page-pavoneo .site-footer a { color: var(--gold); }
  body.page-pavoneo .site-footer a:hover { color: var(--teal); }

  .pv-shell { width: min(1100px, calc(100% - 3rem)); margin-inline: auto; }

  .pv-label {
    display: inline-flex; align-items: center; gap: .6rem;
    font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    color: var(--teal); margin-bottom: 1.2rem;
  }
  .pv-label::before { content: ""; display: block; width: 2rem; height: 1px; background: var(--teal); }

  .pv-breadcrumb {
    display: flex; gap: .5rem;
    font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--dim); margin-bottom: 2rem;
  }
  .pv-breadcrumb a { text-decoration: none; color: inherit; }
  .pv-breadcrumb a:hover { color: var(--teal); }

  /* HERO */
  .pv-hero {
    min-height: auto;
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(2.75rem, 5.5vw, 4.25rem) 0;
    background: var(--deep);
    border-bottom: 1px solid var(--line);
    position: relative; overflow: hidden;
  }
  /* Plumas decorativas: círculos concéntricos en esquina */
  .pv-hero::before {
    content: "";
    position: absolute;
    right: -10%;
    top: 50%;
    transform: translateY(-50%);
    width: 60vw; height: 60vw;
    border-radius: 50%;
    border: 1px solid rgba(10, 147, 150, .12);
    pointer-events: none;
  }
  .pv-hero::after {
    content: "";
    position: absolute;
    right: -5%;
    top: 50%;
    transform: translateY(-50%);
    width: 40vw; height: 40vw;
    border-radius: 50%;
    border: 1px solid rgba(10, 147, 150, .18);
    pointer-events: none;
  }
  .pv-hero-content { position: relative; z-index: 1; max-width: 42rem; }
  .pv-logo {
    display: block;
    width: min(22rem, 100%);
    height: auto;
    margin: 0 0 1.4rem;
  }
  .pv-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .pv-hero-title {
    font-size: clamp(3.6rem, 10vw, 6.8rem); font-weight: 900; letter-spacing: -.06em; line-height: .85;
    color: var(--gold);
    text-shadow: 2px 2px 0 rgba(10,147,150,.3), 4px 4px 0 rgba(10,147,150,.15);
    text-transform: uppercase; display: block; margin: 0 0 1.5rem;
  }
  .pv-hero-sub {
    font-size: clamp(.9rem, 1.8vw, 1.1rem); color: var(--teal-cl); line-height: 1.7;
    max-width: 35rem; margin: 0 0 2rem;
  }
  .pv-badges { display: flex; gap: .5rem; flex-wrap: wrap; }
  .pv-badge {
    display: inline-flex; padding: .3rem .7rem; border: 1px solid;
    font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  }
  .pv-badge.gold   { border-color: rgba(233,196,106,.5); color: var(--gold); }
  .pv-badge.teal   { border-color: rgba(10,147,150,.5);  color: var(--teal); }
  .pv-badge.danger { border-color: rgba(155,34,38,.5);    color: #e88080; }

  /* SECCIÓN 01 */
  .pv-concept {
    padding: clamp(2.75rem, 5.5vw, 4.75rem) 0;
    background: var(--panel);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .pv-concept-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem,8vw,6rem); align-items: start; }
  .pv-concept h2 { font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 900; letter-spacing: -.05em; line-height: .88; color: #e0f4f0; margin: 1rem 0 1.5rem; }
  .pv-concept h2 em { color: var(--gold); font-style: normal; }
  .pv-concept p { font-size: .93rem; line-height: 1.85; color: var(--dim); margin: 0 0 1rem; }

  /* Medidor de riesgo */
  .pv-risk-meter { margin-top: 1rem; }
  .pv-risk-row {
    display: grid; grid-template-columns: 6rem 1fr auto; gap: 1rem; align-items: center;
    padding: .7rem 0; border-bottom: 1px solid rgba(10, 147, 150, .1);
  }
  .pv-risk-row:first-child { border-top: 1px solid rgba(10, 147, 150, .1); }
  .pv-risk-label { font-size: .6rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }
  .pv-risk-bar { height: 4px; border-radius: 2px; background: rgba(10, 147, 150, .15); overflow: hidden; }
  .pv-risk-fill { height: 100%; border-radius: 2px; }
  .pv-risk-val { font-size: .75rem; font-weight: 700; color: var(--teal-cl); text-align: right; white-space: nowrap; }

  .pv-fan {
    margin: 0;
  }
  .pv-fan img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .pv-fan figcaption {
    margin-top: .7rem;
    font-size: .78rem;
    color: var(--dim);
    line-height: 1.5;
  }

  /* SECCIÓN 03: Estado */
  .pv-status {
    padding: clamp(2.75rem, 5.5vw, 4.75rem) 0;
    background: var(--deep);
    border-top: 1px solid var(--line);
  }
  .pv-status-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem,8vw,6rem); align-items: start; }
  .pv-status h2 { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 900; letter-spacing: -.05em; line-height: .88; color: #e0f4f0; margin: 1rem 0 1.5rem; }
  .pv-status h2 em { color: var(--gold); font-style: normal; }
  .pv-status p { font-size: .93rem; line-height: 1.85; color: var(--dim); margin: 0 0 1rem; }
  .pv-version {
    font-size: clamp(3.4rem, 8vw, 6rem); font-weight: 900; letter-spacing: -.1em; line-height: .8;
    color: var(--teal); margin-bottom: 1.5rem;
  }
  .pv-change-list { list-style: none; padding: 0; margin: 0; }
  .pv-change-list li {
    padding: .8rem 0; border-bottom: 1px solid var(--line);
    display: grid; grid-template-columns: 1rem 1fr; gap: .7rem;
    font-size: .88rem; color: var(--dim); align-items: start;
  }
  .pv-change-list li:first-child { border-top: 1px solid var(--line); }
  .pv-change-list li::before { content: "·"; color: var(--gold); font-size: 1.2rem; line-height: 1; }

  .pv-back {
    padding: 2.5rem 0; display: flex; justify-content: space-between; align-items: center; gap: 2rem;
    border-top: 1px solid var(--line); background: var(--deep);
  }
  .pv-back span { font-size: .78rem; color: var(--dim); }
  .pv-back a { font-size: clamp(1.4rem, 3vw, 2.5rem); font-weight: 900; letter-spacing: -.05em; text-decoration: none; color: var(--gold); }
  .pv-back a:hover { color: var(--teal); }

  @media (max-width: 980px) {
    .pv-concept-grid, .pv-status-grid { grid-template-columns: 1fr; }
    .pv-hero::before, .pv-hero::after { display: none; }
  }
  @media (max-width: 760px) {
    .pv-shell { width: min(1100px, calc(100% - 1.5rem)); }
  }
</style>

<main>
  <section class="pv-hero">
    <div class="pv-shell pv-hero-content">
      <nav class="pv-breadcrumb"><a href={localizePath('/', locale)}>{t.crumbHome}</a><span>/</span><span>{t.crumbHere}</span></nav>
      <img class="pv-logo" src={t.logoSrc} alt={t.logoAlt} />
      <h1 class="pv-visually-hidden">{t.displayName}</h1>
      <p class="pv-hero-sub">{t.heroSub}</p>
      <div class="pv-badges">
        <span class="pv-badge gold">{t.badgeProto}</span>
        <span class="pv-badge teal">{t.badgePlayers}</span>
        <span class="pv-badge danger">{t.badgeTime}</span>
        <span class="pv-badge gold">{t.badgeCards}</span>
      </div>
    </div>
  </section>

  <section class="pv-concept">
    <div class="pv-shell pv-concept-grid">
      <div>
        <span class="pv-label">{t.labelIdea}</span>
        <h2>{t.h2a}<br /><em>{t.h2em}</em><br />{t.h2b}</h2>
        <p>{t.p1}</p>
        <p>{t.p2}</p>
      </div>
      <div>
        <figure class="pv-fan">
          <img src="/assets/pavoneo-abanico.webp" alt={t.fanAlt} />
          <figcaption>{t.fanCap}</figcaption>
        </figure>
        <div class="pv-risk-meter" aria-label={t.riskAria}>
          {t.risks.map(r => (
            <div class="pv-risk-row">
              <div class="pv-risk-label">{r.label}</div>
              <div class="pv-risk-bar">
                <div class="pv-risk-fill" style={`width: ${r.fill}%; background: ${r.color};`}></div>
              </div>
              <div class="pv-risk-val" style={`color: ${r.color}`}>{r.pts}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pv-status">
    <div class="pv-shell pv-status-grid">
      <div>
        <span class="pv-label">{t.labelStatus}</span>
        <div class="pv-version" aria-hidden="true">{t.version}</div>
        <ul class="pv-change-list">
          <li>{t.change1}</li>
          <li>{t.change2}</li>
          <li>{t.change3}</li>
        </ul>
      </div>
      <div>
        <h2>{t.originA}<br />{t.originB}<br /><em>{t.originEm}</em></h2>
        <p>{t.originP1}</p>
        <p>{t.originP2}</p>
      </div>
    </div>
  </section>

  <nav class="pv-back pv-shell">
    <span>{t.backPrompt}</span>
    <a href={localizePath('/#juegos', locale)}>{t.backLink}</a>
  </nav>
</main>

</BaseLayout>
