---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../../../i18n/locale';
import { evoluciona as copy } from '../../../../i18n/fichas/evoluciona';
import { CAJA_FONTS_URL } from '../../../../lib/caja-fonts';

const locale = getLocale(Astro);
const t = copy[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  bodyClass="page-evoluciona"
  themeColor="#123456"
  fontUrl={CAJA_FONTS_URL}
>

<style is:global>
  body.page-evoluciona {
    background: #f3ece0;
    color: #1a120c;
    font-family: "Helvetica Neue", Arial, sans-serif;
    --noche: #123456;
    --tierra: #654321;
    --arena: #f3ece0;
    --papel: #faf6ee;
    --tinta: #1a120c;
    --dim: rgba(26, 18, 12, .55);
    --line: rgba(18, 52, 86, .16);
  }

  body.page-evoluciona .site-header {
    background: var(--noche);
    border-bottom: 2px solid #3d456f;
  }
  body.page-evoluciona .brand b { color: #f3ece0; }
  body.page-evoluciona .brand small { color: rgba(243, 236, 224, .4); }
  body.page-evoluciona .nav-links a { color: rgba(243, 236, 224, .55); }
  body.page-evoluciona .nav-links a:hover { color: #f3ece0; }
  body.page-evoluciona .nav-links .nav-instagram {
    border-color: rgba(243, 236, 224, .3);
    color: rgba(243, 236, 224, .65);
  }
  body.page-evoluciona .nav-links .nav-instagram:hover {
    background: #f3ece0;
    color: #123456;
    border-color: #f3ece0;
  }
  body.page-evoluciona .brand-logo {
    border-color: rgba(243, 236, 224, .35);
    box-shadow: 2px 2px 0 rgba(243, 236, 224, .15);
  }

  body.page-evoluciona .site-footer {
    background: var(--noche);
    border-top: 2px solid #563729;
    color: rgba(243, 236, 224, .45);
  }
  body.page-evoluciona .site-footer b,
  body.page-evoluciona .site-footer a { color: rgba(243, 236, 224, .7); }
  body.page-evoluciona .site-footer a:hover { color: #f3ece0; }
</style>

<style>
  .ev-shell { width: min(960px, calc(100% - 3rem)); margin-inline: auto; }

  .ev-label {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--tierra);
    margin-bottom: 1.2rem;
  }
  .ev-label::before {
    content: "";
    display: block;
    width: 1.5rem;
    height: 1px;
    background: var(--tierra);
  }

  .ev-crumb {
    display: flex;
    gap: .4rem;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 1.4rem;
  }
  .ev-crumb a { text-decoration: none; color: inherit; }
  .ev-crumb a:hover { color: var(--tierra); }

  .ev-hero {
    padding: clamp(2.5rem, 5.5vw, 4.25rem) 0 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .ev-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .ev-title {
    font-family: "Shantell Sans", sans-serif;
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: .9;
    color: var(--tierra);
    margin: 0 0 1rem;
  }
  .ev-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 1.1rem; }
  .ev-badge {
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: .35rem .7rem;
    border: 1.5px solid rgba(101, 67, 33, .35);
    color: var(--tierra);
  }
  .ev-badge.active {
    background: var(--noche);
    border-color: var(--noche);
    color: var(--arena);
  }
  .ev-hero-desc {
    font-family: "Shantell Sans", sans-serif;
    font-size: 1.02rem;
    font-style: italic;
    line-height: 1.55;
    color: #978567;
    max-width: 32rem;
    margin: 0 0 1.2rem;
  }
  .ev-chips { display: flex; gap: .4rem; flex-wrap: wrap; }
  .ev-chip {
    padding: .28rem .65rem;
    border: 1px solid var(--line);
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .ev-hero-photo {
    margin: 0;
    padding: .65rem .65rem 2.2rem;
    background: #fff;
    box-shadow: 10px 10px 0 rgba(18, 52, 86, .18);
    transform: rotate(-1deg);
  }
  .ev-hero-photo img { width: 100%; height: auto; display: block; }
  .ev-hero-photo figcaption {
    margin: .55rem .15rem 0;
    font-size: .8rem;
    font-style: italic;
    color: var(--dim);
  }

  .ev-concept {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    background: var(--noche);
    color: var(--arena);
  }
  .ev-concept .ev-label { color: #978567; }
  .ev-concept .ev-label::before { background: #978567; }
  .ev-concept-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }
  .ev-concept h2 {
    font-family: "Shantell Sans", sans-serif;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: .92;
    color: var(--arena);
    margin: 0 0 1.3rem;
  }
  .ev-concept h2 em { color: #c4a574; font-style: italic; }
  .ev-concept p {
    font-size: .93rem;
    line-height: 1.75;
    color: rgba(243, 236, 224, .62);
    margin: 0 0 1rem;
  }

  .ev-lists { display: grid; gap: 1.2rem; }
  .ev-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ev-list li {
    padding: .4rem .7rem;
    border: 1px solid rgba(243, 236, 224, .2);
    font-family: "Shantell Sans", sans-serif;
    font-size: .78rem;
    color: var(--arena);
  }
  .ev-list.wilds li {
    border-color: rgba(196, 165, 116, .45);
    color: #c4a574;
  }

  .ev-playtest {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    background: var(--papel);
    border-bottom: 1px solid var(--line);
  }
  .ev-playtest-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: end;
    margin-bottom: 2rem;
  }
  .ev-playtest h2 {
    font-family: "Shantell Sans", sans-serif;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: .92;
    color: var(--tinta);
    margin: 0;
  }
  .ev-playtest h2 em { color: var(--tierra); font-style: italic; }
  .ev-playtest p {
    margin: 0;
    font-size: .93rem;
    line-height: 1.75;
    color: var(--dim);
  }

  .ev-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }
  .ev-gallery-single { grid-template-columns: minmax(0, 36rem); }
  .ev-gallery figure {
    margin: 0;
    padding: .65rem .65rem 2.2rem;
    background: #fff;
    box-shadow: 8px 8px 0 rgba(18, 52, 86, .12);
    transform: rotate(1deg);
  }
  .ev-gallery img { width: 100%; height: auto; display: block; }
  .ev-gallery figcaption {
    margin: .55rem .15rem 0;
    font-size: .8rem;
    font-style: italic;
    color: var(--dim);
  }

  .ev-status {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    background: var(--arena);
  }
  .ev-status-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }
  .ev-version {
    font-family: "Shantell Sans", sans-serif;
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -.06em;
    line-height: .85;
    color: var(--tierra);
    margin-bottom: 1.2rem;
  }
  .ev-change-list { list-style: none; padding: 0; margin: 0; }
  .ev-change-list li {
    padding: .75rem 0;
    border-bottom: 1px solid var(--line);
    font-size: .88rem;
    color: var(--dim);
  }
  .ev-change-list li:first-child { border-top: 1px solid var(--line); }
  .ev-status h2 {
    font-family: "Shantell Sans", sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: .92;
    color: var(--tinta);
    margin: 0 0 1.2rem;
  }
  .ev-status h2 em { color: var(--tierra); font-style: italic; }
  .ev-status p {
    font-size: .93rem;
    line-height: 1.75;
    color: var(--dim);
    margin: 0 0 1rem;
  }

  .ev-back {
    padding: 2.2rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .ev-back span { font-size: .78rem; color: var(--dim); }
  .ev-back a {
    font-family: "Shantell Sans", sans-serif;
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -.03em;
    text-decoration: none;
    color: var(--tinta);
  }
  .ev-back a:hover { color: var(--tierra); }

  @media (max-width: 980px) {
    .ev-hero-grid,
    .ev-concept-grid,
    .ev-playtest-heading,
    .ev-status-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .ev-shell { width: min(960px, calc(100% - 1.5rem)); }
    .ev-gallery,
    .ev-gallery-single { grid-template-columns: 1fr; }
    .ev-hero-photo,
    .ev-gallery figure { transform: none; }
  }
  @media (max-width: 520px) {
    .ev-back { flex-direction: column; align-items: flex-start; }
  }
</style>

<main>
  <header class="ev-hero">
    <div class="ev-shell ev-hero-grid">
      <div>
        <nav class="ev-crumb">
          <a href={localizePath('/', locale)}>{t.crumbHome}</a><span>/</span>
          <a href={localizePath('/portafolio/', locale)}>{t.crumbPortfolio}</a><span>/</span>
          <span>{t.crumbHere}</span>
        </nav>
        <h1 class="ev-title">Evoluciona</h1>
        <div class="ev-badges">
          <span class="ev-badge active">{t.badgeState}</span>
          <span class="ev-badge">{t.badgeMeta}</span>
        </div>
        <p class="ev-hero-desc">{t.heroDesc}</p>
        <div class="ev-chips">
          <span class="ev-chip">{t.chipPlayers}</span>
          <span class="ev-chip">{t.chipTime}</span>
          <span class="ev-chip">{t.chipOrigin}</span>
        </div>
      </div>
      <figure class="ev-hero-photo">
        <img src="/assets/evoluciona-pista.webp" alt={t.heroAlt} />
        <figcaption>{t.heroCap}</figcaption>
      </figure>
    </div>
  </header>

  <section class="ev-concept">
    <div class="ev-shell ev-concept-grid">
      <div>
        <div class="ev-label">{t.labelIdea}</div>
        <h2>{t.h2a}<br /><em>{t.h2em}</em></h2>
        <p>{t.p1}</p>
        <p>{t.p2}</p>
      </div>
      <div class="ev-lists">
        <ul class="ev-list">
          {t.species.map((name) => <li>{name}</li>)}
        </ul>
        <ul class="ev-list wilds">
          {t.wilds.map((name) => <li>{name}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="ev-playtest">
    <div class="ev-shell">
      <div class="ev-playtest-heading">
        <div>
          <div class="ev-label">{t.labelPlaytest}</div>
          <h2>{t.playH2a}<br /><em>{t.playH2em}</em></h2>
        </div>
        <p>{t.playP1}</p>
      </div>
      <div class="ev-gallery ev-gallery-single">
        <figure>
          <img src="/assets/evoluciona-playtest.webp" alt={t.playAlt} loading="lazy" />
          <figcaption>{t.playCap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="ev-status">
    <div class="ev-shell ev-status-grid">
      <div>
        <div class="ev-label">{t.labelStatus}</div>
        <div class="ev-version" aria-hidden="true">{t.version}</div>
        <ul class="ev-change-list">
          <li>{t.change1}</li>
          <li>{t.change2}</li>
          <li>{t.change3}</li>
        </ul>
      </div>
      <div>
        <h2>{t.statusH2a}<br /><em>{t.statusH2em}</em><br />{t.statusH2b}</h2>
        <p>{t.statusP1}</p>
        <p>{t.statusP2}</p>
      </div>
    </div>
    <nav class="ev-shell ev-back">
      <span>{t.backPrompt}</span>
      <a href={localizePath('/portafolio/', locale)}>{t.backLink}</a>
    </nav>
  </section>
</main>

</BaseLayout>
