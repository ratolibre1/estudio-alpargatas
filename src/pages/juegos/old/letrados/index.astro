---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import GameExtras from '../../../../components/GameExtras.astro';
import { getGame, localizeGame } from '../../../../lib/games';
import { getLocale, localizePath } from '../../../../i18n/locale';
import { letrados as copy } from '../../../../i18n/fichas/letrados';

const locale = getLocale(Astro);
const t = copy[locale];
const cms = await getGame('letrados');
const game = cms ? localizeGame(cms, locale) : undefined;

const ejemplos = [
  { cover: 'N', top: 'T', score: '+3', note: t.noteGreen },
  { cover: 'A', top: 'N', score: '+10', note: t.noteBlue },
  { cover: 'B', top: 'Q', score: '−7', note: t.noteRed },
  { cover: 'D', top: 'A', score: '−2', note: t.noteRed },
];

---

<BaseLayout
  title={t.title}
  description={t.description}
  bodyClass="page-letrados"
  themeColor="#8ec4e8"
  fontUrl="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,700;0,800;1,400&family=Patrick+Hand&display=swap"
>

<style is:global>
  body.page-letrados {
    background: #eaf4fb;
    color: #1f2626;
    font-family: Nunito, "Helvetica Neue", Arial, sans-serif;
    --papel:    #eaf4fb;
    --hoja:     #fffdf8;
    --tinta:    #1f2626;
    --pizarra:  #24332a;
    --cielo:    #8ec4e8;
    --chaleco:  #2d7eb0;
    --oro:      #d4a84b;
    --rojo:     #c0393a;
    --verde:    #2d6a4f;
    --azul:     #2d7eb0;
    --tiza:     #f7f3ea;
    --dim:      rgba(31, 38, 38, .55);
    --line:     rgba(45, 126, 176, .2);
    --display:  "Patrick Hand", "Segoe Print", cursive;
  }

  body.page-letrados .site-header   { background: var(--pizarra); border-bottom: 3px solid var(--oro); }
  body.page-letrados .brand b       { color: var(--tiza); }
  body.page-letrados .brand small   { color: rgba(247,243,234,.45); }
  body.page-letrados .nav-links a   { color: rgba(247,243,234,.62); }
  body.page-letrados .nav-links a:hover { color: var(--oro); }
  body.page-letrados .nav-links .nav-instagram { border-color: rgba(212,168,75,.45); color: var(--oro); }
  body.page-letrados .nav-links .nav-instagram:hover { background: var(--oro); border-color: var(--oro); color: var(--pizarra); }
  body.page-letrados .brand-logo    { border-color: rgba(247,243,234,.3); box-shadow: 2px 2px 0 rgba(212,168,75,.35); }

  body.page-letrados .site-footer   { background: var(--pizarra); border-top: 3px solid rgba(212,168,75,.45); color: rgba(247,243,234,.45); }
  body.page-letrados .site-footer b,
  body.page-letrados .site-footer a { color: rgba(247,243,234,.7); }
  body.page-letrados .site-footer a:hover { color: var(--oro); }
</style>

<style>
  .lt-shell { width: min(1050px, calc(100% - 3rem)); margin-inline: auto; }

  .lt-label {
    display: inline-flex; align-items: center; gap: .6rem;
    font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    color: var(--chaleco); margin-bottom: 1.2rem;
  }
  .lt-label::before { content: ""; display: block; width: 1.5rem; height: 1px; background: var(--oro); }

  .lt-breadcrumb {
    display: flex; gap: .4rem;
    font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--dim); margin-bottom: 2rem;
  }
  .lt-breadcrumb a { text-decoration: none; color: inherit; }
  .lt-breadcrumb a:hover { color: var(--tinta); }

  .lt-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem,6vw,5rem); align-items: start; }

  .lt-hero {
    padding: clamp(2.5rem, 5.5vw, 4.25rem) 0;
    border-bottom: 1px solid var(--line);
    background: var(--papel);
  }
  .lt-hero-logo {
    display: block;
    width: min(16rem, 80%);
    margin: 0 0 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .lt-hero-title {
    font-size: clamp(3.4rem, 9vw, 6.2rem);
    font-weight: 400;
    letter-spacing: .01em;
    line-height: .85;
    color: var(--pizarra);
    font-family: var(--display);
    display: block;
    margin: .5rem 0 1.2rem;
  }
  .lt-hero-title em { color: var(--chaleco); font-style: normal; }
  .lt-hero-sub { font-size: .95rem; line-height: 1.8; color: var(--dim); max-width: 28rem; margin: 0 0 1.5rem; }
  .lt-badges { display: flex; gap: .5rem; flex-wrap: wrap; }
  .lt-badge {
    display: inline-flex; padding: .3rem .7rem;
    border: 1.5px solid rgba(26,26,26,.25);
    font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--dim);
  }
  .lt-badge.active { background: var(--pizarra); border-color: var(--pizarra); color: var(--tiza); }
  .lt-badge.red    { border-color: rgba(192,57,58,.4); color: var(--rojo); }

  .lt-hero-photo { margin: 0; }
  .lt-hero-photo img {
    width: 100%;
    display: block;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--cielo);
  }
  .lt-hero-photo figcaption {
    margin-top: .6rem;
    font-size: .72rem;
    color: var(--dim);
  }

  .lt-section {
    padding: clamp(2.5rem, 5.5vw, 4.25rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .lt-section.alt { background: var(--hoja); border-top: 1px solid var(--line); }
  .lt-section h2 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 400; letter-spacing: .01em; line-height: .95;
    color: var(--pizarra); margin: .8rem 0 1.2rem;
  }
  .lt-section h2 em { color: var(--chaleco); font-style: normal; }
  .lt-section p { font-size: .9rem; line-height: 1.85; color: var(--dim); margin: 0 0 .9rem; }

  .lt-bands {
    display: grid;
    gap: .7rem;
  }
  .lt-band {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--hoja);
    border-radius: 10px;
    border-left: 6px solid var(--band);
  }
  .lt-band span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--band);
    margin-bottom: .35rem;
  }
  .lt-band b { display: block; margin-bottom: .25rem; }
  .lt-band p { margin: 0; font-size: .85rem; }

  .lt-card-row {
    display: grid;
    grid-template-columns: 1.6fr minmax(12rem, .7fr);
    gap: 1.2rem;
    margin-top: 2.4rem;
    align-items: start;
  }
  .lt-card-row figure { margin: 0; }
  .lt-card-row img {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    display: block;
  }
  .lt-card-row figcaption {
    margin-top: .55rem;
    font-size: .72rem;
    color: var(--dim);
  }

  .lt-rules { list-style: none; padding: 0; margin: 0; }
  .lt-rule {
    display: grid; grid-template-columns: 2.5rem 1fr; gap: .8rem; align-items: start;
    padding: .9rem 0; border-bottom: 1px solid var(--line);
  }
  .lt-rule:first-child { border-top: 1px solid var(--line); }
  .lt-rule-num {
    font-family: var(--display); font-size: 1.8rem; font-weight: 400;
    color: var(--chaleco); line-height: 1.1; text-align: center;
  }
  .lt-rule-title { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--tinta); margin-bottom: .2rem; }
  .lt-rule-desc { font-size: .82rem; line-height: 1.65; color: var(--dim); margin: 0; }

  .lt-roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .8rem;
    margin-top: 1.4rem;
  }
  .lt-role {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--hoja);
    border-radius: 10px;
  }
  .lt-role span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--chaleco);
    margin-bottom: .4rem;
  }
  .lt-role b { display: block; font-family: var(--display); font-size: 1.45rem; font-weight: 400; margin-bottom: .35rem; }
  .lt-role p { margin: 0; font-size: .82rem; }

  .lt-pairs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .lt-pair {
    display: grid; grid-template-columns: auto 1fr auto; gap: .6rem; align-items: center;
    padding: .7rem .9rem;
    border: 1px solid var(--line); background: var(--hoja);
    border-radius: 10px;
  }
  .lt-pair-letter {
    width: 2.2rem; height: 2.2rem;
    display: flex; align-items: center; justify-content: center;
    background: var(--pizarra); color: var(--tiza);
    font-family: var(--display); font-size: 1.35rem; font-weight: 400;
  }
  .lt-pair-arrow { font-size: .68rem; color: var(--dim); }
  .lt-pair-score { text-align: right; }
  .lt-pair-score strong { font-size: 1.5rem; font-weight: 900; display: block; line-height: 1; }
  .lt-pair-score strong.pos { color: var(--verde); }
  .lt-pair-score strong.big { color: var(--oro); }
  .lt-pair-score strong.neg { color: var(--rojo); }
  .lt-pair-score span { font-size: .55rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }

  .lt-example {
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--line);
    background: var(--hoja);
    border-radius: 10px;
  }
  .lt-example span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--chaleco);
    margin-bottom: .5rem;
  }
  .lt-example p { margin: 0 0 .7rem; font-size: .88rem; }
  .lt-example p:last-child { margin: 0; }
  .lt-ejemplo-board { margin: 2rem 0 0; }
  .lt-ejemplo-board img {
    width: 100%;
    display: block;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #c4a36a;
  }
  .lt-ejemplo-board figcaption {
    margin-top: .6rem;
    font-size: .72rem;
    color: var(--dim);
  }

  .lt-links {
    display: flex; flex-wrap: wrap; gap: .6rem .9rem;
    margin: 0 0 1.6rem;
  }
  .lt-links a {
    display: inline-flex; padding: .35rem .75rem;
    border: 1.5px solid rgba(26,26,26,.25);
    font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; color: var(--tinta);
  }
  .lt-links a:hover { background: var(--pizarra); color: var(--tiza); border-color: var(--pizarra); }

  .lt-lh-head {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr;
    gap: 1.6rem 2rem;
    align-items: center;
    margin-bottom: 1.4rem;
  }
  .lt-lh-logo { display: block; text-decoration: none; }
  .lt-lh-logo img { width: 100%; height: auto; display: block; }
  .lt-lh-head .lt-label { margin-bottom: .7rem; }
  .lt-lh-head h2 { margin: 0; }

  .lt-lh-banner { margin: 0 0 1.2rem; }
  .lt-lh-banner img { width: 100%; display: block; border: 1px solid var(--line); border-radius: 14px; background: var(--cielo); }

  .lt-proto { margin: 0; }
  .lt-proto img {
    width: 100%;
    max-height: 22rem;
    object-fit: contain;
    object-position: top center;
    display: block;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--cielo);
  }
  .lt-proto figcaption {
    margin-top: .55rem;
    font-size: .72rem;
    color: var(--dim);
  }

  .lt-back {
    padding: 2.5rem 0;
    display: flex; justify-content: space-between; align-items: center; gap: 2rem;
  }
  .lt-back span { font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }
  .lt-back a { font-family: var(--display); font-size: clamp(1.4rem, 3vw, 2.3rem); font-weight: 400; letter-spacing: .01em; text-decoration: none; color: var(--pizarra); }
  .lt-back a:hover { color: var(--chaleco); }

  @media (max-width: 980px) {
    .lt-cols,
    .lt-pairs,
    .lt-roles,
    .lt-card-row,
    .lt-lh-head { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .lt-shell { width: min(1050px, calc(100% - 1.5rem)); }
  }
</style>

<main>
  <section class="lt-hero">
    <div class="lt-shell lt-cols">
      <div>
        <nav class="lt-breadcrumb"><a href={localizePath('/', locale)}>{t.crumbHome}</a><span>/</span><span>{t.crumbHere}</span></nav>
        <img class="lt-hero-logo" src="/assets/letrados-logo-proto.webp" alt={t.logoProtoAlt} />
        <h1 class="lt-hero-title" set:html={t.heroTitle} />
        <p class="lt-hero-sub">{t.heroSub}</p>
        <div class="lt-badges">
          <span class="lt-badge active">{t.badgeAdvanced}</span>
          <span class="lt-badge red">{t.badgePlayers}</span>
          <span class="lt-badge">{t.badgeTime}</span>
          <span class="lt-badge">{t.badgeCards}</span>
          <span class="lt-badge">{t.badgeTower}</span>
        </div>
        {game && <GameExtras bggId={game.bggId} awards={game.awards} />}
      </div>
      <figure class="lt-hero-photo">
        <img src="/assets/letrados-portada.webp" alt={t.heroAlt} />
        <figcaption>{t.heroCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="lt-section alt">
    <div class="lt-shell lt-cols">
      <div>
        <span class="lt-label">{t.s01}</span>
        <h2 set:html={t.ideaH2} />
        <p>{t.ideaP1}</p>
        <p>{t.ideaP2}</p>
        <p>{t.ideaP3}</p>
      </div>
      <div class="lt-bands">
        <article class="lt-band" style="--band: var(--verde)">
          <span>{t.band1Tag}</span>
          <b>+1 a +7</b>
          <p>{t.band1Body}</p>
        </article>
        <article class="lt-band" style="--band: var(--azul)">
          <span>{t.band2Tag}</span>
          <b>+10</b>
          <p>{t.band2Body}</p>
        </article>
        <article class="lt-band" style="--band: var(--rojo)">
          <span>{t.band3Tag}</span>
          <b>−1 a −7</b>
          <p>{t.band3Body}</p>
        </article>
      </div>
    </div>
    <div class="lt-shell">
      <div class="lt-card-row">
        <figure>
          <img src="/assets/letrados-carta-editorial.webp" alt={t.cardEdAlt} />
          <figcaption>{t.cardEdCap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/letrados-carta-a.webp" alt={t.cardProtoAlt} />
          <figcaption>{t.cardProtoCap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="lt-section">
    <div class="lt-shell lt-cols">
      <div>
        <span class="lt-label">{t.s02}</span>
        <h2 set:html={t.turnH2} />
        <p>{t.turnP}</p>
        <div class="lt-roles">
          <article class="lt-role">
            <span>{t.role1Tag}</span>
            <b>{t.role1Title}</b>
            <p>{t.role1Body}</p>
          </article>
          <article class="lt-role">
            <span>{t.role2Tag}</span>
            <b>{t.role2Title}</b>
            <p>{t.role2Body}</p>
          </article>
        </div>
      </div>
      <ul class="lt-rules">
        <li class="lt-rule">
          <div class="lt-rule-num">1</div>
          <div>
            <div class="lt-rule-title">{t.rule1Title}</div>
            <p class="lt-rule-desc">{t.rule1Body}</p>
          </div>
        </li>
        <li class="lt-rule">
          <div class="lt-rule-num">2</div>
          <div>
            <div class="lt-rule-title">{t.rule2Title}</div>
            <p class="lt-rule-desc">{t.rule2Body}</p>
          </div>
        </li>
        <li class="lt-rule">
          <div class="lt-rule-num">3</div>
          <div>
            <div class="lt-rule-title">{t.rule3Title}</div>
            <p class="lt-rule-desc">{t.rule3Body}</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="lt-section alt">
    <div class="lt-shell lt-cols">
      <div>
        <span class="lt-label">{t.s03}</span>
        <h2 set:html={t.closeH2} />
        <p>{t.closeP1}</p>
        <p>{t.closeP2}</p>
        <div class="lt-example">
          <span>{t.exampleTag}</span>
          <p>{t.exampleP1}</p>
          <p>{t.exampleP2}</p>
        </div>
      </div>
      <div class="lt-pairs" aria-label={t.pairsAria}>
        {ejemplos.map((e) => (
          <div class="lt-pair">
            <div class="lt-pair-letter">{e.top}</div>
            <div class="lt-pair-arrow">{t.over} {e.cover}</div>
            <div class="lt-pair-score">
              <strong class={e.score.startsWith('+10') ? 'big' : e.score.startsWith('−') ? 'neg' : 'pos'}>{e.score}</strong>
              <span>{e.note}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="lt-shell">
      <figure class="lt-ejemplo-board">
        <img src="/assets/letrados-ejemplo-torres.webp" alt={t.exampleImgAlt} />
        <figcaption>{t.exampleImgCap}</figcaption>
      </figure>
    </div>
  </section>

  <section class="lt-section">
    <div class="lt-shell">
      <div class="lt-lh-head">
        <a class="lt-lh-logo" href="https://www.lighthousegms.com/es" target="_blank" rel="noopener noreferrer">
          <img src="/assets/lighthouse-games-logo.webp" alt={t.lhAlt} />
        </a>
        <div>
          <span class="lt-label">{t.s04}</span>
          <h2 set:html={t.pubH2} />
        </div>
      </div>
      <p>{t.pubP}</p>
      <div class="lt-links">
        <a href="https://www.lighthousegms.com/es" target="_blank" rel="noopener noreferrer">{t.linkLh}</a>
        <a href="https://www.lighthousegms.com/meunoalfaro" target="_blank" rel="noopener noreferrer">{t.linkFaro}</a>
      </div>
      <figure class="lt-lh-banner">
        <img src="/assets/letrados-lighthouse-banner.webp" alt={t.bannerAlt} />
      </figure>
      <figure class="lt-proto">
        <img src="/assets/letrados-proto.webp" alt={t.protoAlt} />
        <figcaption>{t.protoCap}</figcaption>
      </figure>
    </div>
  </section>

  <nav class="lt-back lt-shell">
    <span>{t.backPrompt}</span>
    <a href={localizePath('/portafolio/', locale)}>{t.backLink}</a>
  </nav>
</main>

</BaseLayout>
