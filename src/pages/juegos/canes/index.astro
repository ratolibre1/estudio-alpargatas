---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../../i18n/locale';
import { canes as copy } from '../../../i18n/fichas/canes';

const locale = getLocale(Astro);
const t = copy[locale];

const disciplinas = [
  { key: 'caza', name: t.discCaza, color: '#b83020', simple: t.discCazaSimple, avanzada: t.discCazaAdv },
  { key: 'agilidad', name: t.discAgilidad, color: '#b88010', simple: t.discAgilidadSimple, avanzada: t.discAgilidadAdv },
  { key: 'rastreo', name: t.discRastreo, color: '#3a7a3a', simple: t.discRastreoSimple, avanzada: t.discRastreoAdv },
  { key: 'estilo', name: t.discEstilo, color: '#1a3a7a', simple: t.discEstiloSimple, avanzada: t.discEstiloAdv },
  { key: 'obediencia', name: t.discObediencia, color: '#6b3fa0', simple: t.discObedienciaSimple, avanzada: t.discObedienciaAdv },
];
---

<BaseLayout
  title={t.title}
  description={t.description}
  bodyClass="page-canes"
  footerSubtitle={t.footer}
  themeColor="#e8f2e0"
>

<style is:global>
  body.page-canes {
    background-color: #e8f2e0;
    color: #2d4a1a;
    font-family: Nunito, "Helvetica Neue", Arial, sans-serif;
    background-image: radial-gradient(circle at 2px 2px, rgba(74, 32, 112, .08) 1.5px, transparent 0);
    background-size: 28px 28px;
    --cream:   #e8f2e0;
    --purple:  #4a2070;
    --gold:    #d4a017;
    --brown:   #2d4a1a;
    --muted:   rgba(45, 74, 26, .62);
    --line:    rgba(74, 32, 112, .16);
    --white:   #fffdf6;
  }

  body.page-canes .site-header {
    background: #2d1545;
    border-bottom: 4px solid #d4a017;
  }
  body.page-canes .brand b      { color: #d4a017; }
  body.page-canes .brand small  { color: rgba(212, 160, 23, .55); }
  body.page-canes .nav-links a  { color: rgba(253, 245, 220, .7); }
  body.page-canes .nav-links a:hover { color: #d4a017; }
  body.page-canes .nav-links .nav-instagram {
    border-color: rgba(212, 160, 23, .45); color: #d4a017;
  }
  body.page-canes .nav-links .nav-instagram:hover {
    background: #d4a017; border-color: #d4a017; color: #2d1545;
  }
  body.page-canes .brand-logo {
    border-color: #d4a017; box-shadow: 2px 2px 0 #d4a017;
  }

  body.page-canes .site-footer {
    background: #2d1545;
    border-top: 4px solid #d4a017;
    color: rgba(253, 245, 220, .6);
  }
  body.page-canes .site-footer b,
  body.page-canes .site-footer a { color: #d4a017; }
  body.page-canes .site-footer a:hover { color: #fdf5dc; }

  .ca-shell { width: min(1140px, calc(100% - 3rem)); margin-inline: auto; }

  .ca-label {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .3rem .9rem;
    background: var(--purple);
    color: #fff;
    border-radius: 999px;
    font-size: .63rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .ca-breadcrumb {
    display: flex;
    gap: .5rem;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.6rem;
  }
  .ca-breadcrumb a { text-decoration: none; color: inherit; }
  .ca-breadcrumb a:hover { color: var(--purple); }

  .ca-hero {
    padding: clamp(2.5rem, 5.5vw, 4.5rem) 0 2.5rem;
  }
  .ca-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .ca-hero-logo {
    display: block;
    width: min(22rem, 100%);
    margin: 0 0 1.2rem;
  }
  .ca-hero h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .ca-hero-tag {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    color: var(--purple);
    margin: 0 0 1rem;
  }
  .ca-hero p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--muted);
    max-width: 34rem;
    margin: 0 0 1.4rem;
  }
  .ca-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .ca-chip {
    padding: .35rem .7rem;
    border: 1.5px solid var(--purple);
    border-radius: 999px;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .06em;
    color: var(--purple);
    background: var(--white);
  }
  .ca-chip.gold {
    border-color: var(--gold);
    color: #8a6a0c;
  }
  .ca-hero-ill {
    margin: 0;
  }
  .ca-hero-ill img {
    width: 100%;
    border-radius: 18px;
    background: #f4eefc;
    border: 3px solid var(--purple);
    box-shadow: 6px 6px 0 var(--gold);
  }

  .ca-section { padding: clamp(2.75rem, 5.5vw, 4.75rem) 0; }
  .ca-section.alt { background: #dcecc8; }
  .ca-section h2 {
    font-family: Georgia, serif;
    font-weight: 700;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    letter-spacing: -.03em;
    line-height: 1.05;
    color: var(--purple);
    margin: 0 0 1.2rem;
  }
  .ca-section h2 em { font-style: italic; color: #2d1545; }
  .ca-section p {
    font-size: .95rem;
    line-height: 1.75;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .ca-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .ca-cards {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem 1.2rem;
    margin-top: 2rem;
    align-items: start;
  }
  .ca-cards figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .ca-cards-art {
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .ca-cards-art img {
    max-width: 92%;
    max-height: 86%;
    width: auto;
    height: auto;
    object-fit: contain;
    background: transparent;
  }
  .ca-cards figcaption {
    margin-top: .65rem;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ca-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .ca-steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: .9rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .ca-steps b { color: var(--purple); font-size: 1.05rem; }
  .ca-n {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--gold);
  }

  .ca-set {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.2rem;
    background: var(--white);
    border: 2px solid var(--line);
    border-radius: 12px;
  }
  .ca-set img { width: 100%; object-fit: contain; }
  .ca-set p { margin: 0; font-size: .85rem; }
  .ca-tokens {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    font-size: .78rem;
    font-weight: 700;
    color: var(--brown);
  }
  .ca-tokens span { display: inline-flex; align-items: center; gap: .35rem; }
  .ca-tokens img { width: 1.5rem; height: 1.5rem; }

  .ca-disc {
    display: grid;
    gap: 1rem;
  }
  .ca-disc article {
    display: grid;
    grid-template-columns: 3.6rem 1fr;
    gap: 1.1rem;
    padding: 1rem 1.1rem;
    background: var(--white);
    border-radius: 10px;
    border-left: 6px solid var(--disc);
    align-items: center;
  }
  .ca-disc-icon {
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
  }
  .ca-disc-icon img {
    width: 72%;
    height: 72%;
    object-fit: contain;
    border-radius: 22%;
    transform: rotate(45deg);
  }
  .ca-disc h3 {
    margin: 0 0 .35rem;
    font-size: 1.05rem;
    color: var(--disc);
  }
  .ca-disc p { margin: 0 0 .4rem; font-size: .86rem; }
  .ca-disc p:last-child { margin-bottom: 0; }

  .ca-score {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .8rem;
  }
  .ca-score article {
    padding: 1.15rem 1.2rem;
    background: var(--white);
    border: 2px solid var(--line);
    border-radius: 12px;
  }
  .ca-score span {
    display: block;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: .45rem;
  }
  .ca-score b {
    display: block;
    color: var(--purple);
    margin-bottom: .45rem;
  }
  .ca-score p { margin: 0; font-size: .82rem; }

  .ca-rounds {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    border-radius: 10px;
    overflow: hidden;
  }
  .ca-rounds th,
  .ca-rounds td {
    padding: .7rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    font-size: .88rem;
  }
  .ca-rounds th {
    background: var(--purple);
    color: #fff;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .ca-gallery-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 1rem;
  }
  .ca-gallery-grid figure {
    margin: 0;
    background: var(--white);
    border: 3px solid var(--purple);
    box-shadow: 4px 4px 0 var(--gold);
  }
  .ca-gallery-grid figure:first-child { grid-row: span 2; }
  .ca-gallery-grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .ca-gallery-grid figure:first-child img { aspect-ratio: 3 / 4; height: 100%; }
  .ca-gallery-grid figcaption {
    padding: .65rem .8rem .75rem;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: .82rem;
    color: var(--muted);
  }

  .ca-back {
    padding: 2.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    border-top: 3px solid var(--gold);
  }
  .ca-back span { font-size: .78rem; color: var(--muted); font-weight: 700; }
  .ca-back a {
    font-weight: 900;
    font-size: clamp(1.3rem, 3vw, 2.3rem);
    letter-spacing: -.04em;
    text-decoration: none;
    color: var(--purple);
  }
  .ca-back a:hover { color: #2d1545; }

  @media (max-width: 980px) {
    .ca-hero-grid,
    .ca-split,
    .ca-score,
    .ca-gallery-grid { grid-template-columns: 1fr; }
    .ca-gallery-grid figure:first-child { grid-row: auto; }
    .ca-gallery-grid figure:first-child img { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 760px) {
    .ca-shell { width: min(1140px, calc(100% - 1.5rem)); }
  }
  @media (max-width: 520px) {
    .ca-cards { grid-template-columns: 1fr 1fr; }
  }
</style>

<main>
  <section class="ca-hero">
    <div class="ca-shell ca-hero-grid">
      <div>
        <nav class="ca-breadcrumb" aria-label={t.navAria}>
          <a href={localizePath('/', locale)}>{t.crumbHome}</a><span>/</span><span>{t.crumbHere}</span>
        </nav>
        <img class="ca-hero-logo" src="/assets/canes-logo.webp" alt={t.logoAlt} />
        <h1>{t.crumbHere}</h1>
        <p class="ca-hero-tag">{t.heroTag}</p>
        <p>{t.heroP}</p>
        <div class="ca-chips">
          <span class="ca-chip">{t.chipPlayers}</span>
          <span class="ca-chip">{t.chipTime}</span>
          <span class="ca-chip">{t.chipAge}</span>
          <span class="ca-chip">{t.chipDisc}</span>
          <span class="ca-chip gold">{t.chipProto}</span>
        </div>
      </div>
      <figure class="ca-hero-ill">
        <img src="/assets/canes-hero.webp" alt={t.heroIllAlt} />
      </figure>
    </div>
  </section>

  <section class="ca-section alt">
    <div class="ca-shell">
      <span class="ca-label">{t.ideaLabel}</span>
      <h2 set:html={t.ideaH2} />
      <p>{t.ideaP1}</p>
      <p>{t.ideaP2}</p>
      <div class="ca-cards">
        {disciplinas.map((d) => (
          <figure>
            <span class="ca-cards-art">
              <img src={`/assets/canes-perro-${d.key}.webp`} alt={d.name} />
            </span>
            <figcaption style={`color:${d.color}`}>{d.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="ca-section">
    <div class="ca-shell ca-split">
      <div>
        <span class="ca-label">{t.turnLabel}</span>
        <h2 set:html={t.turnH2} />
        <ol class="ca-steps">
          <li>
            <span class="ca-n">1</span>
            <div>
              <b>{t.step1Title}</b>
              <p>{t.step1Body}</p>
            </div>
          </li>
          <li>
            <span class="ca-n">2</span>
            <div>
              <b>{t.step2Title}</b>
              <p>{t.step2Body}</p>
            </div>
          </li>
          <li>
            <span class="ca-n">3</span>
            <div>
              <b>{t.step3Title}</b>
              <p>{t.step3Body}</p>
            </div>
          </li>
        </ol>
      </div>
      <div class="ca-set">
        <img src="/assets/canes-set.webp" alt={t.setAlt} />
        <p>{t.setP}</p>
        <div class="ca-tokens">
          <span><img src="/assets/canes-abanico.webp" alt="" /> {t.token3}</span>
          <span>{t.token4}</span>
          <span>{t.token5}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="ca-section alt">
    <div class="ca-shell">
      <span class="ca-label">{t.actLabel}</span>
      <h2 set:html={t.actH2} />
      <p>{t.actP}</p>
      <div class="ca-disc">
        {disciplinas.map((d) => (
          <article style={`--disc:${d.color}`}>
            <span class="ca-disc-icon">
              <img src={`/assets/canes-ficha-${d.key}.webp`} alt="" />
            </span>
            <div>
              <h3>{d.name}</h3>
              <p><strong>{t.ficha1}</strong> {d.simple}</p>
              <p><strong>{t.ficha2}</strong> {d.avanzada}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ca-section">
    <div class="ca-shell ca-split">
      <div>
        <span class="ca-label">{t.closeLabel}</span>
        <h2 set:html={t.closeH2} />
        <p>{t.closeP1}</p>
        <p>{t.closeP2}</p>
        <p>{t.closeP3}</p>
      </div>
      <div>
        <div class="ca-score">
          <article>
            <span>01</span>
            <b>{t.score1K}</b>
            <p>{t.score1P}</p>
          </article>
          <article>
            <span>02</span>
            <b>{t.score2K}</b>
            <p>{t.score2P}</p>
          </article>
          <article>
            <span>03</span>
            <b>{t.score3K}</b>
            <p>{t.score3P}</p>
          </article>
        </div>
        <table class="ca-rounds" style="margin-top:1.2rem;">
          <thead>
            <tr><th>{t.thPlayers}</th><th>{t.thRounds}</th></tr>
          </thead>
          <tbody>
            <tr><td>2</td><td>5</td></tr>
            <tr><td>3</td><td>4</td></tr>
            <tr><td>{t.row45}</td><td>3</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="ca-section alt">
    <div class="ca-shell">
      <span class="ca-label">{t.galLabel}</span>
      <h2 set:html={t.galH2} />
      <div class="ca-gallery-grid">
        <figure>
          <img src="/assets/canes-mesa.webp" alt={t.galMesaAlt} />
          <figcaption>{t.galMesaCap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/canes-mesa-accion.webp" alt={t.galAccionAlt} />
          <figcaption>{t.galAccionCap}</figcaption>
        </figure>
        <figure>
          <img src="/assets/canes-cartas-closeup.webp" alt={t.galCloseAlt} />
          <figcaption>{t.galCloseCap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <nav class="ca-back ca-shell" aria-label={t.backAria}>
    <span>{t.backPrompt}</span>
    <a href={localizePath('/#juegos', locale)}>{t.backLink}</a>
  </nav>
</main>

</BaseLayout>
