---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGames, localizeGame } from '../../lib/games';
import { getLocale, localizePath } from '../../i18n/locale';
import { portafolio as pf } from '../../i18n/portafolio';
import { CAJA_FONTS_URL } from '../../lib/caja-fonts';

const locale = getLocale(Astro);
const t = pf[locale];
const games = (await getGames()).map((g) => localizeGame(g, locale));

const stateBadge: Record<string, { bg: string; color: string }> = {
  publicado:  { bg: '#7c3aed', color: '#fff' },
  produccion: { bg: '#2563eb', color: '#fff' },
  disponible: { bg: '#16a34a', color: '#fff' },
  pruebas:    { bg: '#eab308', color: '#1a1205' },
  boceto:     { bg: '#f97316', color: '#fff' },
  idea:       { bg: '#dc2626', color: '#fff' },
};

/**
 * Brillo medio medido con ImageMagick (magick img -colorspace Gray -format "%[fx:mean]" info:)
 * < 0.40 → oscuro; 0.40–0.65 → medio; ≥ 0.65 → claro
 */
const overlayStrength: Record<string, 'light' | 'medium' | 'dark'> = {
  ermitanos:  'light',   // 0.715
  gato:       'light',   // 0.701
  nudis:      'light',   // 0.683
  canes:      'light',   // 0.793
  evoluciona: 'light',   // 0.756
  pavoneo:    'light',   // 0.740
  palomas:    'medium',  // 0.526
  carcinogenial: 'medium', // 0.508
  amateurasu: 'medium',  // 0.574
  chispas:    'medium',  // 0.488
  ninive:     'medium',  // 0.456
  piramisu:   'medium',  // 0.413
  chauvet:    'dark',    // 0.375
  letrados:   'dark',    // 0.389
  reloj:      'dark',    // 0.366
  tartan:     'dark',    // 0.305
  mantas:     'dark',    // 0.281
  hubris:     'dark',    // 0.281
  almagesto:  'dark',    // 0.146
};
---

<BaseLayout
  title={t.title}
  description={t.description}
  current="portafolio"
  fontUrl={CAJA_FONTS_URL}
>

<style>
  .pf-crumb {
    display: flex;
    gap: .6rem;
    margin-bottom: 1.15rem;
    color: var(--ink-soft);
    font-size: .75rem;
    font-weight: 850;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .pf-crumb a { text-decoration: none; }
  .pf-crumb a:hover { color: var(--red); }

  .pf-hero-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
  }
  .pf-hero .page-title { max-width: 12ch; }
  .pf-count {
    font-size: .72rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .pf-count strong {
    display: block;
    font: 950 clamp(2.4rem, 5vw, 3.6rem)/.85 Arial, Helvetica, sans-serif;
    letter-spacing: -.07em;
    color: var(--ink);
  }

  .pf-controls {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
    padding: 0 0 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .pf-controls-label {
    margin-right: .25rem;
    color: var(--ink-soft);
    font-size: .72rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .pf-sort-btn {
    padding: .35rem .75rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .04em;
  }
  .pf-sort-btn:hover { color: var(--red); border-color: var(--red); }
  .pf-sort-btn.active { background: var(--ink); color: var(--white); }

  /* ── grid ──────────────────────────────────────────────────────────── */
  .pf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* ── card ──────────────────────────────────────────────────────────── */
  .pf-card {
    position: relative;
    min-height: 300px;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #fff;
    transition: transform .22s, box-shadow .22s;
  }
  .pf-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, .28);
  }
  .pf-card:hover .pf-card-img { transform: scale(1.04); }

  /* imagen de concepto */
  .pf-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .35s ease;
    z-index: 0;
  }

  /* overlay calibrado por brillo: clases aplicadas desde el frontmatter */
  .pf-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* imágenes claras (canes, evoluciona, pavoneo) */
  .pf-card[data-ov="light"]::after {
    background: linear-gradient(165deg,
      rgba(0, 0, 0, .45) 0%,
      rgba(0, 0, 0, .80) 100%
    );
  }
  /* imágenes medias (amateurasu, chispas, ninive, piramisu) */
  .pf-card[data-ov="medium"]::after {
    background: linear-gradient(165deg,
      rgba(0, 0, 0, .28) 0%,
      rgba(0, 0, 0, .65) 100%
    );
  }
  /* imágenes oscuras (hubris, mantas, tartan, reloj, letrados) */
  .pf-card[data-ov="dark"]::after {
    background: linear-gradient(165deg,
      rgba(0, 0, 0, .12) 0%,
      rgba(0, 0, 0, .50) 100%
    );
  }

  /* contenido (encima de imagen + overlay) */
  .pf-card-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding: 1.4rem 1.4rem 1.15rem;
  }

  .pf-card-top { display: flex; justify-content: flex-end; }
  .pf-card-emoji {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, .45);
    background: rgba(255, 255, 255, .15);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    line-height: 1;
  }

  .pf-card-body {
    display: flex;
    flex-direction: column;
    gap: .45rem;
  }

  .pf-card-title {
    display: block;
    font-size: clamp(1.45rem, 2.8vw, 2rem);
    font-weight: 700;
    letter-spacing: -.03em;
    line-height: 1.08;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, .4);
  }
  .pf-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    margin-top: .85rem;
  }
  .pf-swatches { display: flex; gap: 4px; }
  .pf-swatch {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    outline: 1px solid rgba(255, 255, 255, .28);
  }
  .pf-state-badge {
    padding: .28rem .6rem;
    font-size: .58rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    border-radius: 2px;
  }

  .pf-empty {
    display: none;
    grid-column: 1 / -1;
    padding: 4rem 0;
    text-align: center;
    color: var(--ink-soft);
  }
  .pf-empty.visible { display: block; }

  @media (max-width: 980px) {
    .pf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .pf-hero-row { grid-template-columns: 1fr; }
    .pf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .pf-grid { grid-template-columns: 1fr; }
    .pf-card { min-height: 260px; }
  }
</style>

<main>
  <header class="page-hero pf-hero">
    <div class="shell pf-hero-row">
      <div>
        <nav class="pf-crumb" aria-label={t.crumbAria}>
          <a href={localizePath('/', locale)}>{t.crumbHome}</a>
          <span>/</span>
          <span>{t.crumbHere}</span>
        </nav>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="page-title">{t.h1}</h1>
        <p class="lede">{t.sub}</p>
      </div>
      <div class="pf-count" aria-live="polite">
        <strong id="pf-visible-count">{games.length}</strong>
        {t.countNoun}
      </div>
    </div>
  </header>

  <div class="shell">
    <div class="pf-controls" role="group" aria-label={t.sortAria}>
      <span class="pf-controls-label">{t.sortLabel}</span>
      <button class="pf-sort-btn active" data-sort="estado" aria-pressed="true">{t.sortState}</button>
      <button class="pf-sort-btn" data-sort="nombre" aria-pressed="false">{t.sortName}</button>
      <button class="pf-sort-btn" data-sort="reciente" aria-pressed="false">{t.sortRecent}</button>
    </div>

    <div class="pf-grid" id="pf-grid" role="list">
      {games.map((g) => {
        const badge = stateBadge[g.state] ?? stateBadge.proto;
        const ov    = overlayStrength[g.keyword] ?? 'medium';
        return (
          <a
            class="pf-card"
            href={g.href}
            role="listitem"
            data-ov={ov}
            data-name={g.name.toLowerCase()}
            data-state-order={g.stateOrder}
            data-date={g.date}
          >
            <img
              class="pf-card-img"
              src={`/assets/concepto-${g.keyword}.webp`}
              alt=""
              aria-hidden="true"
              loading="lazy"
            />
            <div class="pf-card-inner">
              <div class="pf-card-top">
                <span class="pf-card-emoji" aria-hidden="true">{g.emoji}</span>
              </div>
              <div class="pf-card-body">
                <span class="pf-card-title" style={`font-family: ${g.titleFont};`}>
                  {g.name}
                </span>
                <div class="pf-card-foot">
                  <div class="pf-swatches" aria-hidden="true">
                    {g.palette.map((c) => <span class="pf-swatch" style={`background: ${c};`} />)}
                  </div>
                  <span class="pf-state-badge" style={`background: ${badge.bg}; color: ${badge.color};`}>
                    {g.stateLabel}
                  </span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
      <div class="pf-empty" id="pf-empty">{t.empty}</div>
    </div>
  </div>
</main>

<script>
  const grid     = document.getElementById('pf-grid')!;
  const countEl  = document.getElementById('pf-visible-count')!;
  const sortBtns = document.querySelectorAll<HTMLButtonElement>('.pf-sort-btn');

  function getCards() {
    return Array.from(grid.querySelectorAll<HTMLElement>('.pf-card'));
  }

  function sortCards(by: string) {
    const cards = getCards();
    cards.sort((a, b) => {
      if (by === 'nombre') {
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', document.documentElement.lang || 'es');
      }
      if (by === 'reciente') {
        return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
      }
      const so = Number(a.dataset.stateOrder) - Number(b.dataset.stateOrder);
      if (so !== 0) return so;
      return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
    });
    cards.forEach(c => grid.appendChild(c));
    countEl.textContent = String(cards.length);
  }

  sortBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sortBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      sortCards(btn.dataset.sort ?? 'estado');
    });
  });

  sortCards('estado');
</script>

</BaseLayout>
