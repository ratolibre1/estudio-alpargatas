---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGames, localizeGame } from '../../lib/games';
import { getLocale, localizePath } from '../../i18n/locale';
import { portafolio as pf } from '../../i18n/portafolio';
import { CAJA_FONTS_URL } from '../../lib/caja-fonts';

const locale = getLocale(Astro);
const t = pf[locale];
const games = (await getGames()).map((g) => localizeGame(g, locale));

const stateBadge: Record<string, { bg: string; color: string }> = {
  publicado: { bg: '#22c55e', color: '#fff' },
  avanzado:  { bg: '#3b82f6', color: '#fff' },
  playtest:  { bg: '#f97316', color: '#fff' },
  rediseno:  { bg: '#d946ef', color: '#fff' },
  proto:     { bg: 'rgba(0,0,0,.18)', color: 'rgba(255,255,255,.75)' },
};

function cardTone(bg: string): 'light' | 'dark' {
  const raw = bg.trim().replace(/^#/, '');
  const hex = raw.length === 3 ? [...raw].map((c) => c + c).join('') : raw;
  if (!/^[0-9a-f]{6}$/i.test(hex)) return 'light';
  const r = parseInt(hex.slice(0, 2), 16);
  const g = parseInt(hex.slice(2, 4), 16);
  const b = parseInt(hex.slice(4, 6), 16);
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? 'light' : 'dark';
}
---

<BaseLayout
  title={t.title}
  description={t.description}
  current="portafolio"
  footerSubtitle={t.footer}
  fontUrl={CAJA_FONTS_URL}
>

<style>
  .pf-crumb {
    display: flex;
    gap: .6rem;
    margin-bottom: 1.15rem;
    color: var(--ink-soft);
    font-size: .75rem;
    font-weight: 850;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .pf-crumb a { text-decoration: none; }
  .pf-crumb a:hover { color: var(--red); }

  .pf-hero-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
  }
  .pf-hero .page-title { max-width: 12ch; }
  .pf-count {
    font-size: .72rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .pf-count strong {
    display: block;
    font: 950 clamp(2.4rem, 5vw, 3.6rem)/.85 Arial, Helvetica, sans-serif;
    letter-spacing: -.07em;
    color: var(--ink);
  }

  .pf-controls {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
    padding: 0 0 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .pf-controls-label {
    margin-right: .25rem;
    color: var(--ink-soft);
    font-size: .72rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .pf-sort-btn {
    padding: .35rem .75rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .04em;
  }
  .pf-sort-btn:hover { color: var(--red); border-color: var(--red); }
  .pf-sort-btn.active { background: var(--ink); color: var(--white); }

  .pf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }
  .pf-card {
    position: relative;
    min-height: 268px;
    padding: 1.6rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
    color: inherit;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
  }
  .pf-card:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06), 0 12px 32px rgba(24,49,79,.18);
  }
  .pf-card-body { flex: 1; padding-right: 3.6rem; }
  .pf-card-emoji {
    position: absolute;
    top: .9rem;
    right: .9rem;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 1.5px solid rgba(24, 49, 79, .42);
    background: rgba(255,255,255,.3);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    line-height: 1;
    z-index: 0;
  }
  .pf-card[data-tone="dark"] .pf-card-emoji {
    border-color: rgba(255, 255, 255, .55);
  }
  .pf-card-title {
    display: block;
    margin: 0 0 .6rem;
    font-size: clamp(1.55rem, 3.1vw, 2.2rem);
    font-weight: 700;
    font-synthesis: none;
    letter-spacing: -.03em;
    line-height: 1.08;
  }
  .pf-card-tagline {
    display: block;
    font-size: clamp(1.18rem, 1.7vw, 1.38rem);
    font-style: italic;
    font-synthesis: none;
    line-height: 1.42;
    opacity: .9;
  }
  .pf-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    margin-top: 1.1rem;
  }
  .pf-swatches { display: flex; gap: 5px; }
  .pf-swatch {
    width: 16px;
    height: 16px;
    border-radius: 1px;
    outline: 1px solid rgba(255,255,255,.15);
  }
  .pf-state-badge {
    padding: .28rem .6rem;
    font-size: .58rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .pf-empty {
    display: none;
    grid-column: 1 / -1;
    padding: 4rem 0;
    text-align: center;
    color: var(--ink-soft);
  }
  .pf-empty.visible { display: block; }

  @media (max-width: 980px) {
    .pf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .pf-hero-row { grid-template-columns: 1fr; }
    .pf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .pf-grid { grid-template-columns: 1fr; }
  }
</style>

<main>
  <header class="page-hero pf-hero">
    <div class="shell pf-hero-row">
      <div>
        <nav class="pf-crumb" aria-label={t.crumbAria}>
          <a href={localizePath('/', locale)}>{t.crumbHome}</a>
          <span>/</span>
          <span>{t.crumbHere}</span>
        </nav>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="page-title">{t.h1}</h1>
        <p class="lede">{t.sub}</p>
      </div>
      <div class="pf-count" aria-live="polite">
        <strong id="pf-visible-count">{games.length}</strong>
        {t.countNoun}
      </div>
    </div>
  </header>

  <div class="shell">
    <div class="pf-controls" role="group" aria-label={t.sortAria}>
      <span class="pf-controls-label">{t.sortLabel}</span>
      <button class="pf-sort-btn active" data-sort="estado" aria-pressed="true">{t.sortState}</button>
      <button class="pf-sort-btn" data-sort="nombre" aria-pressed="false">{t.sortName}</button>
      <button class="pf-sort-btn" data-sort="reciente" aria-pressed="false">{t.sortRecent}</button>
    </div>

    <div class="pf-grid" id="pf-grid" role="list">
      {games.map((g) => {
        const badge = stateBadge[g.state] ?? stateBadge.proto;
        return (
          <a
            class="pf-card"
            href={g.href}
            role="listitem"
            style={`background: ${g.bg};`}
            data-tone={cardTone(g.bg)}
            data-name={g.name.toLowerCase()}
            data-state-order={g.stateOrder}
            data-date={g.date}
          >
            <span class="pf-card-emoji" aria-hidden="true">{g.emoji}</span>
            <div class="pf-card-body">
              <span class="pf-card-title" style={`color: ${g.titleColor}; font-family: ${g.titleFont};`}>
                {g.name}
              </span>
              <span class="pf-card-tagline" style={`color: ${g.taglineColor}; font-family: ${g.taglineFont};`}>
                {g.tagline}
              </span>
            </div>
            <div class="pf-card-foot">
              <div class="pf-swatches" aria-hidden="true">
                {g.palette.map((c) => <span class="pf-swatch" style={`background: ${c};`} />)}
              </div>
              <span class="pf-state-badge" style={`background: ${badge.bg}; color: ${badge.color};`}>
                {g.stateLabel}
              </span>
            </div>
          </a>
        );
      })}
      <div class="pf-empty" id="pf-empty">{t.empty}</div>
    </div>
  </div>
</main>

<script>
  const grid      = document.getElementById('pf-grid')!;
  const countEl   = document.getElementById('pf-visible-count')!;
  const sortBtns  = document.querySelectorAll<HTMLButtonElement>('.pf-sort-btn');

  function getCards() {
    return Array.from(grid.querySelectorAll<HTMLElement>('.pf-card'));
  }

  function sortCards(by: string) {
    const cards = getCards();
    cards.sort((a, b) => {
      if (by === 'nombre') {
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', document.documentElement.lang || 'es');
      }
      if (by === 'reciente') {
        return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
      }
      const so = Number(a.dataset.stateOrder) - Number(b.dataset.stateOrder);
      if (so !== 0) return so;
      return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
    });
    cards.forEach(c => grid.appendChild(c));
    countEl.textContent = String(cards.length);
  }

  sortBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sortBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      sortCards(btn.dataset.sort ?? 'estado');
    });
  });

  sortCards('estado');
</script>

</BaseLayout>
