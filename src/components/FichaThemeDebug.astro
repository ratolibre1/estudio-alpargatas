---
import type { FichaMode } from '../lib/ficha-colors';

interface Props {
  keyword: string;
  mode: FichaMode;
  defaults: { keyword: string; mode: FichaMode }[];
}
const { keyword, mode, defaults } = Astro.props;
const enabled = import.meta.env.DEV || process.env.CONTEXT === 'deploy-preview';
const english = Astro.url.pathname.startsWith('/en/');
---

<aside
  class="ficha-theme-debug"
  data-ficha-debug
  data-keyword={keyword}
  data-default-mode={mode}
  data-mode-defaults={JSON.stringify(defaults)}
  data-preview={enabled ? 'true' : undefined}
  data-language={english ? 'en' : 'es'}
  hidden
  aria-label={english ? 'Palette debug' : 'Debug de paleta'}
>
  <span data-debug-mode aria-live="polite"></span>
  <button type="button" data-debug-toggle></button>
  <button type="button" data-debug-reset>{english ? 'Restore default' : 'Restablecer'}</button>
  <button type="button" data-debug-copy>{english ? 'Copy decisions' : 'Copiar decisiones'}</button>
  <span class="ficha-debug-status" data-debug-status role="status"></span>
  <textarea data-debug-export readonly hidden aria-label={english ? 'Mode decisions' : 'Decisiones de modo'}></textarea>
</aside>

<script>
  import { initFichaThemeDebug } from '../lib/ficha-theme-debug';
  initFichaThemeDebug();
</script>

<style>
  .ficha-theme-debug[hidden], .ficha-theme-debug textarea[hidden] { display: none; }
  .ficha-theme-debug {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem;
    width: min(1320px, calc(100% - 2.5rem));
    margin: 1rem auto;
    padding: .75rem;
    border: 1px solid var(--ficha-line);
    border-radius: .4rem;
    background: var(--ficha-card);
    color: var(--ficha-card-text);
    font: .8rem var(--ficha-section-font);
  }
  .ficha-theme-debug button {
    min-height: 44px;
    padding: .5rem .7rem;
    border: 1px solid currentColor;
    border-radius: .3rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .ficha-theme-debug button:hover { text-decoration: underline; }
  .ficha-debug-status { color: var(--ficha-card-muted); }
  .ficha-theme-debug textarea {
    flex-basis: 100%;
    width: 100%;
    min-height: 12rem;
    background: var(--ficha-card);
    color: var(--ficha-card-text);
    border: 1px solid currentColor;
  }
</style>
