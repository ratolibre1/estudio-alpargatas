---
import { chrome } from '../i18n/chrome';
import { getLocale, localizePath } from '../i18n/locale';

interface Props {
  subtitle: string;
  variant?: 'default' | 'mapa' | 'ninive';
}

const { subtitle, variant = 'default' } = Astro.props;
const locale = getLocale(Astro);
const t = chrome[locale];
---

<footer class="site-footer">
  <div class="shell footer-row">
    <div><b>Estudio Alpargatas</b><span>{subtitle}</span></div>
    <div class="footer-links">
      {variant === 'mapa' ? (
        <a href={localizePath('/juegos/ninive/', locale)}>{t.footerNinive}</a>
      ) : variant === 'ninive' ? (
        <><a href={localizePath('/', locale)}>{t.footerHome}</a><a href="https://www.instagram.com/estudioalpargatas/">{t.footerIg}</a></>
      ) : (
        <><a href={localizePath('/sobre-mi/', locale)}>{t.navEstudio}</a><a href={localizePath('/mapa/', locale)}>{t.footerMap}</a><a href="https://www.instagram.com/estudioalpargatas/">{t.footerIg}</a></>
      )}
    </div>
  </div>
</footer>
