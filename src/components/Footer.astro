---
interface Props {
  subtitle: string;
  variant?: 'default' | 'mapa' | 'ninive';
}

const { subtitle, variant = 'default' } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-row">
    <div><b>Estudio Alpargatas</b><span>{subtitle}</span></div>
    <div class="footer-links">
      {variant === 'mapa' ? (
        <a href="/juegos/ninive/">Ver la ficha de Nínive →</a>
      ) : variant === 'ninive' ? (
        <><a href="/">Inicio</a><a href="https://www.instagram.com/estudioalpargatas/">@estudioalpargatas ↗</a></>
      ) : (
        <><a href="/mapa/">Mapa del sitio</a><a href="https://www.instagram.com/estudioalpargatas/">@estudioalpargatas ↗</a></>
      )}
    </div>
  </div>
</footer>
