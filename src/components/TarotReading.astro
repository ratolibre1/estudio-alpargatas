---
import type { Lang } from '../i18n/locale';
import { tarot } from '../i18n/tarot';
import { getGames, localizeGame } from '../lib/games';
import { tarotImage } from '../lib/tarot';
import '../styles/tarot.css';

interface Props { locale: Lang }
const { locale } = Astro.props;
const t = tarot[locale];
const games = (await getGames())
  .filter((game) => game.state !== 'publicado')
  .map((game) => localizeGame(game, locale))
  .map(({ keyword, name, href, tagline }) => ({ keyword, name, href, blurb: tagline }));
---

<section id="tarot" class="tarot-section shell" data-tarot data-locale={locale} data-tarot-games={JSON.stringify(games)} aria-labelledby="tarot-title">
  <div class="tarot-invitation">
    <div class="tarot-invitation-copy">
      <p class="tarot-eyebrow">✦ {t.overline}</p>
      <h2 id="tarot-title">{t.title}</h2>
      <p class="tarot-intro">{t.intro}</p>
      <button type="button" class="tarot-primary" data-tarot-open aria-haspopup="dialog" aria-controls="tarot-dialog" disabled>{t.open}</button>
      <noscript><p>{t.noScript}</p></noscript>
    </div>
    <div class="tarot-preview" aria-hidden="true">
      <span class="tarot-orbit"></span>
      {[2, 0, 21].map((id, index) => <img src={tarotImage(id)} alt="" loading="lazy" width="600" height="900" style={`--preview-index:${index}`} />)}
      <span class="tarot-preview-star">✦</span>
    </div>
  </div>

  <dialog id="tarot-dialog" class="tarot-dialog" aria-labelledby="tarot-dialog-title" aria-describedby="tarot-instructions">
    <div class="tarot-dialog-body">
      <header class="tarot-dialog-header">
        <p class="tarot-eyebrow">✦ {t.overline}</p>
        <button type="button" class="tarot-close" data-tarot-close aria-label={t.close} autofocus>×</button>
        <h2 id="tarot-dialog-title">{t.dialogTitle}</h2>
        <p class="tarot-sr-only" data-tarot-announcer role="status" aria-live="polite" aria-atomic="true"></p>
      </header>

      <div class="tarot-dialog-scroll-mask" data-tarot-scroll-mask>
        <div class="tarot-dialog-scroll" data-tarot-scroll-region tabindex="-1">
        <div class="tarot-deck-area" data-tarot-deck-area>
          <p id="tarot-instructions" class="tarot-deck-label">{t.instructions}</p>
          <div class="tarot-fan-stage" data-tarot-fan-stage>
            <div class="tarot-fan-mask" data-tarot-fan-mask>
              <div class="tarot-fan-viewport" data-tarot-scroll>
                <div class="tarot-fan" data-tarot-fan role="group" aria-label={t.instructions}></div>
              </div>
            </div>
            <div class="tarot-fan-swipe-cue" data-tarot-swipe-cue aria-hidden="true">
              <svg class="tarot-fan-swipe-arrow" viewBox="0 0 280 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <marker id="tarot-fan-arrowhead" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
                    <path d="M0 0 L7 3.5 L0 7 Z" fill="#e6bc66" />
                  </marker>
                </defs>
                <circle cx="22" cy="34" r="3.5" fill="#e6bc66" opacity=".9" />
                <path
                  d="M 26 34 Q 140 6 254 34"
                  stroke="#e6bc66"
                  stroke-width="1.75"
                  stroke-dasharray="5 4"
                  stroke-linecap="round"
                  marker-end="url(#tarot-fan-arrowhead)"
                  opacity=".88"
                />
              </svg>
            </div>
            <p class="tarot-scroll-hint" data-tarot-scroll-hint>{t.scroll}</p>
          </div>
        </div>

        <div class="tarot-spread" data-tarot-spread role="group" aria-label={t.reading}>
          {t.phases.map((phase) => <figure class="tarot-slot" data-tarot-slot>
            <figcaption class="tarot-phase">{phase}</figcaption>
            <div class="tarot-card-place" data-tarot-place><span class="tarot-empty-star" aria-hidden="true">✦</span></div>
            <div class="tarot-card-reading" data-tarot-reading aria-hidden="true"><h3></h3><p></p></div>
          </figure>)}
        </div>

        <div class="tarot-result" data-tarot-result hidden>
          <p class="tarot-eyebrow">✦ {t.recommendation}</p>
          <p class="tarot-result-intro">{t.match}</p>
          <h3 data-tarot-game-name></h3>
          <p class="tarot-game-blurb" data-tarot-game-blurb></p>
          <div class="tarot-result-actions">
            <a class="tarot-primary" data-tarot-game-link>{t.discover} <span aria-hidden="true">→</span></a>
            <button type="button" class="tarot-again" data-tarot-again>{t.again} ↻</button>
          </div>
        </div>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { initTarot } from '../lib/tarot-client';
  document.querySelectorAll<HTMLElement>('[data-tarot]').forEach(initTarot);
</script>
