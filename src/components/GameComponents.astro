---
import type { FichaComponent } from '../lib/ficha';
import { resolveComponentIcon } from '../lib/comp-icons';

interface Props {
  defaultPhoto?: string;
  components: FichaComponent[];
}

const { defaultPhoto, components } = Astro.props;
const hasStage = Boolean(defaultPhoto || components.some((c) => c.image));
const show = components.length > 0;
---

{show && (
  <div
    class:list={['ficha-comp-interactive', !hasStage && 'ficha-comp-interactive--tiles-only']}
    data-ficha-components={hasStage ? true : undefined}
    data-default-src={defaultPhoto ?? ''}
  >
    {hasStage && (
      <div class="ficha-comp-stage-wrap">
        <div class="ficha-comp-photo ficha-comp-stage">
          {defaultPhoto ? (
            <img
              data-comp-main
              src={defaultPhoto}
              alt=""
              loading="lazy"
            />
          ) : (
            <img data-comp-main src="" alt="" hidden />
          )}
        </div>
      </div>
    )}

    <div class="ficha-comp-side">
      <div class="ficha-comp-tiles" role="list">
        {components.map((item, index) => {
          const hasDetail = Boolean(item.image);
          const iconSrc = resolveComponentIcon(item.name, item.icon);
          return (
            <button
              type="button"
              class:list={['ficha-comp-tile', !hasDetail && 'is-static']}
              role="listitem"
              data-comp-index={index}
              data-comp-src={item.image ?? ''}
              aria-pressed="false"
            >
              <img class="ficha-comp-tile-icon" src={iconSrc} alt="" />
              <span class="ficha-comp-tile-body">
                <span class="ficha-comp-tile-qty">{item.qty}</span>
                <span class="ficha-comp-tile-name">{item.name}</span>
              </span>
            </button>
          );
        })}
      </div>
    </div>

  </div>
)}

{hasStage && (
<script>
  function bindComponents(root: HTMLElement) {
    const main = root.querySelector<HTMLImageElement>('[data-comp-main]');
    const tiles = [
      ...root.querySelectorAll<HTMLButtonElement>('.ficha-comp-tile'),
    ].filter((tile) => Boolean(tile.dataset.compSrc));
    const defaultSrc = root.dataset.defaultSrc ?? '';

    if (!main) return;

    let pinned: HTMLButtonElement | null = null;

    const setPhoto = (src: string) => {
      if (!src) {
        main.hidden = true;
        main.removeAttribute('src');
        return;
      }
      main.hidden = false;
      main.src = src;
    };

    const setActive = (active: HTMLButtonElement | null) => {
      tiles.forEach((tile) => {
        const on = tile === active;
        tile.classList.toggle('is-active', on);
        tile.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    };

    const showDefault = () => {
      pinned = null;
      setActive(null);
      setPhoto(defaultSrc);
    };

    const showTile = (tile: HTMLButtonElement) => {
      const src = tile.dataset.compSrc ?? '';
      if (!src) {
        showDefault();
        return;
      }
      setPhoto(src);
      setActive(tile);
    };

    showDefault();

    tiles.forEach((tile) => {
      const src = tile.dataset.compSrc;
      if (!src) return;

      tile.addEventListener('mouseenter', () => {
        if (pinned) return;
        showTile(tile);
      });

      tile.addEventListener('mouseleave', () => {
        if (pinned) return;
        showDefault();
      });

      tile.addEventListener('click', () => {
        if (pinned === tile) {
          showDefault();
          return;
        }
        pinned = tile;
        showTile(tile);
      });
    });

    root.addEventListener('mouseleave', () => {
      if (!pinned) showDefault();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-ficha-components]').forEach(bindComponents);
</script>
)}
