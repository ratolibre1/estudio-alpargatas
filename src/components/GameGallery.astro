---
import { ficha as copy } from '../i18n/fichas/ficha';
import type { Lang } from '../i18n/locale';
import type { FichaPhoto } from '../lib/ficha';
import { FICHA_LOREM, loremFlag, showFichaLorem } from '../lib/ficha-lorem';

interface Props {
  photos: FichaPhoto[];
  locale: Lang;
  id: string;
}

const { photos, locale, id } = Astro.props;
const t = copy[locale];
const slides = photos.map((photo, index) => {
  const flag = loremFlag(locale, id, 'gallery', index);
  return { ...photo, flag, lorem: showFichaLorem(flag, photo.caption) };
});
const first = slides[0];
---

{photos.length > 0 && first && (
  <div class="ficha-gallery" data-gallery={id}>
    <figure class="ficha-gallery-main">
      <img data-main src={first.src} alt={first.alt} />
      {photos.length > 1 && (
        <>
          <button class="ficha-gallery-btn prev" type="button" data-prev aria-label={t.prev}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="ficha-gallery-btn next" type="button" data-next aria-label={t.next}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </>
      )}
    </figure>
    <div class="ficha-gallery-cap">
      <span class="ficha-gallery-cap-text">
        <span data-lorem data-lorem-flag={first.flag} hidden={!first.lorem}>{FICHA_LOREM}</span>
        <span data-cap class:list={[first.lorem && first.caption && 'ficha-prior']}>{first.caption ?? ''}</span>
      </span>
      <span data-count>1 / {photos.length}</span>
    </div>
    {photos.length > 1 && (
      <div class="ficha-thumbs">
        {photos.map((photo, index) => (
          <button type="button" data-thumb={index} class={index === 0 ? 'is-on' : undefined}>
            <img src={photo.src} alt="" />
          </button>
        ))}
      </div>
    )}
    <script type="application/json" data-photos set:html={JSON.stringify(slides)} />
  </div>
)}

<script>
  function bindGallery(root: HTMLElement) {
    const raw = root.querySelector('[data-photos]')?.textContent;
    if (!raw) return;
    const photos = JSON.parse(raw) as { src: string; alt: string; caption?: string; lorem?: boolean; flag?: string }[];
    if (photos.length < 2) return;
    let index = 0;
    const img = root.querySelector<HTMLImageElement>('[data-main]');
    const lorem = root.querySelector<HTMLElement>('[data-lorem]');
    const cap = root.querySelector('[data-cap]');
    const count = root.querySelector('[data-count]');
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];

    const paint = () => {
      const photo = photos[index];
      if (!photo || !img) return;
      img.src = photo.src;
      img.alt = photo.alt;
      const showLorem = photo.lorem !== false;
      if (lorem) {
        lorem.hidden = !showLorem;
        if (photo.flag) lorem.dataset.loremFlag = photo.flag;
      }
      if (cap) {
        cap.textContent = photo.caption ?? '';
        cap.classList.toggle('ficha-prior', showLorem && Boolean(photo.caption));
      }
      if (count) count.textContent = `${index + 1} / ${photos.length}`;
      thumbs.forEach((thumb, i) => thumb.classList.toggle('is-on', i === index));
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      index = (index - 1 + photos.length) % photos.length;
      paint();
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      index = (index + 1) % photos.length;
      paint();
    });
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        index = Number(thumb.dataset.thumb);
        paint();
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(bindGallery);
</script>
