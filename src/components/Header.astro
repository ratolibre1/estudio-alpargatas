---
import { chrome } from '../i18n/chrome';
import { getLocale, localizePath, switchLocalePath } from '../i18n/locale';

interface Props {
  current?: 'home' | 'portafolio' | 'estudio';
}

const { current = 'home' } = Astro.props;
const locale = getLocale(Astro);
const t = chrome[locale];
const here = Astro.url.pathname;
const nextLocale = locale === 'es' ? 'en' : 'es';
const tarotHref = `${localizePath('/', locale)}#tarot`;
const portfolioHref = localizePath('/portafolio/', locale);
const estudioHref = localizePath('/estudio/', locale);
const langHref = switchLocalePath(here, nextLocale);
const langLabel = nextLocale === 'en' ? t.langEn : t.langEs;
const langAria = nextLocale === 'en' ? t.langToEn : t.langToEs;
---

<header
  class="site-header"
  data-nav-menu
  data-nav-open-label={t.navMenuOpen}
  data-nav-close-label={t.navMenuClose}
>
  <nav class="nav shell" aria-label={locale === 'en' ? 'Main navigation' : 'Navegación principal'}>
    <a class="brand" href={localizePath('/', locale)} aria-label="Estudio Alpargatas">
      <img class="brand-logo" src="/assets/estudio-alpargatas-logo.webp?v=2" alt="" />
      <span><b>Estudio Alpargatas</b><small>{t.brandSmall}</small></span>
    </a>

    <div class="nav-end">
      <div class="nav-primary">
        <a class="nav-page" href={tarotHref}>{t.navTarot}</a>
        <a class="nav-page" href={portfolioHref} aria-current={current === 'portafolio' ? 'page' : undefined}>
          {t.navPortfolio}
        </a>
        <a class="nav-page" href={estudioHref} aria-current={current === 'estudio' ? 'page' : undefined}>
          {t.navEstudio}
        </a>
      </div>

      <div class="nav-utilities">
        <a class="nav-instagram" href="https://www.instagram.com/estudioalpargatas/" aria-label={t.navInstagram}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a class="nav-lang" href={langHref} aria-label={langAria}>
          {
            nextLocale === 'en' ? (
              <svg class="nav-flag" viewBox="0 0 16 12" width="16" height="12" aria-hidden="true">
                <rect width="16" height="12" fill="#bf0a30"></rect>
                <rect y="1.33" width="16" height="1.34" fill="#fff"></rect>
                <rect y="4" width="16" height="1.34" fill="#fff"></rect>
                <rect y="6.67" width="16" height="1.33" fill="#fff"></rect>
                <rect y="9.33" width="16" height="1.34" fill="#fff"></rect>
                <rect width="7.2" height="6.5" fill="#002868"></rect>
              </svg>
            ) : (
              <svg class="nav-flag" viewBox="0 0 16 12" width="16" height="12" aria-hidden="true">
                <rect width="16" height="12" fill="#d52b1e"></rect>
                <rect width="16" height="6" fill="#fff"></rect>
                <rect width="6" height="6" fill="#0039a6"></rect>
                <path fill="#fff" d="M3 1.15l.62 1.9h2l-1.62 1.18.62 1.9L3 4.95l-1.62 1.18.62-1.9L.38 3.05h2z"></path>
              </svg>
            )
          }
          <span class="nav-lang-code">{langLabel}</span>
        </a>
        <button
          type="button"
          class="nav-menu-toggle"
          aria-expanded="false"
          aria-controls="nav-mobile-panel"
          aria-label={t.navMenuOpen}
        >
          <span class="nav-menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-mobile-backdrop" data-nav-backdrop hidden></div>
  <div
    id="nav-mobile-panel"
    class="nav-mobile-panel"
    role="dialog"
    aria-modal="true"
    aria-label={t.navMenuLabel}
    hidden
  >
    <div class="nav-mobile-panel-inner shell">
      <ul class="nav-mobile-list">
        <li><a class="nav-mobile-link" href={tarotHref}>{t.navTarot}</a></li>
        <li>
          <a class="nav-mobile-link" href={portfolioHref} aria-current={current === 'portafolio' ? 'page' : undefined}>
            {t.navPortfolio}
          </a>
        </li>
        <li>
          <a class="nav-mobile-link" href={estudioHref} aria-current={current === 'estudio' ? 'page' : undefined}>
            {t.navEstudio}
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  function initNavMenu(header: HTMLElement) {
    if (header.dataset.navReady) return;
    header.dataset.navReady = 'true';

    const toggle = header.querySelector<HTMLButtonElement>('.nav-menu-toggle');
    const panel = header.querySelector<HTMLElement>('#nav-mobile-panel');
    const backdrop = header.querySelector<HTMLElement>('[data-nav-backdrop]');
    if (!toggle || !panel || !backdrop) return;

    const openLabel = header.dataset.navOpenLabel ?? 'Open menu';
    const closeLabel = header.dataset.navCloseLabel ?? 'Close menu';

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-nav-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      panel.hidden = !open;
      backdrop.hidden = !open;
      document.documentElement.classList.toggle('is-nav-open', open);
      if (open) {
        panel.querySelector<HTMLAnchorElement>('.nav-mobile-link')?.focus({ preventScroll: true });
      } else {
        toggle.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-nav-open')));
    backdrop.addEventListener('click', () => setOpen(false));
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-nav-open')) setOpen(false);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-nav-menu]').forEach(initNavMenu);
</script>
