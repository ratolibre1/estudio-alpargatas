---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocale } from '../i18n/locale';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'ninive' | 'portafolio' | 'estudio';
  bodyClass?: string;
  /** CSS custom properties inyectadas en <html>. Clave sin --, valor completo. */
  theme?: Record<string, string>;
  /** URL de una hoja de estilos extra (fuentes, etc.) */
  fontUrl?: string;
  /** Color para <meta name="theme-color"> */
  themeColor?: string;
  /** Modo banda ficha (solo 4 colores de paleta en CSS). */
  fichaBand?: 'light' | 'dark';
  fichaOnPrimary?: 'base' | 'tinta';
}

const {
  title,
  description,
  current = 'home',
  bodyClass,
  theme,
  fontUrl,
  themeColor = '#f4f0df',
  fichaBand,
  fichaOnPrimary,
} = Astro.props;

const cssVars = theme
  ? Object.entries(theme).map(([k, v]) => `--${k}: ${v}`).join('; ')
  : undefined;

const locale = getLocale(Astro);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/webp" href="/assets/estudio-alpargatas-logo.webp?v=2" />
    {fontUrl && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontUrl} />
      </>
    )}
  </head>
  <body
    class={bodyClass}
    style={cssVars}
    data-band={fichaBand}
    data-on-primary={fichaOnPrimary}
  >
    <Header current={current} />
    <slot />
    <Footer />
  </body>
</html>
